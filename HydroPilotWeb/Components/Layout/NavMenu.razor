        <NavLink class="sidebar-nav__item" href="settings/notifications">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18 15.5V11a6 6 0 1 0-12 0v4.5L4 18h16Z" />
                <path d="M10 21h4" />
            </svg>
            <span class="sidebar-nav__text">Notificaciones</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="settings/parametros">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h9" />
                <path d="M17 7h3" />
                <circle cx="15" cy="7" r="2" />
                <path d="M4 17h3" />

                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9v11h5v-6h4v6h5V9" />
            </svg>
            <span class="sidebar-nav__text">Dashboard</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="lotes">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21v-9" />
                <path d="M12 12c0-4.4 3.1-7.5 8-7.5 0 4.4-3.1 7.5-8 7.5Z" />
                <path d="M12 14.5c0-3.4-2.5-6-7-6 0 3.4 2.5 6 7 6Z" />
            </svg>
            <span class="sidebar-nav__text">Lotes</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="reports">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 20h16" />
                <path d="M7 16v-5" />
                <path d="M12 16V6" />
                <path d="M17 16V9" />
            </svg>
            <span class="sidebar-nav__text">Informes</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="forecasting">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m3 17 6-6 4 4 8-8" />
                <path d="M15 7h6v6" />
            </svg>
            <span class="sidebar-nav__text">Forecasting</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="simulation">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 3h6" />
                <path d="M10 3v6.5L4.6 18.4A1.7 1.7 0 0 0 6.1 21h11.8a1.7 1.7 0 0 0 1.5-2.6L14 9.5V3" />
                <path d="M7.5 15h9" />
            </svg>
            <span class="sidebar-nav__text">Simulación</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="optimization">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11 3.5 12.8 8.2 17.5 10l-4.7 1.8L11 16.5l-1.8-4.7L4.5 10l4.7-1.8Z" />
                <path d="M18.5 14.5 19.4 17l2.6.9-2.6.9-.9 2.7-.9-2.7-2.6-.9 2.6-.9Z" />
            </svg>
            <span class="sidebar-nav__text">Optimización</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="anomalies">
            <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10.3 4.2 2.7 17.5A2 2 0 0 0 4.4 20.5h15.2a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0Z" />

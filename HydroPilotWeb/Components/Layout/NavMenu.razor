@using System.Security.Claims

<div class="brand-block">
    <a class="brand" href="/">
        <img class="brand__logo" src="assets/hydropilot-white.png" alt="HydroPilot" />
        <span class="brand__text">
            <strong>HydroPilot</strong>
            <small>Vista operativa</small>
        </span>
    </a>
</div>

@* Riel de íconos: los textos se ocultan con el menú contraído y aparecen al
   expandirlo (hover o teclado). Ver "Barra lateral" en app.css. *@
<nav class="sidebar-nav" aria-label="Navegación principal">
    <div class="sidebar-nav__section">
        <span class="sidebar-nav__label">Monitoreo</span>

        <NavLink class="sidebar-nav__item" href="" Match="NavLinkMatch.All">
            <NavIcon Name="" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Invernadero</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="lotes">
            <NavIcon Name="lotes" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Lotes</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="optimization">
            <NavIcon Name="optimization" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Optimización</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="simulation">
            <NavIcon Name="simulation" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Simulación</span>
        </NavLink>

        @* Informes: oculta desde 2026-10-26 hasta decidir si se conserva (ver Pages/Reports.razor).
        <NavLink class="sidebar-nav__item" href="reports">
            <NavIcon Name="reports" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Informes</span>
        </NavLink>
        *@
    </div>

    <div class="sidebar-nav__section">
        <span class="sidebar-nav__label">Ajustes</span>

        <NavLink class="sidebar-nav__item" href="settings/profile">
            <NavIcon Name="settings/profile" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Perfil</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="settings/notifications">
            <NavIcon Name="settings/notifications" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Notificaciones</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="settings/parametros">
            <NavIcon Name="settings/parametros" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Parámetros</span>
        </NavLink>

        <NavLink class="sidebar-nav__item" href="settings/circuitos">
            <NavIcon Name="settings/circuitos" Class="sidebar-nav__icon" />
            <span class="sidebar-nav__text">Circuitos</span>
        </NavLink>

        <AuthorizeView>
            <Authorized>
                @if (context.User.IsInRole("Administrador"))
                {
                    <NavLink class="sidebar-nav__item" href="admin/users">
                        <NavIcon Name="admin/users" Class="sidebar-nav__icon" />
                        <span class="sidebar-nav__text">Usuarios</span>
                    </NavLink>
                    <NavLink class="sidebar-nav__item" href="admin/mantenimiento">
                        <NavIcon Name="admin/mantenimiento" Class="sidebar-nav__icon" />
                        <span class="sidebar-nav__text">Mantenimiento</span>
                    </NavLink>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<div class="sidebar-footer">
    <AuthorizeView>
        <Authorized>
            <div class="user-chip">
                <span class="user-chip__avatar">@GetInitials(context.User)</span>
                <div class="user-chip__info">
                    <strong>@GetDisplayName(context.User)</strong>
                    <small>@GetRole(context.User)</small>
                </div>
            </div>
            <a class="sidebar-nav__item sidebar-nav__item--logout" href="/logout">
                <svg class="sidebar-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 20.5H5.5a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2H9" />
                    <path d="m15.5 16.5 4.5-4.5-4.5-4.5" />
                    <path d="M20 12H9" />
                </svg>
                <span class="sidebar-nav__text">Cerrar sesión</span>
            </a>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private static string GetInitials(System.Security.Claims.ClaimsPrincipal user)
    {
        var given = user.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname")?.Value
                    ?? user.FindFirst(ClaimTypes.GivenName)?.Value;
        var surname = user.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname")?.Value
                      ?? user.FindFirst(ClaimTypes.Surname)?.Value;
        var name = user.Identity?.Name;

        if (!string.IsNullOrWhiteSpace(given) && !string.IsNullOrWhiteSpace(surname))
            return $"{given[0]}{surname[0]}".ToUpperInvariant();

        if (!string.IsNullOrWhiteSpace(name) && name.Length >= 2)
            return $"{name[0]}{name[1]}".ToUpperInvariant();

        return "??";
    }

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var given = user.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname")?.Value
                    ?? user.FindFirst(ClaimTypes.GivenName)?.Value ?? "";
        var surname = user.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname")?.Value
                      ?? user.FindFirst(ClaimTypes.Surname)?.Value ?? "";

        if (!string.IsNullOrWhiteSpace(given) || !string.IsNullOrWhiteSpace(surname))
            return $"{given} {surname}".Trim();

        return user.Identity?.Name ?? "Usuario";
    }

    private static string GetRole(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Role)?.Value ?? "Operador";
    }
}


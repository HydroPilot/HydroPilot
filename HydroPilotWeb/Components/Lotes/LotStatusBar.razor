@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@* Estado de TODAS las plantas del lote (activas, cosechadas y descartadas), en % del total. *@
@if (Plants.TotalPlants > 0)
{
    <div class="lot-stack" role="img" aria-label="@AriaLabel">
        @foreach (var item in Layout)
        {
            var label = LotFormat.Pct1(item.Shown);
            @* El % va en todos los tramos; el CSS lo oculta si el tramo es más angosto que el texto. *@
            <div class="lot-stack__seg @(item.Segment.Striped ? "lot-seg--striped" : null)"
                 style="width: @Css(item.Width)%; background-color: @item.Segment.Background; color: @item.Segment.Text;"
                 title="@($"{item.Segment.Label}: {item.Segment.Count} ({label})")">
                <span class="lot-stack__pct @(label.Length >= 5 ? "lot-stack__pct--long" : null)">@label</span>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public LotPlantBreakdown Plants { get; set; } = null!;

    private sealed record Segment(string Label, int Count, string Background, string Text, bool Striped = false);

    /// <summary>Tramo a dibujar: ancho exacto y % mostrado (redondeado de forma acumulada).</summary>
    private sealed record PlacedSegment(Segment Segment, decimal Width, decimal Shown);

    // El orden importa: cosechadas Baby Leaf + Baby Leafs es el "logrado" de la card Baby Leaf y,
    // sumando candidatas, el potencial. Las cosechadas van rayadas con el color de su destino,
    // justo antes de las activas de ese destino (Baby Leaf al principio, adulta después de ED).
    private IEnumerable<Segment> Segments
    {
        get
        {
            var apta = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta);
            var candidate = CommercialStagePalette.ForStage(CommercialStageNames.CandidataBabyLeaf);
            var developing = CommercialStagePalette.ForStage(CommercialStageNames.EnDesarrollo);
            var conventional = CommercialStagePalette.ForStage(CommercialStageNames.CosechaConvencional);
            var risk = CommercialStagePalette.ForStage(CommercialStageNames.RiesgoFueraDeVentana);
            return
            [
                new("Cosechadas Baby Leaf", Plants.HarvestedAsBabyLeaf, apta.Background, apta.Color, Striped: true),
                new("Baby Leafs", Plants.Apta, apta.Background, apta.Color),
                new("Candidatas", Plants.Candidate, candidate.Background, candidate.Color),
                new("En desarrollo", Plants.Developing, developing.Background, developing.Color),
                new("Cosechadas adultas", Plants.Harvested - Plants.HarvestedAsBabyLeaf, conventional.Background, conventional.Color, Striped: true),
                new("Adultas", Plants.Conventional, conventional.Background, conventional.Color),
                new("En riesgo", Plants.Risk, risk.Background, risk.Color),
                new("Descartadas", Plants.Discarded, "#8a94a0", "#2b3440"),
            ];
        }
    }

    // Redondeo acumulado (ver LotGoalsRules.CumulativeShares): 4,5% + 31,9% = 36,4% del logrado Baby Leaf.
    private IReadOnlyList<PlacedSegment> Layout
    {
        get
        {
            var segments = Segments.ToList();
            var shares = LotGoalsRules.CumulativeShares(segments.Select(s => s.Count).ToList(), Plants.TotalPlants);
            return segments
                .Select((segment, i) => new PlacedSegment(segment, segment.Count * 100m / Plants.TotalPlants, shares[i]))
                .Where(p => p.Segment.Count > 0)
                .ToList();
        }
    }

    private string AriaLabel => string.Join(", ",
        Layout.Select(p => $"{p.Segment.Label} {LotFormat.Pct1(p.Shown)}"));

    private static string Css(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

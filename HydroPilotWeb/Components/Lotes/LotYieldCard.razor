@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@* Rendimiento por destino: plantas × peso de referencia (no kg/m²: en hidroponía cada planta
   tiene su hueco, así que se sabe cuántas hay). Dos cuadrados en una fila (desde 2026-10-28; antes dos gráficos de
   barras): el actual (lo cosechado más lo listo hoy: aptas y adultas que llegaron a su corte) y el esperado (lo que va a
   dar el ciclo: histórico del invernadero y situación del lote, según la fase; en verde), con el total en $ y en kg. Al
   tocar uno se abre debajo su detalle: Baby Leaf y adulta con plantas, kg y $ (tooltip: plantas × peso). Pesos y precios
   se editan en Ajustes > Parámetros. En un ciclo cerrado, solo el real, con los pesos y precios guardados al cosechar el
   lote. *@
<section class="lot-card" aria-labelledby="lot-yield-title">
    <header class="lot-card__head">
        <h3 class="lot-card__title" id="lot-yield-title">Rendimiento del lote</h3>
        <InfoTip Title="Cómo se calcula el rendimiento">
            <span class="hp-info__list">
                <span><b>Actual:</b> lo cosechado más lo listo hoy (las Baby Leafs y las adultas que llegaron a su corte).</span>
                <span><b class="hp-info__good">Esperado:</b> lo que va a dar el ciclo completo. Mezcla el <b>histórico</b> (lotes
                    cerrados parecidos: qué % terminó como Baby Leaf y qué % como adulta) con la <b>situación del lote</b>
                    (cosechadas, Baby Leafs, candidatas y trasplantadas). En desarrollo pesa solo el histórico; en la ventana
                    Baby Leaf, cada vez más el lote; después, solo el lote. Nunca baja del actual, y las adultas no pasan
                    del lugar libre en Adultas.</span>
                <span><b>Cálculo:</b> plantas × peso por planta = kg; kg × precio por kg = $. Los pesos y precios se cambian
                    en Ajustes &gt; Parámetros.</span>
                <span>Tocá un cuadrado para ver <span class="hp-info__swatch" style="background: #2d7dd2;"></span>Baby Leaf
                    vs <span class="hp-info__swatch" style="background: #8a4fd3;"></span>adulta.</span>
                <span>Lote cerrado: el real, con los pesos y precios guardados el día de la cosecha.</span>
            </span>
        </InfoTip>
    </header>

    @if (Overview.IsClosed && Overview.HarvestYield is { Real: var real } && real.BabyLeaf.Plants + real.Conventional.Plants == 0)
    {
        @* Lote descartado completo (o cerrado sin cosechas): no hay rendimiento que valorizar. *@
        <p class="lot-card__sub mt-0">No se cosechó ninguna planta@(IsHarvested ? "." : ": el lote se descartó completo.")</p>
    }
    else if (Overview.IsClosed && Overview.HarvestYield is { } harvest)
    {
        @* Ciclo cerrado: solo lo real, valorizado con los pesos y precios guardados el día de la cosecha. *@
        @Tiles([new("Rendimiento real", HarvestBars(harvest))], harvest.Prices.Currency, harvested: true)
        <p class="lot-card__sub">@HarvestPricesText(harvest)</p>
    }
    else if (Yield.Reference.BabyLeafGramsPerPlant is null && Yield.Reference.ConventionalGramsPerPlant is null)
    {
        @* Sin pesos por planta no hay kg que mostrar: no se inventa un valor. *@
        <p class="lot-card__sub">
            Sin definir el peso promedio por planta: no se pueden estimar los kg.
            @DefineLink
        </p>
    }
    else
    {
        @Tiles(ScenarioCharts, Yield.Prices.Currency, harvested: false)
        @if (MissingNote is { } missing)
        {
            <p class="lot-card__sub">@missing @DefineLink</p>
        }
        else
        {
            <p class="lot-card__sub">Baby Leaf @PricePerKg(Yield.Prices.BabyLeafPerKg) · Adulta @PricePerKg(Yield.Prices.ConventionalPerKg)</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public LotOverviewDto Overview { get; set; } = null!;
    /// <summary>Puede editar los parámetros del sistema: el link dice "Definir" en vez de "Ver parámetros".</summary>
    [Parameter] public bool CanEdit { get; set; }

    private static readonly string AptaColor = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta).Background;
    private static readonly string ConventionalColor = CommercialStagePalette.ForStage(CommercialStageNames.CosechaConvencional).Background;

    /// <summary>Una barra: destino, color, kg/$ y de dónde sale (tooltip: plantas × peso).</summary>
    private sealed record YieldBar(string Destination, string Color, DestinationYield Value, string Detail);

    /// <summary>Un cuadrado (actual, esperado o real) con su detalle por destino; BasisDetail = de dónde sale (tooltip).</summary>
    private sealed record YieldChart(string Title, IReadOnlyList<YieldBar> Bars, string? BasisDetail = null, bool Good = false);

    /// <summary>El cuadrado con el detalle abierto (null = ninguno).</summary>
    private int? openTile;

    private LotYieldEstimate Yield => Overview.Yield;
    private LotPlantBreakdown Plants => Overview.Plants;

    // El detalle (tooltip) explica de dónde sale cada número: plantas × peso de referencia.
    private IReadOnlyList<YieldChart> ScenarioCharts
    {
        get
        {
            var bl = Grams(Yield.Reference.BabyLeafGramsPerPlant);
            var conv = Grams(Yield.Reference.ConventionalGramsPerPlant);
            var harvestedAdults = Plants.Harvested - Plants.HarvestedAsBabyLeaf;
            var readyAdults = Yield.Current.Conventional.Plants - harvestedAdults;
            var babyLeafNow = $"{LotFormat.Count(Plants.HarvestedAsBabyLeaf, "cosechada", "cosechadas")} + " +
                              $"{LotFormat.Count(Plants.Apta, "apta", "aptas")} × {bl}";
            var adultNow = $"{LotFormat.Count(harvestedAdults, "cosechada", "cosechadas")} + " +
                           $"{LotFormat.Count(readyAdults, "lista", "listas")} × {conv}" + AdultsWaitingText(readyAdults);

            return
            [
                new("Rendimiento actual",
                [
                    new("Baby Leaf", AptaColor, Yield.Current.BabyLeaf, babyLeafNow),
                    new("Adulta", ConventionalColor, Yield.Current.Conventional, adultNow),
                ]),
                new("Rendimiento esperado",
                [
                    new("Baby Leaf", AptaColor, Yield.Expected.BabyLeaf, $"≈ {LotFormat.Plants(Yield.Expected.BabyLeaf.Plants)} × {bl}"),
                    new("Adulta", ConventionalColor, Yield.Expected.Conventional,
                        $"≈ {LotFormat.Plants(Yield.Expected.Conventional.Plants)} × {conv}" + AdultCapText(harvestedAdults)),
                ], BasisDetail, Good: true),
            ];
        }
    }

    /// <summary>Si el tope de Adultas bajó el esperado: las que ya son adultas más los huecos libres.</summary>
    private string AdultCapText(int harvestedAdults) =>
        Yield.Basis is { AdultsCapped: true, AdultRoom: { } room }
            ? $" · tope: {LotFormat.Count(harvestedAdults + Plants.Adults, "adulta", "adultas")} + " +
              $"{LotFormat.Count(room, "hueco libre", "huecos libres")} en Adultas"
            : string.Empty;

    /// <summary>Las adultas que todavía no llegan a su corte (650 GDD más los días de estrés): cuándo llegan.</summary>
    private string AdultsWaitingText(int readyAdults)
    {
        var waiting = Plants.Adults - readyAdults;
        if (waiting <= 0)
            return string.Empty;
        var when = Overview.Timeline?.ConventionalOptimum.Date is { } date ? $" el {LotFormat.Day(date)}" : " a su corte";
        return $" · {LotFormat.Count(waiting, "adulta llega", "adultas llegan")}{when}";
    }

    /// <summary>Tooltip: qué lotes forman el histórico y cómo terminaron, y cómo pesa según la fase.</summary>
    private string BasisDetail
    {
        get
        {
            var basis = Yield.Basis;
            if (basis.History is not { } history)
                return "Sin lotes cerrados en este invernadero: el esperado sale solo de la situación del lote.";
            var which = history.SameSeason
                ? $"{LotFormat.Count(history.Lots, "lote cerrado", "lotes cerrados")} sembrados en la misma época del año"
                : $"{LotFormat.Count(history.Lots, "lote cerrado", "lotes cerrados")} (no hay suficientes de la misma época)";
            return $"Histórico: {which}, con {LotFormat.Pct(history.BabyLeafShare * 100m)} Baby Leaf, " +
                   $"{LotFormat.Pct(history.ConventionalShare * 100m)} adulta y el resto descartado. " +
                   "En desarrollo cuenta solo el histórico; en la ventana Baby Leaf pesa cada vez más el lote " +
                   "(Baby Leafs + candidatas) y después, solo el lote.";
        }
    }

    private IReadOnlyList<YieldBar> HarvestBars(LotHarvestYield harvest)
    {
        var bl = Grams(harvest.Reference.BabyLeafGramsPerPlant);
        var conv = Grams(harvest.Reference.ConventionalGramsPerPlant);
        return
        [
            new("Baby Leaf", AptaColor, harvest.Real.BabyLeaf,
                $"{LotFormat.Count(harvest.Real.BabyLeaf.Plants, "cosechada", "cosechadas")} como Baby Leaf × {bl}"),
            new("Adulta", ConventionalColor, harvest.Real.Conventional,
                $"{LotFormat.Count(harvest.Real.Conventional.Plants, "cosechada", "cosechadas")} como adulta × {conv}"),
        ];
    }

    /// <summary>
    /// Los cuadrados en una fila (el total en $ grande y los kg debajo) y, debajo, el detalle del que esté abierto: cada
    /// destino con su color, plantas, kg y $ (tooltip: de dónde sale). Tocar un cuadrado lo abre o lo cierra.
    /// </summary>
    private RenderFragment Tiles(IReadOnlyList<YieldChart> charts, string currency, bool harvested) => __builder =>
    {
        <div class="lot-yield-tiles" style="--tiles: @charts.Count;">
            @for (var i = 0; i < charts.Count; i++)
            {
                var index = i;
                var chart = charts[i];
                var isOpen = openTile == index;
                <button type="button" class="lot-yield-tile @(chart.Good ? "lot-yield-tile--good" : null) @(isOpen ? "is-open" : null)"
                        aria-expanded="@(isOpen ? "true" : "false")" title="@chart.BasisDetail"
                        @onclick="() => openTile = isOpen ? null : index">
                    <span class="lot-stat__label">@chart.Title</span>
                    <strong class="lot-yield-tile__money">@TotalMoney(chart, currency)</strong>
                    <span class="lot-yield-tile__kg">
                        @TotalKg(chart)
                        <span class="lot-yield-tile__chevron @(isOpen ? "is-open" : null)" aria-hidden="true">▾</span>
                    </span>
                </button>
            }
        </div>
        @if (openTile is { } shown && shown < charts.Count)
        {
            var pie = PieOf(charts[shown].Bars);
            <div class="lot-yield-detail" aria-label="@($"Detalle del {charts[shown].Title.ToLowerInvariant()}")">
                @if (pie.Count > 0)
                {
                    @* Torta: la parte de cada destino (en $; sin precio, en kg; sin peso, en plantas). *@
                    <div class="lot-yield-pie">
                        <svg class="lot-yield-pie__chart" viewBox="0 0 100 100" role="img"
                             aria-label="@(string.Join(", ", pie.Select(s => $"{s.Bar.Destination} {LotFormat.Pct(s.Share * 100m)}")))">
                            @{ var offset = 0m; }
                            @foreach (var slice in pie)
                            {
                                <circle cx="50" cy="50" r="25" fill="none" stroke="@slice.Bar.Color" stroke-width="50"
                                        stroke-dasharray="@($"{Css(slice.Share * PieLength)} {Css(PieLength)}")"
                                        stroke-dashoffset="@Css(-offset * PieLength)" transform="rotate(-90 50 50)">
                                    <title>@slice.Bar.Destination: @LotFormat.Pct(slice.Share * 100m)</title>
                                </circle>
                                offset += slice.Share;
                            }
                        </svg>
                        <div class="lot-yield-pie__legend">
                            @foreach (var slice in pie)
                            {
                                <span class="lot-yield-pie__item">
                                    <span class="lot-legend__dot" style="background: @slice.Bar.Color;"></span>
                                    @slice.Bar.Destination <strong>@LotFormat.Pct(slice.Share * 100m)</strong>
                                </span>
                            }
                        </div>
                    </div>
                }
                @foreach (var bar in charts[shown].Bars)
                {
                    <div class="lot-yield-detail__row" title="@bar.Detail">
                        <span class="lot-yield-detail__name"><span class="lot-legend__dot" style="background: @bar.Color;"></span>@bar.Destination</span>
                        <span class="lot-yield-detail__plants">@LotFormat.Plants(bar.Value.Plants)</span>
                        <span class="lot-yield-detail__kg">@(harvested ? HarvestKg(bar.Value) : KgText(bar.Value))</span>
                        <strong class="lot-yield-detail__money">@(harvested ? HarvestMoney(bar.Value, currency) : MoneyText(bar.Value, currency))</strong>
                    </div>
                }
            </div>
        }
    };

    /// <summary>Largo de la circunferencia de la torta (r = 25): el trazo de 50 la llena.</summary>
    private const decimal PieLength = 157.08m;

    private sealed record PieSlice(YieldBar Bar, decimal Share);

    /// <summary>
    /// Parte de cada destino para la torta: en $ si todos los destinos con plantas lo tienen; si no, en kg; si no, en
    /// plantas. Vacía si no hay nada.
    /// </summary>
    private static IReadOnlyList<PieSlice> PieOf(IReadOnlyList<YieldBar> bars)
    {
        var withPlants = bars.Where(b => b.Value.Plants > 0).ToList();
        Func<YieldBar, decimal> value = withPlants.All(b => b.Value.Revenue is not null) ? b => b.Value.Revenue ?? 0m
            : withPlants.All(b => b.Value.Kg is not null) ? b => b.Value.Kg ?? 0m
            : b => b.Value.Plants;
        var total = bars.Sum(value);
        return total <= 0m
            ? []
            : bars.Where(b => value(b) > 0m).Select(b => new PieSlice(b, value(b) / total)).ToList();
    }

    /// <summary>Total en $ del cuadrado; "—" si a algún destino con plantas le falta peso o precio.</summary>
    private static string TotalMoney(YieldChart chart, string currency)
    {
        var withPlants = chart.Bars.Where(b => b.Value.Plants > 0).ToList();
        return withPlants.All(b => b.Value.Revenue is not null)
            ? LotFormat.Money(withPlants.Sum(b => b.Value.Revenue ?? 0m), currency)
            : "—";
    }

    /// <summary>Total en kg del cuadrado; "—" si a algún destino con plantas le falta el peso.</summary>
    private static string TotalKg(YieldChart chart)
    {
        var withPlants = chart.Bars.Where(b => b.Value.Plants > 0).ToList();
        return withPlants.All(b => b.Value.Kg is not null) ? LotFormat.KgFine(withPlants.Sum(b => b.Value.Kg ?? 0m)) : "—";
    }

    /// <summary>Qué parámetros del sistema faltan (como "Sin definir" en las metas); null si están todos.</summary>
    private string? MissingNote
    {
        get
        {
            var reference = Yield.Reference;
            var prices = Yield.Prices;
            var missing = new List<string>();

            if (reference.BabyLeafGramsPerPlant is null && reference.ConventionalGramsPerPlant is null)
                missing.Add("peso por planta");
            else
            {
                if (reference.BabyLeafGramsPerPlant is null) missing.Add("peso Baby Leaf");
                if (reference.ConventionalGramsPerPlant is null) missing.Add("peso adulta");
            }

            if (prices.BabyLeafPerKg is null && prices.ConventionalPerKg is null)
                missing.Add("precio por kg");
            else
            {
                if (prices.BabyLeafPerKg is null) missing.Add("precio Baby Leaf");
                if (prices.ConventionalPerKg is null) missing.Add("precio adulta");
            }

            return missing.Count == 0
                ? null
                : $"Sin definir: {(missing.Count == 1 ? missing[0] : string.Join(", ", missing.Take(missing.Count - 1)) + " y " + missing[^1])}.";
        }
    }

    // Pesos y precios son parámetros del sistema: se cargan en Ajustes > Parámetros, no desde el lote.
    private RenderFragment DefineLink =>
        @<a class="lot-link ms-1" href="settings/parametros">@(CanEdit ? "Definir en Parámetros" : "Ver parámetros")</a>;

    private static string KgText(DestinationYield value) => value.Kg is { } kg ? LotFormat.KgFine(kg) : "—";

    private static string HarvestKg(DestinationYield value) =>
        value.Kg is { } kg ? LotFormat.KgFine(kg)
        : value.Plants == 0 ? LotFormat.KgFine(0m)
        : LotFormat.Plants(value.Plants);

    // $0 solo si se guardó el precio; sin peso o sin precio guardado no se inventa un importe.
    private static string HarvestMoney(DestinationYield value, string currency) =>
        value.Revenue is { } revenue ? LotFormat.Money(revenue, currency)
        : value.Plants == 0 ? "—"
        : value.Kg is null ? "sin peso guardado"
        : "sin precio guardado";

    private bool IsHarvested => Overview.State.StatusName == HydroPilotWeb.Services.Forecasting.LotStatusNames.Cosechado;

    /// <summary>Precios del día de la cosecha; si el lote se cerró sin guardarlos, se aclara (no se usan los de hoy).</summary>
    private string HarvestPricesText(LotHarvestYield harvest)
    {
        var prices = harvest.Prices;
        var when = Overview.ClosedCycle?.HarvestDate is { } date ? $" al {LotFormat.Day(date)}" : string.Empty;
        if (prices.BabyLeafPerKg is null && prices.ConventionalPerKg is null && !harvest.Reference.IsComplete)
            return "No se guardaron pesos ni precios al cosechar este lote.";
        return $"Precios{when}: Baby Leaf {PricePerKg(prices.BabyLeafPerKg, prices.Currency)} · " +
               $"Adulta {PricePerKg(prices.ConventionalPerKg, prices.Currency)}";
    }

    private static string MoneyText(DestinationYield value, string currency) =>
        value.Revenue is { } revenue ? LotFormat.Money(revenue, currency)
        : value.Kg is null ? "sin peso"
        : "sin precio";

    private string PricePerKg(decimal? value) => PricePerKg(value, Yield.Prices.Currency);

    private static string PricePerKg(decimal? value, string currency) =>
        value is { } v ? $"{LotFormat.Money(v, currency)}/kg" : "sin precio";

    private static string Grams(decimal? grams) =>
        grams is { } g ? g.ToString("0.#", LotFormat.Culture) + " g" : "peso sin definir";

    private static string Css(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

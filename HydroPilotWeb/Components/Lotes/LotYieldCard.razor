@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@* Rendimiento por destino: plantas × peso de referencia (no kg/m²: en hidroponía cada planta
   tiene su hueco, así que se sabe cuántas hay). Actual = lo listo hoy; potencial = lo que puede llegar. *@
<section class="lot-card" aria-labelledby="lot-yield-title">
    <header class="lot-card__head">
        <h3 class="lot-card__title" id="lot-yield-title">Rendimiento del lote</h3>
        @if (CanEdit && !Overview.IsClosed)
        {
            <button class="lot-icon-btn" @onclick="OnEditReference" title="Editar pesos y precios (parámetros del sistema)" aria-label="Editar pesos y precios (parámetros del sistema)">✎</button>
        }
    </header>

    @if (Overview.IsClosed)
    {
        @if (Overview.ClosedCycle?.ActualYieldKg is { } kg)
        {
            <p class="lot-card__big">@LotFormat.Kg(kg)</p>
            <p class="lot-card__sub">real · @LotFormat.Count(Overview.Plants.Harvested, "planta cosechada", "plantas cosechadas")</p>
        }
        else
        {
            <p class="lot-card__big">—</p>
            <p class="lot-card__sub">sin kg registrados</p>
        }
    }
    else if (Yield.Reference.BabyLeafGramsPerPlant is null && Yield.Reference.ConventionalGramsPerPlant is null)
    {
        @* Sin pesos por planta no hay kg que mostrar: no se inventa un valor. *@
        <p class="lot-card__sub">
            Sin definir el peso promedio por planta: no se pueden estimar los kg.
            @DefineLink
        </p>
    }
    else
    {
        <div class="lot-yield">
            @foreach (var column in Columns)
            {
                <div class="lot-yield__col">
                    <span class="lot-stat__label">@column.Title</span>
                    @* Baby Leaf y convencional en la misma fila. *@
                    <div class="lot-yield__lines">
                        @foreach (var line in column.Lines)
                        {
                            <div class="lot-yield__line" title="@line.Detail">
                                <span class="lot-yield__dest">
                                    <span class="lot-legend__dot" style="background: @line.Color;"></span>@line.Destination
                                </span>
                                <strong class="lot-yield__kg">@(line.Value.Kg is { } kg ? LotFormat.KgFine(kg) : "—")</strong>
                                <span class="lot-yield__money">@MoneyText(line.Value)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        @if (MissingNote is { } missing)
        {
            <p class="lot-card__sub">@missing @DefineLink</p>
        }
        else
        {
            <p class="lot-card__sub">Baby Leaf @PricePerKg(Yield.Prices.BabyLeafPerKg) · Convencional @PricePerKg(Yield.Prices.ConventionalPerKg)</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public LotOverviewDto Overview { get; set; } = null!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnEditReference { get; set; }

    private static readonly string AptaColor = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta).Background;
    private static readonly string ConventionalColor = CommercialStagePalette.ForStage(CommercialStageNames.CosechaConvencional).Background;

    private sealed record YieldLine(string Destination, string Color, DestinationYield Value, string Detail);
    private sealed record YieldColumn(string Title, IReadOnlyList<YieldLine> Lines);

    private LotYieldEstimate Yield => Overview.Yield;
    private LotPlantBreakdown Plants => Overview.Plants;

    // El detalle (tooltip) explica de dónde sale cada número: plantas × peso de referencia.
    private IReadOnlyList<YieldColumn> Columns
    {
        get
        {
            var bl = Grams(Yield.Reference.BabyLeafGramsPerPlant);
            var conv = Grams(Yield.Reference.ConventionalGramsPerPlant);
            var aptas = LotFormat.Count(Plants.Apta, "apta", "aptas");
            var conventional = LotFormat.Count(Plants.Conventional, "convencional", "convencionales");

            return
            [
                new("Rendimiento actual",
                [
                    new("Baby Leaf", AptaColor, Yield.Current.BabyLeaf, $"{aptas} × {bl}"),
                    new("Convencional", ConventionalColor, Yield.Current.Conventional, $"{conventional} × {conv}"),
                ]),
                new("Rendimiento potencial",
                [
                    new("Baby Leaf", AptaColor, Yield.Potential.BabyLeaf,
                        $"({aptas} + {LotFormat.Count(Plants.Candidate, "candidata", "candidatas")}) × {bl}"),
                    new("Convencional", ConventionalColor, Yield.Potential.Conventional,
                        $"({Plants.Developing} en desarrollo + {conventional}) × {conv}"),
                ]),
            ];
        }
    }

    /// <summary>Qué parámetros del sistema faltan (como "Sin definir" en las metas); null si están todos.</summary>
    private string? MissingNote
    {
        get
        {
            var reference = Yield.Reference;
            var prices = Yield.Prices;
            var missing = new List<string>();

            if (reference.BabyLeafGramsPerPlant is null && reference.ConventionalGramsPerPlant is null)
                missing.Add("peso por planta");
            else
            {
                if (reference.BabyLeafGramsPerPlant is null) missing.Add("peso Baby Leaf");
                if (reference.ConventionalGramsPerPlant is null) missing.Add("peso convencional");
            }

            if (prices.BabyLeafPerKg is null && prices.ConventionalPerKg is null)
                missing.Add("precio por kg");
            else
            {
                if (prices.BabyLeafPerKg is null) missing.Add("precio Baby Leaf");
                if (prices.ConventionalPerKg is null) missing.Add("precio convencional");
            }

            return missing.Count == 0
                ? null
                : $"Sin definir: {(missing.Count == 1 ? missing[0] : string.Join(", ", missing.Take(missing.Count - 1)) + " y " + missing[^1])}.";
        }
    }

    // Editores: abre el atajo a los parámetros. El resto: link a Ajustes > Parámetros para verlos.
    private RenderFragment DefineLink => CanEdit
        ? @<button class="lot-link ms-1" @onclick="OnEditReference">Definir</button>
        : @<a class="lot-link ms-1" href="settings/parametros">Ver parámetros</a>;

    private string MoneyText(DestinationYield value) =>
        value.Revenue is { } revenue ? LotFormat.Money(revenue, Yield.Prices.Currency)
        : value.Kg is null ? "sin peso"
        : "sin precio";

    private string PricePerKg(decimal? value) =>
        value is { } v ? $"{LotFormat.Money(v, Yield.Prices.Currency)}/kg" : "sin precio";

    private static string Grams(decimal? grams) =>
        grams is { } g ? g.ToString("0.#", LotFormat.Culture) + " g" : "peso sin definir";
}

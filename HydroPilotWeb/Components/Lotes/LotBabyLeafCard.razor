@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@* Baby Leaf: en la barra, cuánto del lote ya es (o puede llegar a ser) Baby Leaf: cosechadas como Baby
   Leaf (rayadas), Baby Leafs y candidatas, con su % y cantidad adentro de cada tramo, como la barra del mapa.
   La raya marca la meta del ciclo ("meta 70%"). Se edita con el lápiz (modal de metas del lote). *@
<section class="lot-card" aria-labelledby="lot-bl-title">
    <header class="lot-card__head">
        <h3 class="lot-card__title" id="lot-bl-title">Meta Baby Leaf</h3>
        @if (CanEdit)
        {
            <div class="lot-card__actions">
                <button class="lot-icon-btn" @onclick="OnEditObjectives" title="Editar metas del lote" aria-label="Editar metas del lote">✎</button>
            </div>
        }
    </header>

    <div>
        <div class="lot-goalbar">
            <div class="lot-stack" role="img" aria-label="@AriaLabel">
                @foreach (var item in Layout)
                {
                    var pct = LotFormat.Pct1(item.Shown);
                    var full = $"{pct} ({item.Segment.Count})";
                    @* "% (cantidad)" si entra en el tramo; si no, solo el %; si tampoco, nada (el CSS mide el tramo). *@
                    <div class="lot-stack__seg @(item.Segment.Striped ? "lot-seg--striped" : null)"
                         style="width: @Css(item.Width)%; background-color: @item.Segment.Background; color: @item.Segment.Text;"
                         title="@($"{item.Segment.Label}: {item.Segment.Count} ({pct})")">
                        <span class="lot-stack__full @(full.Length >= 9 ? "lot-stack__full--long" : null)">@full</span>
                        <span class="lot-stack__short @(pct.Length >= 5 ? "lot-stack__short--long" : null)">@pct</span>
                    </div>
                }
            </div>
            @if (Goal is { } marker)
            {
                <div class="lot-progress__marker" style="--pos: @Css(Math.Clamp(marker, 0m, 100m));" title="Meta @LotFormat.Pct1(marker)"></div>
            }
        </div>
        @if (Goal is { } goal)
        {
            <div class="lot-bar-labels" aria-hidden="true">
                <span class="lot-bar-labels__goal" style="--pos: @Css(Math.Min(100m, goal));">meta @LotFormat.Pct1(goal)</span>
            </div>
        }
    </div>

    <div class="lot-legend">
        @if (Plants.HarvestedAsBabyLeaf > 0 || Overview.IsClosed)
        {
            <span class="lot-legend__item">
                <span class="lot-legend__dot lot-seg--striped" style="background-color: @AptaColor;"></span>
                @LotFormat.Count(Plants.HarvestedAsBabyLeaf, "cosechada", "cosechadas")
            </span>
        }
        @if (!Overview.IsClosed)
        {
            <span class="lot-legend__item">
                <span class="lot-legend__dot" style="background: @AptaColor;"></span>
                @LotFormat.Count(Plants.Apta, "Baby Leaf", "Baby Leafs")
            </span>
            <span class="lot-legend__item">
                <span class="lot-legend__dot" style="background: @CandidateColor;"></span>
                @LotFormat.Count(Plants.Candidate, "candidata", "candidatas")
            </span>
        }
    </div>

    @if (Goal is null)
    {
        <p class="lot-card__sub">Sin meta definida.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LotOverviewDto Overview { get; set; } = null!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnEditObjectives { get; set; }

    private static readonly CommercialStagePalette.CellStyle Apta = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta);
    private static readonly CommercialStagePalette.CellStyle Candidate = CommercialStagePalette.ForStage(CommercialStageNames.CandidataBabyLeaf);
    private static readonly string AptaColor = Apta.Background;
    private static readonly string CandidateColor = Candidate.Background;

    private sealed record Segment(string Label, int Count, string Background, string Text, bool Striped = false);

    /// <summary>Tramo a dibujar: ancho exacto y % mostrado (redondeo acumulado, como la barra del mapa).</summary>
    private sealed record PlacedSegment(Segment Segment, decimal Width, decimal Shown);

    private LotGoalsRules.Result Goals => Overview.Goals;
    private LotPlantBreakdown Plants => Overview.Plants;
    private decimal? Goal => Overview.Objectives.BabyLeafGoalPercent;

    // Mismo orden que la barra del mapa: cosechadas + Baby Leafs es lo logrado; sumando candidatas, el potencial.
    private IReadOnlyList<PlacedSegment> Layout
    {
        get
        {
            if (Plants.TotalPlants <= 0)
                return [];

            Segment[] segments =
            [
                new("Cosechadas como Baby Leaf", Plants.HarvestedAsBabyLeaf, Apta.Background, Apta.Color, Striped: true),
                new("Baby Leafs", Plants.Apta, Apta.Background, Apta.Color),
                new("Candidatas", Plants.Candidate, Candidate.Background, Candidate.Color),
            ];
            var shares = LotGoalsRules.CumulativeShares(segments.Select(s => s.Count).ToList(), Plants.TotalPlants);
            return segments
                .Select((segment, i) => new PlacedSegment(segment, segment.Count * 100m / Plants.TotalPlants, shares[i]))
                .Where(p => p.Segment.Count > 0)
                .ToList();
        }
    }

    private string AriaLabel =>
        $"Baby Leaf logrado {LotFormat.Pct1(Goals.AchievedPercent)} ({Plants.HarvestedAsBabyLeaf} cosechadas y {Plants.Apta} Baby Leafs), " +
        $"potencial {LotFormat.Pct1(Goals.PotentialPercent)} con {Plants.Candidate} candidatas, de {LotFormat.Plants(Plants.TotalPlants)}" +
        (Goal is { } g ? $"; meta {LotFormat.Pct1(g)}" : string.Empty);

    private static string Css(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@* Baby Leaf: cuánto del lote ya es baby leaf contra la meta del ciclo, y cuánto puede llegar a serlo.
   Sin título ni badge de ventana: el dato principal ya dice de qué habla y la ventana está en la card de arriba. *@
<section class="lot-card" aria-label="Baby Leaf">
    <div class="lot-kpi">
        <span class="lot-card__big">@LotFormat.Pct1(Goals.AchievedPercent)</span>
        <span class="lot-kpi__text">
            @(Overview.IsClosed ? "del lote se cosechó como Baby Leaf" : "del lote ya es Baby Leaf")
            <span class="lot-kpi__note">· @Goals.AchievedCount de @LotFormat.Plants(Plants.TotalPlants)</span>
        </span>
        @if (CanEdit)
        {
            <button class="lot-icon-btn lot-kpi__action" @onclick="OnEditObjectives" title="Editar metas del ciclo" aria-label="Editar metas del ciclo">✎</button>
        }
    </div>

    <div>
        <div class="lot-progress lot-progress--lg" role="img" aria-label="@AriaLabel">
            <div class="lot-progress__fill">
                <div class="lot-progress__seg lot-seg--striped" style="width: @Css(HarvestedShare)%; background-color: @AptaColor;" title="Cosechadas como baby leaf: @Plants.HarvestedAsBabyLeaf"></div>
                <div class="lot-progress__seg" style="width: @Css(AptaShare)%; background: @AptaColor;" title="Aptas: @Plants.Apta"></div>
                <div class="lot-progress__seg" style="width: @Css(CandidateShare)%; background: @CandidateColor;" title="Candidatas: @Plants.Candidate"></div>
            </div>
            @if (Goal is { } g)
            {
                <div class="lot-progress__marker" style="left: @Css(Math.Min(100m, g))%;" title="Meta @LotFormat.Pct1(g)"></div>
            }
        </div>
        @if (Goal is { } marker)
        {
            <div class="lot-bar-labels" aria-hidden="true">
                @* Centrada en la raya de la meta; cerca de un borde se corre lo justo para no salirse (ver CSS). *@
                <span class="lot-bar-labels__goal" style="--pos: @Css(Math.Min(100m, marker));">
                    meta @LotFormat.Pct1(marker) · @LotFormat.Count(Goals.GoalPlants ?? 0, "baby leaf", "baby leafs")
                </span>
            </div>
        }
    </div>

    <div class="lot-legend">
        @if (Plants.HarvestedAsBabyLeaf > 0 || Overview.IsClosed)
        {
            <span class="lot-legend__item">
                <span class="lot-legend__dot lot-seg--striped" style="background-color: @AptaColor;"></span>
                @LotFormat.Count(Plants.HarvestedAsBabyLeaf, "cosechada", "cosechadas")
            </span>
        }
        @if (!Overview.IsClosed)
        {
            <span class="lot-legend__item">
                <span class="lot-legend__dot" style="background: @AptaColor;"></span>
                @LotFormat.Count(Plants.Apta, "apta", "aptas")
            </span>
            <span class="lot-legend__item">
                <span class="lot-legend__dot" style="background: @CandidateColor;"></span>
                @LotFormat.Count(Plants.Candidate, "candidata", "candidatas")
            </span>
        }
    </div>

    <div class="lot-stats">
        <div class="lot-stat">
            <span class="lot-stat__label">Meta del ciclo</span>
            @if (Goal is null)
            {
                <span class="lot-stat__value lot-stat__value--muted">Sin definir</span>
                @if (CanEdit)
                {
                    <button class="lot-link" @onclick="OnEditObjectives">Definir meta</button>
                }
            }
            else
            {
                var (value, tone, hint) = GoalStatus();
                <span class="lot-stat__value lot-stat__value--@tone">@value</span>
                @if (hint is not null)
                {
                    <span class="lot-stat__hint">@hint</span>
                }
            }
        </div>
        @if (Overview.IsClosed)
        {
            <div class="lot-stat">
                <span class="lot-stat__label">Resto del lote</span>
                <span class="lot-stat__value">@LotFormat.Plants(Plants.TotalPlants - Plants.HarvestedAsBabyLeaf)</span>
            </div>
        }
        else
        {
            <div class="lot-stat">
                <span class="lot-stat__label">Potencial</span>
                <span class="lot-stat__value @PotentialTone">
                    @LotFormat.Pct1(Goals.PotentialPercent)
                    <small>· @Goals.PotentialCount de @LotFormat.Plants(Plants.TotalPlants)</small>
                </span>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public LotOverviewDto Overview { get; set; } = null!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnEditObjectives { get; set; }

    private static readonly string AptaColor = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta).Background;
    private static readonly string CandidateColor = CommercialStagePalette.ForStage(CommercialStageNames.CandidataBabyLeaf).Background;

    private LotGoalsRules.Result Goals => Overview.Goals;
    private LotPlantBreakdown Plants => Overview.Plants;
    private decimal? Goal => Overview.Objectives.BabyLeafGoalPercent;

    private decimal Share(int count) => Plants.TotalPlants > 0 ? count * 100m / Plants.TotalPlants : 0m;
    private decimal HarvestedShare => Share(Plants.HarvestedAsBabyLeaf);
    private decimal AptaShare => Share(Plants.Apta);
    private decimal CandidateShare => Share(Plants.Candidate);

    private string AriaLabel =>
        $"{Plants.HarvestedAsBabyLeaf} cosechadas, {Plants.Apta} aptas y {Plants.Candidate} candidatas de {Plants.TotalPlants} plantas" +
        (Goal is { } g ? $"; meta {LotFormat.Pct1(g)}" : string.Empty);

    // Potencial en verde si alcanza la meta (cumplida o alcanzable con las candidatas), en rojo si no; sin meta, neutro.
    private string? PotentialTone => Goals.BabyLeafStatus switch
    {
        BabyLeafGoalStatus.Cumplida or BabyLeafGoalStatus.Alcanzable => "lot-stat__value--success",
        BabyLeafGoalStatus.PorDebajo => "lot-stat__value--danger",
        _ => null
    };

    // Amarillo: las candidatas alcanzan para la meta; rojo: ni con todas se llega.
    private (string Value, string Tone, string? Hint) GoalStatus()
    {
        var missing = $"Faltan {LotFormat.Plants(Goals.PlantsMissingForGoal)}";
        return Goals.BabyLeafStatus switch
        {
            BabyLeafGoalStatus.Cumplida => ("Cumplida", "success", null),
            // En un ciclo cerrado ya no hay plantas que puedan sumar: solo cumplida o no.
            BabyLeafGoalStatus.Alcanzable or BabyLeafGoalStatus.PorDebajo when Overview.IsClosed =>
                ("No cumplida", "danger", $"faltaron {LotFormat.Plants(Goals.PlantsMissingForGoal)}"),
            BabyLeafGoalStatus.Alcanzable => (missing, "warning", null),
            BabyLeafGoalStatus.PorDebajo => (missing, "danger", null),
            _ => ("Sin plantas en el lote", "muted", null)
        };
    }

    private static string Css(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

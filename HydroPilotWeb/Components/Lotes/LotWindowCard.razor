@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@* Ventana actual del lote: línea de tiempo con las ventanas (la fase actual va en color pleno) y las
   cosechas estimadas (óptimos por GDD, no la fecha del forecast). Sin chip de fase: la barra ya la dice.
   El día del ciclo va en la línea de tiempo, junto a "Hoy". Los problemas de datos (temperaturas
   sintéticas o faltantes) se marcan en la sección de detalles técnicos. *@
<section class="lot-card" aria-labelledby="lot-window-title">
    <header class="lot-card__head">
        <h3 class="lot-card__title" id="lot-window-title">@(Overview.IsClosed ? "Ciclo" : "Ventana actual")</h3>
        <InfoTip Title="La ventana del lote">
            <span class="hp-info__text">
                La línea de tiempo del ciclo por calor acumulado (GDD), de la siembra a la sobremadurez. La fase de hoy va en
                color pleno.
            </span>
            <span class="hp-info__stack">
                <span class="hp-info__pump"><span style="background: #2e9e4f;"></span>Desarrollo: 0–250 GDD</span>
                <span class="hp-info__pump"><span style="background: #2d7dd2;"></span>Baby Leaf: 250–450 GDD</span>
                <span class="hp-info__pump"><span style="background: #8a4fd3;"></span>Adulta: 450–750 GDD</span>
            </span>
            <span class="hp-info__list">
                <span><b>Fechas:</b> las que ya pasaron salen del GDD medido; las futuras, del pronóstico de 7 días corregido a
                    la temperatura de adentro; más allá de 7 días, extrapoladas (≈).</span>
                <span><b>Cosecha óptima Baby Leaf:</b> el <b>pico de aptas</b>, el día con más Baby Leafs a la vez. Se toma el
                    historial de lotes parecidos como referencia para estimar. Cuando las aptas empiezan a bajar se sugiere la
                    decisión: <b class="hp-info__good">Cortar ahora</b>.</span>
                <span><b>Cosecha óptima Adulta:</b> 650 GDD más los días de estrés del trasplante (Ajustes &gt;
                    Parámetros).</span>
                <span>La que sigue en el denso a los 450 GDD sin cortarse se descarta; después de 750, pasado de
                    cosecha.</span>
            </span>
        </InfoTip>
    </header>

    @if (Overview.IsClosed)
    {
        @if (Overview.Timeline is { } closedTimeline)
        {
            @* Las ventanas del ciclo con sus fechas reales, hasta el cierre. La siembra y la marca
               "Fin del ciclo dd/mm (día N)" ya dicen las fechas: sin texto aparte. El fin del ciclo es la
               última cosecha (o el último descarte), no "la" cosecha: se cosecha en varios cortes. *@
            <LotCycleTimeline Timeline="closedTimeline" ClosedLabel="Fin del ciclo" />
        }
        else
        {
            <p class="lot-card__sub">
                Siembra @LotFormat.Day(Overview.State.SowingDate)
                @(Overview.ClosedCycle?.HarvestDate is { } harvested ? $"→ fin del ciclo {LotFormat.Day(harvested)}" : null)
                @(Overview.ClosedCycle?.CycleDays is { } days ? $"· {LotFormat.Days(days)}" : null)
            </p>
        }
    }
    else if (Overview.Timeline is { } timeline)
    {
        <LotCycleTimeline Timeline="timeline" />
    }
    else
    {
        <p class="lot-card__sub">Sin datos de temperatura suficientes para proyectar las ventanas de cosecha.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LotOverviewDto Overview { get; set; } = null!;
}

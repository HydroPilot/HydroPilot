@using HydroPilotWeb.Models
@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

<div class="card plant-detail h-100">
    <div class="card-body">
        <h6 class="card-title">Detalle de planta</h6>

        @if (Detail is null)
        {
            <p class="text-muted small mb-0">
                Seleccioná una posición del mapa para ver el detalle.
            </p>
        }
        else
        {
            var stageStyle = CommercialStagePalette.ForStage(Detail.CommercialStageName);
            var opState = Detail.OperationalState switch
            {
                PlantOperationalState.Cosechada => (Label: "Cosechada", Css: "badge text-bg-success"),
                PlantOperationalState.Descartada => (Label: "Descartada", Css: "badge text-bg-secondary"),
                _ => (Label: "Activa", Css: "badge text-bg-primary")
            };

            <div class="d-flex align-items-center gap-2 mb-2">
                <strong>F@(Detail.Row)-C@(Detail.Column)</strong>
                <span class="@opState.Css">@opState.Label</span>
                @if (Detail.CommercialStageName is not null)
                {
                    <span class="badge" style="background: @stageStyle.Background; color: @stageStyle.Color;">@Detail.CommercialStageName</span>
                }
            </div>

            <ul class="list-group list-group-flush plant-detail__list">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Etapa fenológica</span>
                    <strong>@(Detail.PhenologicalStageName ?? "—")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>GDD del lote</span>
                    <strong>@Detail.LotGdd</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>EC / pH</span>
                    <strong>@(Detail.CurrentEc?.ToString() ?? "—") / @(Detail.CurrentPh?.ToString() ?? "—")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>BabyLeafScore</span>
                    <strong>@(Detail.BabyLeafScore?.ToString() ?? "—")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>GrowthRate</span>
                    <strong>@(Detail.GrowthRate?.ToString() ?? "—")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Última evaluación</span>
                    <strong>@(Detail.LastEvaluationAtUtc?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong>
                </li>
                @if (Detail.HarvestDate is not null)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Cosechada</span>
                        <strong>@Detail.HarvestDate.Value.ToString("dd/MM/yyyy")</strong>
                    </li>
                }
                @if (Detail.DiscardDate is not null)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Descartada</span>
                        <strong>@Detail.DiscardDate.Value.ToString("dd/MM/yyyy")</strong>
                    </li>
                    <li class="list-group-item">
                        <span class="text-muted">Motivo:</span> @Detail.DiscardReason
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between">
                    <span>Imagen</span>
                    @if (Detail.HasImage)
                    {
                        <strong title="@Detail.LastImagePath">@Detail.LastImageFileName</strong>
                    }
                    else
                    {
                        <span class="text-muted">Sin imagen</span>
                    }
                </li>
            </ul>

            @if (Detail.History.Count > 0)
            {
                <h6 class="mt-3 mb-1 small text-uppercase text-muted">Histórico de cambios</h6>
                <table class="table table-sm table-striped small mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Origen</th>
                            <th>Cambio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Detail.History.Take(8))
                        {
                            <tr title="@entry.Reason">
                                <td>@entry.ChangedAtUtc.ToString("dd/MM")</td>
                                <td>@entry.Source</td>
                                <td>@(entry.PreviousState ?? "·") → @(entry.NewState ?? "·")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @foreach (var warning in Detail.Warnings)
            {
                <div class="alert alert-warning py-1 px-2 small mb-1 mt-2">@warning</div>
            }
        }
    </div>
</div>

<style>
    .plant-detail .plant-detail__list .list-group-item {
        padding: 0.35rem 0.25rem;
        font-size: 13px;
    }
</style>

@code {
    [Parameter] public PlantDetailDto? Detail { get; set; }
    [Parameter] public EventCallback OnHarvest { get; set; }
    [Parameter] public EventCallback<string> OnDiscard { get; set; }
}
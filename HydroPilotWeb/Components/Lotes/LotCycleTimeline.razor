@using HydroPilotWeb.Services.Lotes
@namespace HydroPilotWeb.Components.Lotes

@if (Timeline is null)
{
    <p class="lot-muted mt-0">Sin datos de temperatura suficientes para proyectar las ventanas de cosecha.</p>
}
else
{
    var t = Timeline!;
    var marks = CutMarks(t);
    <div class="lot-timeline" role="img" aria-label="@AriaLabel(t)">
        @{
            var todayPos = Pos(t.AsOfDate);
        }
        <div class="lot-timeline__today-label @EdgeClass(todayPos)" style="left: @Css(todayPos)%;">
            @(ClosedLabel is { } closed ? $"{closed} {LotFormat.Short(t.AsOfDate)}" : t.AsOfDate == Today ? "Hoy" : LotFormat.Short(t.AsOfDate))
            <span class="lot-timeline__cycle-day">(@(t.AsOfDate < t.SowingDate ? $"siembra en {LotFormat.Days(t.SowingDate.DayNumber - t.AsOfDate.DayNumber)}" : $"día {t.CycleDay}"))</span>
        </div>
        @* El tramo de la fase actual va en color pleno; el resto, atenuado. *@
        <div class="lot-timeline__bar">
            <div class="lot-timeline__seg lot-timeline__seg--dev @Current(CyclePhase.Desarrollo)" style="width: @Css(Width(t.SowingDate, t.BabyLeafOpens.Date))%;"
                 title="Desarrollo: de la siembra a la apertura de la ventana Baby Leaf">desarrollo</div>
            @if (t.BabyLeafOpens.Date is { } opens)
            {
                <div class="lot-timeline__seg lot-timeline__seg--bl @Current(CyclePhase.VentanaBabyLeaf)" style="width: @Css(Width(opens, t.BabyLeafCloses.Date))%;"
                     title="@($"Ventana Baby Leaf: {Range(t.BabyLeafOpens, t.BabyLeafCloses)}")">Baby Leaf</div>
            }
            @if (t.BabyLeafCloses.Date is { } closes)
            {
                <div class="lot-timeline__seg lot-timeline__seg--conv @Current(CyclePhase.VentanaConvencional)" style="width: @Css(Width(closes, t.Overmaturity.Date))%;"
                     title="@($"Ventana adulta: {Range(t.BabyLeafCloses, t.Overmaturity)}")">adulta</div>
            }
        </div>
        <div class="lot-timeline__today" style="left: @Css(Pos(t.AsOfDate))%;"></div>
        @* Cosechas óptimas: una línea punteada por óptimo de corte, como la de "Hoy". Baja hasta su etiqueta
           (debajo de las fechas de las ventanas); si pasaría por encima de una fecha, se corta en esa fila. *@
        @foreach (var mark in marks)
        {
            <div class="lot-timeline__cut-line @mark.State @(mark.CrossesDate ? null : "lot-timeline__cut-line--long") @(mark.Row == 2 ? "lot-timeline__cut-line--row2" : null)"
                 style="left: @Css(mark.Pos)%;"></div>
        }
        <div class="lot-timeline__labels">
            <span class="lot-timeline__label--start" style="left: 0%;" title="Siembra">@LotFormat.Short(t.SowingDate)</span>
            @if (t.BabyLeafOpens.Date is { } o)
            {
                <span style="left: @Css(Pos(o))%;" title="@MilestoneTitle("Abre la ventana Baby Leaf", t.BabyLeafOpens)">@Label(t.BabyLeafOpens)</span>
            }
            @if (t.BabyLeafCloses.Date is { } c && t.Overmaturity.Date is not null)
            {
                <span style="left: @Css(Pos(c))%;" title="@MilestoneTitle("Cierra la ventana Baby Leaf y abre la adulta", t.BabyLeafCloses)">@Label(t.BabyLeafCloses)</span>
            }
            <span class="lot-timeline__label--end" style="left: 100%;" title="@EndTitle(t)">@EndLabel(t)</span>
        </div>
        @if (marks.Count > 0)
        {
            <div class="lot-timeline__cuts @(marks.Any(m => m.Row == 2) ? "lot-timeline__cuts--two-rows" : null)">
                @foreach (var mark in marks)
                {
                    @if (mark.CrossesDate)
                    {
                        <div class="lot-timeline__cut-stem @mark.State @(mark.Row == 2 ? "lot-timeline__cut-stem--row2" : null)" style="left: @Css(mark.Pos)%;"></div>
                    }
                    <div class="lot-timeline__cut @mark.State @(mark.Row == 2 ? "lot-timeline__cut--row2" : null)" style="--pos: @Css(mark.Pos);" title="@mark.Title">
                        <span class="lot-timeline__cut-what">@mark.What</span>
                        <span class="lot-timeline__cut-date">@mark.Date</span>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public CycleTimeline? Timeline { get; set; }

    /// <summary>Ciclo cerrado: "Fin del ciclo" (marca del cierre en vez de "Hoy"); null = en curso.</summary>
    [Parameter] public string? ClosedLabel { get; set; }

    private const string ExtrapolatedHint = "≈: más allá de los 7 días de pronóstico, extrapolación con el último GDD diario.";

    /// <summary>Distancia mínima (en % de la barra) entre dos etiquetas de cosecha en la misma fila.</summary>
    private const decimal MinCutLabelGap = 32m;

    /// <summary>Media etiqueta de fecha de ventana ("≈13/11"), en % de la barra: más cerca, la línea la pisaría.</summary>
    private const decimal DateLabelHalfWidth = 8m;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    /// <summary>
    /// Cosecha óptima (óptimo de corte de un destino): posición en la barra, fila de la etiqueta, texto,
    /// tooltip y estado (clase CSS). CrossesDate = la línea pasaría por encima de una fecha de ventana.
    /// </summary>
    private sealed record CutMark(decimal Pos, int Row, bool CrossesDate, string What, string Date, string Title, string? State);

    // "Hoy (día N)" es ancho: cerca de los bordes se alinea hacia adentro en vez de centrarse.
    private static string? EdgeClass(decimal pos) =>
        pos < 12m ? "lot-timeline__today-label--start" : pos > 88m ? "lot-timeline__today-label--end" : null;

    private string Current(CyclePhase phase) =>
        Timeline!.Phase == phase ? "lot-timeline__seg--current" : "lot-timeline__seg--dim";

    /// <summary>Fin de la escala: sobremadurez, o el último hito conocido + 7 días.</summary>
    private DateOnly End
    {
        get
        {
            var t = Timeline!;
            if (t.Overmaturity.Date is { } over && over > t.SowingDate)
                return over;
            var known = new[] { t.BabyLeafCloses.Date, t.BabyLeafOpens.Date, t.AsOfDate }
                .Where(d => d is not null).Select(d => d!.Value).Max();
            return known.AddDays(7);
        }
    }

    private decimal Pos(DateOnly date)
    {
        var start = Timeline!.SowingDate.DayNumber;
        var span = Math.Max(1, End.DayNumber - start);
        return Math.Clamp((date.DayNumber - start) * 100m / span, 0m, 100m);
    }

    private decimal Width(DateOnly from, DateOnly? to) => Math.Max(0m, Pos(to ?? End) - Pos(from));

    /// <summary>
    /// Una marca por óptimo de corte (Baby Leaf y adulta). El próximo corte va en color pleno; el
    /// otro (ya pasó, o es del destino siguiente), atenuado. Ya en el óptimo: "Cortar ahora"; en
    /// sobremadurez: "Pasado de cosecha".
    /// </summary>
    private IReadOnlyList<CutMark> CutMarks(CycleTimeline t)
    {
        var cut = ClosedLabel is null ? t.NextCut : null;
        var dates = DatePositions(t);
        var marks = new List<CutMark>();
        foreach (var (optimum, destination) in new[] { (t.BabyLeafOptimum, HarvestDestination.BabyLeaf), (t.ConventionalOptimum, HarvestDestination.Convencional) })
        {
            if (optimum.Date is not { } date || date < t.SowingDate || date > End)
                continue;

            var isNext = cut?.Destination == destination;
            var overdue = ClosedLabel is null && t.Phase == CyclePhase.Sobremadurez && destination == HarvestDestination.Convencional;
            var (what, state) = isNext && cut!.CutNow ? ("Cortar ahora", "lot-cut--now")
                : overdue ? ("Pasado de cosecha", "lot-cut--overdue")
                : ("Cosecha óptima", isNext && optimum.IsEstimate ? null : "lot-cut--dim");

            var pos = Pos(date);
            var title = $"Corte óptimo de {Name(destination)} ({LotFormat.Num(optimum.Gdd)} GDD): {LotFormat.Milestone(optimum)}{InDays(t, optimum)}"
                        + (optimum.IsExtrapolated ? $". {ExtrapolatedHint}" : string.Empty);
            marks.Add(new CutMark(pos, 1, dates.Any(d => CrossesDate(pos, d)), what, Label(optimum), title, state));
        }

        // Dos etiquetas muy cerca: la segunda baja una fila para no pisarse.
        marks.Sort((a, b) => a.Pos.CompareTo(b.Pos));
        for (var i = 1; i < marks.Count; i++)
        {
            if (marks[i].Pos - marks[i - 1].Pos < MinCutLabelGap && marks[i - 1].Row == 1)
                marks[i] = marks[i] with { Row = 2 };
        }
        return marks;
    }

    /// <summary>Posiciones de las fechas de las ventanas que se ven debajo de la barra.</summary>
    private List<decimal> DatePositions(CycleTimeline t)
    {
        var positions = new List<decimal> { 0m, 100m };
        if (t.BabyLeafOpens.Date is { } opens)
            positions.Add(Pos(opens));
        if (t.BabyLeafCloses.Date is { } closes && t.Overmaturity.Date is not null)
            positions.Add(Pos(closes));
        return positions;
    }

    // La primera fecha va alineada a la izquierda y la última a la derecha; las del medio, centradas.
    private static bool CrossesDate(decimal cutPos, decimal datePos) => datePos switch
    {
        0m => cutPos <= DateLabelHalfWidth * 2,
        100m => cutPos >= 100m - DateLabelHalfWidth * 2,
        _ => Math.Abs(cutPos - datePos) <= DateLabelHalfWidth
    };

    private static string Name(HarvestDestination destination) =>
        destination == HarvestDestination.BabyLeaf ? "Baby Leaf" : "adultas";

    private static string InDays(CycleTimeline t, CycleMilestone milestone) =>
        milestone.Date is { } date && date >= t.AsOfDate
            ? date == t.AsOfDate ? " (hoy)" : $" (en {LotFormat.Days(date.DayNumber - t.AsOfDate.DayNumber)})"
            : string.Empty;

    private static string Label(CycleMilestone milestone) =>
        milestone.Date is { } date ? (milestone.IsExtrapolated ? "≈" : string.Empty) + LotFormat.Short(date) : string.Empty;

    private static string MilestoneTitle(string what, CycleMilestone milestone) =>
        milestone.IsExtrapolated ? $"{what} (≈ estimado más allá de los 7 días de pronóstico)" : what;

    private static string EndLabel(CycleTimeline t) =>
        t.Overmaturity.Date is not null ? Label(t.Overmaturity)
        : t.BabyLeafCloses.Date is not null ? Label(t.BabyLeafCloses)
        : string.Empty;

    private static string EndTitle(CycleTimeline t) =>
        t.Overmaturity.Date is not null
            ? MilestoneTitle("Sobremadurez: fin de la ventana adulta", t.Overmaturity)
            : MilestoneTitle("Cierra la ventana Baby Leaf", t.BabyLeafCloses);

    private static string Range(CycleMilestone from, CycleMilestone to) =>
        $"{LotFormat.Milestone(from)} → {LotFormat.Milestone(to)}";

    private static string AriaLabel(CycleTimeline t) =>
        $"Siembra {LotFormat.Short(t.SowingDate)}; ventana Baby Leaf {Range(t.BabyLeafOpens, t.BabyLeafCloses)}, " +
        $"cosecha estimada {LotFormat.Milestone(t.BabyLeafOptimum)}; ventana adulta {Range(t.BabyLeafCloses, t.Overmaturity)}, " +
        $"cosecha estimada {LotFormat.Milestone(t.ConventionalOptimum)}; día {t.CycleDay} del ciclo.";

    private static string Css(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

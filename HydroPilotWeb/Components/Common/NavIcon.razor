@namespace HydroPilotWeb.Components.Common

@* Ícono de cada vista: el mismo en el menú y a la izquierda del título de la vista. Name es la ruta
   de la vista ("" = Invernadero). Sin ícono para la ruta, no dibuja nada. *@
@if (HasIcon(Name))
{
    <svg class="@Class" viewBox="0 0 24 24" aria-hidden="true">
        @switch (Name)
        {
            case "":
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9v11h5v-6h4v6h5V9" />
                break;
            case "lotes":
                <path d="M12 21v-9" />
                <path d="M12 12c0-4.4 3.1-7.5 8-7.5 0 4.4-3.1 7.5-8 7.5Z" />
                <path d="M12 14.5c0-3.4-2.5-6-7-6 0 3.4 2.5 6 7 6Z" />
                break;
            case "reports":
                <path d="M4 20h16" />
                <path d="M7 16v-5" />
                <path d="M12 16V6" />
                <path d="M17 16V9" />
                break;
            case "simulation":
                <path d="M9 3h6" />
                <path d="M10 3v6.5L4.6 18.4A1.7 1.7 0 0 0 6.1 21h11.8a1.7 1.7 0 0 0 1.5-2.6L14 9.5V3" />
                <path d="M7.5 15h9" />
                break;
            case "optimization":
                <path d="M11 3.5 12.8 8.2 17.5 10l-4.7 1.8L11 16.5l-1.8-4.7L4.5 10l4.7-1.8Z" />
                <path d="M18.5 14.5 19.4 17l2.6.9-2.6.9-.9 2.7-.9-2.7-2.6-.9 2.6-.9Z" />
                break;
            case "control":
                <path d="M12 3.5c3.6 4.3 6 7.5 6 10.5a6 6 0 0 1-12 0c0-3 2.4-6.2 6-10.5Z" />
                <path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5" />
                break;
            case "anomalies":
                <path d="M10.3 4.2 2.7 17.5A2 2 0 0 0 4.4 20.5h15.2a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0Z" />
                <path d="M12 9.5v4" />
                <path d="M12 17h.01" />
                break;
            case "settings/profile":
                <circle cx="12" cy="8" r="4" />
                <path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" />
                break;
            case "settings/notifications":
            case "notifications":
                <path d="M18 15.5V11a6 6 0 1 0-12 0v4.5L4 18h16Z" />
                <path d="M10 21h4" />
                break;
            case "settings/parametros":
                <path d="M4 7h9" />
                <path d="M17 7h3" />
                <circle cx="15" cy="7" r="2" />
                <path d="M4 17h3" />
                <path d="M11 17h9" />
                <circle cx="9" cy="17" r="2" />
                break;
            case "admin/users":
                <circle cx="9" cy="8" r="3.5" />
                <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
                <path d="M16 4.7a3.5 3.5 0 0 1 0 6.6" />
                <path d="M18 14.3a6.5 6.5 0 0 1 3.5 5.7" />
                break;
            case "admin/mantenimiento":
                <path d="M14.5 6.5a4 4 0 0 0-5.3 5.3L3.8 17.2a2 2 0 0 0 2.9 2.9l5.4-5.4a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.6-.4-.4-2.6Z" />
                break;
        }
    </svg>
}

@code {
    /// <summary>Ruta de la vista (la misma del menú): "", "lotes", "settings/parametros", etc.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string? Class { get; set; }

    public static bool HasIcon(string name) => name is "" or "lotes" or "reports" or "simulation" or "optimization"
        or "control" or "anomalies" or "settings/profile" or "settings/notifications" or "notifications" or "settings/parametros"
        or "admin/users" or "admin/mantenimiento";
}

@namespace HydroPilotWeb.Components.Reports
@using HydroPilotWeb.Services.Reports

@if (Warnings.Count > 0)
{
    <div class="alert alert-warning py-2 px-3 small">
        <strong>Advertencias:</strong>
        <ul class="mb-0 ps-3 mt-1">
            @foreach (var w in Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}

@if (Parameters is not null)
{
    <div class="border rounded p-2 mb-3 bg-light small">
        <span class="text-muted me-2">Parámetros usados:</span>
        <span class="badge text-bg-secondary me-1">generado @Parameters.GeneratedAtUtc</span>
        @foreach (var line in Parameters.Lines)
        {
            <span class="badge text-bg-light border me-1">@line</span>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<string> Warnings { get; set; } = [];
    [Parameter] public ReportAppliedParameters? Parameters { get; set; }
}
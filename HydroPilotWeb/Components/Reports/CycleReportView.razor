@namespace HydroPilotWeb.Components.Reports
@using HydroPilotWeb.Services.Reports
@using Microsoft.JSInterop
@inject ReportQueryService Reports
@inject IJSRuntime JS

<section class="panel">
    <div class="panel__header panel__header--compact">
        <h4>Reporte de ciclo de cultivo</h4>
        <p class="text-muted small mb-0">
            Siembra, cosecha estimada/real, GDD y rendimiento por lote. Las métricas provienen de las
            predicciones persistidas por forecasting y de GddService/YieldService (fuente del módulo de
            forecasting); Reports no recalcula fórmulas.
        </p>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <label class="form-label small mb-1">Lote</label>
            <select class="form-select form-select-sm" @bind="lotId">
                <option value="">Todos</option>
                @foreach (var lot in options?.Lots ?? [])
                {
                    <option value="@lot.Id">@lot.Label</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1">Fecha de corte (GDD/estimaciones)</label>
            <input type="date" class="form-control form-control-sm" @bind="asOfDate" />
        </div>
    </div>

    <div class="d-flex gap-2 mb-2">
        <button class="btn btn-primary btn-sm" @onclick="Generate" disabled="@loading">
            @(loading ? "Generando..." : "Generar")
        </button>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border" role="status"><span class="visually-hidden">Consultando...</span></div>
        </div>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger">
            <strong>No se pudo generar el reporte.</strong> @error
            <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="Generate">Reintentar</button>
        </div>
    }
    else if (result is not null)
    {
        <ReportNotice Warnings="result.Warnings" Parameters="result.Parameters" />

        @if (result.Rows.Count == 0)
        {
            <div class="alert alert-info">No hay lotes para el reporte de ciclo con los filtros elegidos.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Lote</th>
                            <th>Siembra</th>
                            <th class="text-end">GDD acum.</th>
                            <th class="text-end">GDD obj.</th>
                            <th>Cosecha estimada</th>
                            <th>Cosecha real</th>
                            <th class="text-end">Rend. estimado (kg)</th>
                            <th class="text-end">Rend. real (kg)</th>
                            <th class="text-end">Error días</th>
                            <th class="text-end">Error rend. (%)</th>
                            <th class="text-end">Datos temp. (utilizables/total)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in result.Rows)
                        {
                            <tr>
                                <td>
                                    @(r.LotName ?? $"#{r.LotId}")
                                    <div class="text-muted small">@r.CropTypeName · @(r.StatusName ?? "—")</div>
                                </td>
                                <td class="small">@r.SowingDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@r.GddAccumulated.ToString("0.##")</td>
                                <td class="text-end">@r.GddTarget.ToString("0.##")</td>
                                <td class="small" title="@r.EstimatedHarvestSource">
                                    @(r.EstimatedHarvestDate?.ToString("dd/MM/yyyy") ?? "—")
                                </td>
                                <td class="small">
                                    @(r.ActualHarvestDate?.ToString("dd/MM/yyyy") ?? "pendiente")
                                </td>
                                <td class="text-end">@(r.EstimatedYieldKg?.ToString("0.##") ?? "—")</td>
                                <td class="text-end">@(r.ActualYieldKg?.ToString("0.##") ?? "—")</td>
                                <td class="text-end">@(r.DaysError?.ToString() ?? "—")</td>
                                <td class="text-end">@(r.YieldErrorPercent?.ToString("0.#") ?? "—")</td>
                                <td class="text-end small" title="Lecturas de temperatura del invernadero desde la siembra">
                                    @r.UsableTemperatureReadings/@r.TemperatureReadings
                                </td>
                            </tr>
                            @foreach (var w in r.Warnings)
                            {
                                <tr><td colspan="11" class="text-warning small border-0 py-0">⚠ @w</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Download">⬇ CSV ciclo</button>
        }
    }
</section>

@code {
    private ReportFilterOptions? options;
    private CycleReportResult? result;
    private bool loading;
    private string? error;

    private int? lotId;
    private DateOnly? asOfDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            options = await Reports.GetFilterOptionsAsync();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar las opciones de filtros: {ex.Message}";
        }
    }

    private async Task Generate()
    {
        error = null;
        loading = true;
        try
        {
            result = await Reports.GetCycleReportAsync(new CycleReportRequest(lotId, asOfDate));
        }
        catch (Exception ex)
        {
            result = null;
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Download()
    {
        if (result is null) return;
        var csv = CsvExportService.Cycle(result);
        await JS.InvokeVoidAsync("hydroReportsDownload", csv.FileName,
            Convert.ToBase64String(csv.Content));
    }
}
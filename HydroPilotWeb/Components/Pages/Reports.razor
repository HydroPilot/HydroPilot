@page "/reports"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using HydroPilotWeb.Components.Reports

<PageTitle>Informes</PageTitle>

<h1 class="h4 mb-2">Informes</h1>
<p class="text-muted small mb-3">
    Reportes consultables y exportables, generados bajo demanda sobre los datos existentes
    (telemetría, lotes/plantas y predicciones de forecasting). Ningún valor se inventa en pantalla;
    el CSV descarga los mismos datos visibles. Exportación PDF queda explícitamente pendiente (plan 13).
</p>

<ul class="nav nav-pills mb-3 gap-1 flex-wrap" role="tablist">
    @foreach (var tab in Tabs)
    {
        <li class="nav-item" role="presentation">
            <button type="button"
                    class="nav-link @(activeTab == tab.Id ? "active" : null)"
                    @onclick="() => activeTab = tab.Id">
                @tab.Label
            </button>
        </li>
    }
</ul>

@switch (activeTab)
{
    case "telemetry":
        <TelemetryReportView />
        break;
    case "cycle":
        <CycleReportView />
        break;
    case "forecast":
        <ForecastVsHarvestReportView />
        break;
    case "lotState":
        <LotStateReportView />
        break;
    case "plants":
        <PlantsReportView />
        break;
    case "changes":
        <StageChangesReportView />
        break;
    case "anomalies":
        <AnomalyReportView />
        break;
}

<script>
    // Descarga de CSV generada en servidor (mismo DTO que la tabla visible).
    window.hydroReportsDownload = function (fileName, base64) {
        const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
        const blob = new Blob([bytes], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
    };
</script>

@code {
    private sealed record ReportTab(string Id, string Label);

    private static readonly IReadOnlyList<ReportTab> Tabs =
    [
        new("telemetry", "Telemetría"),
        new("cycle", "Ciclo de cultivo"),
        new("forecast", "Forecast vs cosecha"),
        new("lotState", "Estado de lote"),
        new("plants", "Plantas"),
        new("changes", "Cambios de estado"),
        new("anomalies", "Anomalías (pendiente)"),
    ];

    private string activeTab = "telemetry";
}
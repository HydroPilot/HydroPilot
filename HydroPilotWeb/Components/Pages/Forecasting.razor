@page "/forecasting"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HydroPilotDbContext> DbFactory
@inject GddService GddService
@inject YieldService YieldService
@inject SettingsService SettingsService

<PageTitle>Forecasting</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (lots is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (lots.Count == 0)
{
    <div class="alert alert-info">
        No hay lotes registrados. Creá uno con el botón "+ Nuevo lote" o ejecutá <code>mock_historical_data.py</code> para generar datos de prueba.
    </div>

    <button class="btn btn-outline-primary btn-sm" @onclick="() => showNewLotForm = !showNewLotForm">
        @(showNewLotForm ? "Ocultar" : "+ Nuevo lote")
    </button>

    @if (showNewLotForm)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Registrar nuevo lote</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Cultivo</label>
                        <select class="form-select" @bind="newLotCropTypeId">
                            @foreach (var crop in cropTypes)
                            {
                                <option value="@crop.Id">@crop.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha de siembra</label>
                        <input type="date" class="form-control" @bind="newLotSowingDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Área (m²)</label>
                        <input type="number" step="0.1" min="0.1" class="form-control" @bind="newLotAreaM2" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" @onclick="CreateLot" disabled="@creatingLot">
                            @(creatingLot ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </div>
                @if (lotError is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@lotError</div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="mb-3 d-flex gap-2 align-items-center">
        <label class="form-label mb-0">Lote:</label>
        <select class="form-select form-select-sm" style="width: auto;" @bind="selectedLotId" @bind:after="LoadForecast">
            @foreach (var lot in lots)
            {
                <option value="@lot.Id">#@lot.Id — @(lot.CropType?.Name ?? "—") (@(lot.Status?.Name ?? "—"), siembra @lot.SowingDate)</option>
            }
        </select>

        <div class="ms-auto d-flex gap-2 align-items-center">
            <button class="btn btn-outline-primary btn-sm" @onclick="() => showNewLotForm = !showNewLotForm">
                @(showNewLotForm ? "Ocultar" : "+ Nuevo lote")
            </button>
            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Administrador"))
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="weatherFetchToggle"
                                   checked="@weatherFetchEnabled" @onchange="OnWeatherToggleChanged" />
                            <label class="form-check-label" for="weatherFetchToggle">Sincronización climática diaria</label>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (showNewLotForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Registrar nuevo lote</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Cultivo</label>
                        <select class="form-select" @bind="newLotCropTypeId">
                            @foreach (var crop in cropTypes)
                            {
                                <option value="@crop.Id">@crop.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha de siembra</label>
                        <input type="date" class="form-control" @bind="newLotSowingDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Área (m²)</label>
                        <input type="number" step="0.1" min="0.1" class="form-control" @bind="newLotAreaM2" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" @onclick="CreateLot" disabled="@creatingLot">
                            @(creatingLot ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </div>
                @if (lotError is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@lotError</div>
                }
            </div>
        </div>
    }

    @if (forecast is not null)
    {
        <section class="metric-row metric-row--three">
            <article class="metric-card">
                <p>Rendimiento estimado</p>
                <strong>@forecast.YieldBase.ToString("0.#") kg</strong>
                <span>@forecast.ConfidencePercent% confianza</span>
                @if (forecast.AccuracyCycles > 0)
                {
                    <span class="text-muted" style="font-weight: 400; font-size: 0.75rem;">
                        Precisión: MAPE @forecast.AccuracyMape?.ToString("0.#")% · ±@forecast.AccuracyDaysError?.ToString("0") días (@forecast.AccuracyCycles ciclos)
                    </span>
                }
            </article>
            <article class="metric-card">
                <p>Fecha óptima de cosecha</p>
                <strong>@(forecast.EstimatedHarvestDate?.ToString("dd MMM") ?? "—")</strong>
                <span>@(forecast.DaysRemaining > 0 ? $"{forecast.DaysRemaining} días restantes" : "lista para cosecha")</span>
                @if (forecast.DaysRemaining > 0 && forecast.DaysRemaining <= HarvestAlertDays)
                {
                    <span class="badge bg-warning text-dark mt-2">⚠ Cosecha inminente</span>
                }
            </article>
            <article class="metric-card">
                <p>GDD acumulado</p>
                <strong>@forecast.GddAccumulated.ToString("0.#") °Cd</strong>
                <span>objetivo @forecast.GddTarget.ToString("0.#") °Cd</span>
            </article>
        </section>

        <p class="text-muted" style="font-size: 0.8rem; margin-top: -8px;">
            Valores estimados de soporte a la decisión — no garantizan resultado.
        </p>

        <section class="panel">
            <div class="panel__header">
                <div>
                    <h3>GDD acumulado por día</h3>
                    <p>@forecast.CropType — siembra @forecast.SowingDate, área @forecast.AreaM2 m²</p>
                </div>
                <div class="chip-row">
                    <span class="tag tag--soft">GDD · Tbase 4.5°C</span>
                    <span class="tag tag--soft">Promedio @forecast.GddDailyAverage.ToString("0.#") °Cd/día</span>
                </div>
            </div>

            <div class="chart-stack">
                @if (forecast.GddHistory.Count > 0)
                {
                    <SimpleLineChart
                        Data="GddCumulativeData"
                        Height="300"
                        AccentClass="emerald"
                        MinValue="0"
                        MaxValue="GddChartMax"
                        TargetValue="(double?)GddTargetValue"
                        ShowGrid="true"
                        RotateXLabels="true"
                        XLabels="GddXLabels"
                        YLabels="GddYLabels"
                        PointLabels="GddPointLabels" />

                    @if (GddProjectedData.Count > 0)
                    {
                        <div class="chart-stack__projection">
                            <SimpleLineChart
                                Data="GddProjectedData"
                                Height="300"
                                AccentClass="green"
                                Dashed="true"
                                Fill="false"
                                MinValue="0"
                                MaxValue="GddChartMax"
                                HideLabels="true" />
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted p-3">Sin lecturas de temperatura registradas para este lote.</p>
                }
            </div>
        </section>

        <section class="split-grid split-grid--two">
            <article class="panel">
                <h3>Datos del lote</h3>
                <ul class="key-list">
                    <li><span>Cultivo</span><strong>@forecast.CropType</strong></li>
                    <li><span>Estado</span><strong>@forecast.Status</strong></li>
                    <li><span>Fecha de siembra</span><strong>@forecast.SowingDate</strong></li>
                    <li><span>Área plantada</span><strong>@forecast.AreaM2 m²</strong></li>
                    <li><span>GDD diario promedio</span><strong>@forecast.GddDailyAverage.ToString("0.#") °Cd</strong></li>
                    @if (forecast.ActualYieldKg is not null)
                    {
                        <li><span>Cosecha real</span><strong>@forecast.ActualYieldKg.Value.ToString("0.#") kg @(forecast.ActualHarvestDate is not null ? $"el {forecast.ActualHarvestDate}" : "")</strong></li>
                    }
                </ul>
            </article>

            <article class="panel">
                <h3>Escenarios de rendimiento</h3>
                <div class="scenario-list">
                    <div class="scenario-card"><strong>Conservador</strong><span>@forecast.YieldConservative.ToString("0.#") kg</span><small>@(forecast.YieldConservativePercent.ToString("0.#"))%</small></div>
                    <div class="scenario-card scenario-card--active"><strong>Base</strong><span>@forecast.YieldBase.ToString("0.#") kg</span><small>@forecast.ConfidencePercent%</small></div>
                    <div class="scenario-card"><strong>Optimista</strong><span>@forecast.YieldOptimistic.ToString("0.#") kg</span><small>+@(forecast.YieldOptimisticPercent.ToString("0.#"))%</small></div>
                </div>
            </article>
        </section>
    }
}

@code {
    private List<Lot>? lots;
    private List<CropType> cropTypes = [];
    private ForecastView? forecast;
    private string? error;
    private string? lotError;
    private int selectedLotId;
    private bool weatherFetchEnabled;
    private bool showNewLotForm;
    private bool creatingLot;
    private int newLotCropTypeId;
    private DateOnly newLotSowingDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private decimal newLotAreaM2 = 4.5m;
    private int HarvestAlertDays = 3;

    private IReadOnlyList<double> GddCumulativeData
    {
        get
        {
            var cum = new List<double>();
            double acc = 0;
            foreach (var p in forecast?.GddHistory ?? [])
            {
                acc += (double)p.Gdd;
                cum.Add(Math.Round(acc, 1));
            }
            return cum;
        }
    }

    private IReadOnlyList<double> GddProjectedData
    {
        get
        {
            if (forecast is null || forecast.FutureProjection.Count == 0) return [];
            var cum = GddCumulativeData.ToList();
            double acc = cum.Count > 0 ? cum[^1] : 0;
            foreach (var p in forecast.FutureProjection)
            {
                acc += (double)p.Gdd;
                cum.Add(Math.Round(acc, 1));
            }
            return cum;
        }
    }

    private double GddChartMax =>
        Math.Max(GddProjectedData.Count > 0 ? GddProjectedData.Max() : 0, GddTargetValue);

    private double GddTargetValue => forecast is not null ? (double)forecast.GddTarget : 0;

    private IReadOnlyList<string>? GddYLabels =>
        GddCumulativeData.Count > 0
            ? [GddChartMax.ToString("0.#"), (GddChartMax / 2).ToString("0.#"), "0"]
            : null;

    private IReadOnlyList<string>? GddXLabels
    {
        get
        {
            var history = forecast?.GddHistory ?? [];
            if (history.Count == 0) return null;
            return history.Select(p => p.Date.ToString("dd/MM")).ToArray();
        }
    }

    private IReadOnlyList<string>? GddPointLabels
    {
        get
        {
            var history = forecast?.GddHistory ?? [];
            if (history.Count == 0) return null;

            // Etiquetas por punto: fecha completa + GDD acumulado de ese día
            var labels = new List<string>();
            double acc = 0;
            foreach (var p in history)
            {
                acc += (double)p.Gdd;
                labels.Add($"{p.Date:dd/MM/yyyy} — {acc:0.#} °Cd acumulados");
            }
            return labels;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        weatherFetchEnabled = await SettingsService.GetBoolAsync(SettingsService.WeatherFetchEnabledKey);
        HarvestAlertDays = await SettingsService.GetIntAsync("HarvestAlertDays", 3);
        await LoadLots();
    }

    private async Task CreateLot()
    {
        creatingLot = true;
        lotError = null;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var activeStatus = await context.LotStatuses.FirstOrDefaultAsync(s => s.Name == "ACTIVO");

            context.Lots.Add(new Lot
            {
                GreenhouseId = (await context.Greenhouses.FirstOrDefaultAsync())?.Id ?? 0,
                CropTypeId = newLotCropTypeId,
                StatusId = activeStatus?.Id ?? 1,
                SowingDate = newLotSowingDate,
                PlantedAreaM2 = newLotAreaM2,
                CreatedAt = DateTime.UtcNow
            });
            await context.SaveChangesAsync();

            showNewLotForm = false;
            await LoadLots();
        }
        catch (Exception ex)
        {
            lotError = $"Error al crear el lote: {ex.Message}";
        }
        finally
        {
            creatingLot = false;
        }
    }

    private async Task OnWeatherToggleChanged(ChangeEventArgs e)
    {
        weatherFetchEnabled = e.Value is bool value && value;
        await SettingsService.SetBoolAsync(SettingsService.WeatherFetchEnabledKey, weatherFetchEnabled);
    }

    private async Task LoadLots()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            lots = await context.Lots
                .Include(l => l.CropType)
                .Include(l => l.Status)
                .OrderByDescending(l => l.SowingDate)
                .ToListAsync();

            cropTypes = await context.CropTypes.OrderBy(c => c.Name).ToListAsync();
            if (newLotCropTypeId == 0 && cropTypes.Count > 0)
                newLotCropTypeId = cropTypes[0].Id;

            error = null;

            if (lots.Count > 0)
            {
                selectedLotId = lots[0].Id;
                await LoadForecast();
            }
        }
        catch (Exception ex)
        {
            error = $"Error al cargar lotes: {ex.Message}";
            lots = [];
        }
    }

    private async Task LoadForecast()
    {
        if (selectedLotId == 0) return;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var lot = await context.Lots
                .Include(l => l.CropType)
                .Include(l => l.Status)
                .FirstOrDefaultAsync(l => l.Id == selectedLotId);

            if (lot is null)
            {
                error = $"Lote '{selectedLotId}' no encontrado.";
                return;
            }

            var dailyGdd = await GddService.GetDailyGddByDateAsync(lot);
            var accumulated = dailyGdd.Values.Sum();
            var futureProjection = await GddService.GetFutureGddProjectionAsync(lot);
            var harvestDate = GddService.EstimateHarvestDateAsync(lot, accumulated, futureProjection);
            var daysRemaining = harvestDate is not null
                ? (harvestDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.UtcNow.Date).Days
                : 0;
            var yield = await YieldService.EstimateAsync(lot, accumulated);
            var avgDaily = futureProjection.Count > 0
                ? futureProjection.Average(p => p.Gdd)
                : 0m;

            var conservativePct = yield.Base > 0 ? (yield.Base - yield.Conservative) / yield.Base * 100m : 0m;
            var optimisticPct = yield.Base > 0 ? (yield.Optimistic - yield.Base) / yield.Base * 100m : 0m;

            var accuracy = await GetAccuracyAsync();

            forecast = new ForecastView(
                CropType: lot.CropType?.Name ?? "Desconocido",
                Status: lot.Status?.Name,
                SowingDate: lot.SowingDate,
                AreaM2: lot.PlantedAreaM2,
                GddAccumulated: accumulated,
                GddTarget: lot.CropType?.GddTarget ?? 0m,
                GddDailyAverage: avgDaily,
                EstimatedHarvestDate: harvestDate,
                DaysRemaining: daysRemaining,
                YieldConservative: yield.Conservative,
                YieldBase: yield.Base,
                YieldOptimistic: yield.Optimistic,
                YieldConservativePercent: conservativePct,
                YieldOptimisticPercent: optimisticPct,
                ConfidencePercent: yield.ConfidencePercent,
                AccuracyMape: accuracy.Mape,
                AccuracyDaysError: accuracy.DaysError,
                AccuracyCycles: accuracy.Cycles,
                ActualYieldKg: lot.ActualYieldKg,
                ActualHarvestDate: lot.ActualHarvestDate,
                GddHistory: dailyGdd.OrderBy(kv => kv.Key)
                    .Select(kv => new DailyGddPoint(kv.Key, kv.Value))
                    .ToList(),
                FutureProjection: futureProjection
                    .Select(p => new DailyGddPoint(p.Date, p.Gdd))
                    .ToList()
            );

            error = null;
        }
        catch (Exception ex)
        {
            error = $"Error al cargar el forecast: {ex.Message}";
        }
    }

    private async Task<(decimal? Mape, decimal? DaysError, int Cycles)> GetAccuracyAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var closed = await context.Lots
            .Where(l => l.ActualYieldKg.HasValue)
            .Select(l => new
            {
                l.ActualYieldKg,
                l.ActualHarvestDate,
                LatestPrediction = l.Predictions
                    .OrderByDescending(p => p.GeneratedAt)
                    .FirstOrDefault()
            })
            .ToListAsync();

        var withPred = closed.Where(c => c.LatestPrediction is not null).ToList();
        if (withPred.Count == 0) return (null, null, 0);

        var mape = new List<decimal>();
        var days = new List<decimal>();

        foreach (var c in withPred)
        {
            var p = c.LatestPrediction!;
            if (p.EstimatedYield.HasValue && p.EstimatedYield > 0)
                mape.Add(Math.Abs(p.EstimatedYield.Value - c.ActualYieldKg!.Value) / c.ActualYieldKg.Value * 100m);
            if (p.EstimatedHarvestDate.HasValue && c.ActualHarvestDate.HasValue)
                days.Add(Math.Abs((p.EstimatedHarvestDate.Value.ToDateTime(TimeOnly.MinValue) - c.ActualHarvestDate.Value.ToDateTime(TimeOnly.MinValue)).Days));
        }

        return (
            mape.Count > 0 ? Math.Round(mape.Average(), 1) : null,
            days.Count > 0 ? Math.Round(days.Average(), 1) : null,
            withPred.Count);
    }

    private sealed record ForecastView(
        string CropType,
        string? Status,
        DateOnly SowingDate,
        decimal AreaM2,
        decimal GddAccumulated,
        decimal GddTarget,
        decimal GddDailyAverage,
        DateOnly? EstimatedHarvestDate,
        int DaysRemaining,
        decimal YieldConservative,
        decimal YieldBase,
        decimal YieldOptimistic,
        decimal YieldConservativePercent,
        decimal YieldOptimisticPercent,
        int ConfidencePercent,
        decimal? AccuracyMape,
        decimal? AccuracyDaysError,
        int AccuracyCycles,
        decimal? ActualYieldKg,
        DateOnly? ActualHarvestDate,
        List<DailyGddPoint> GddHistory,
        List<DailyGddPoint> FutureProjection);

    private sealed record DailyGddPoint(DateOnly Date, decimal Gdd);
}

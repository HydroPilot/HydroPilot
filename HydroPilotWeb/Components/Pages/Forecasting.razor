@page "/forecasting"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using HydroPilotWeb.Controllers
@using HydroPilotWeb.Components.Lotes
@using HydroPilotWeb.Services.Forecasting
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Models
@inject IDbContextFactory<HydroPilotDbContext> DbFactory
@inject ForecastService ForecastService
@inject LotAggregateService LotAggregate
@inject SettingsService SettingsService
@inject ILogger<Forecasting> Logger

<PageTitle>Forecasting</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (lots is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (lots.Count == 0)
{
    <div class="alert alert-info">
        No hay lotes operativos (ACTIVO / EN_PAUSA). Creá uno con el botón "+ Nuevo lote" o ejecutá <code>mock_historical_data.py</code> para generar datos de prueba.
        Los lotes cosechados y descartados se consultan como histórico (Reports), no en la proyección operativa.
    </div>

    <button class="btn btn-outline-primary btn-sm" @onclick="() => showNewLotForm = !showNewLotForm">
        @(showNewLotForm ? "Ocultar" : "+ Nuevo lote")
    </button>

    @if (showNewLotForm)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Registrar nuevo lote</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Cultivo</label>
                        <select class="form-select" @bind="newLotCropTypeId">
                            @foreach (var crop in cropTypes)
                            {
                                <option value="@crop.Id">@crop.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha de siembra</label>
                        <input type="date" class="form-control" @bind="newLotSowingDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Área (m²)</label>
                        <input type="number" step="0.1" min="0.1" class="form-control" @bind="newLotAreaM2" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" @onclick="CreateLot" disabled="@creatingLot">
                            @(creatingLot ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </div>
                @if (lotError is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@lotError</div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
        <label class="form-label mb-0">Lote:</label>
        <select class="form-select form-select-sm" style="width: auto;" @bind="selectedLotId" @bind:after="LoadForecast">
            @foreach (var lot in lots)
            {
                <option value="@lot.Id">#@lot.Id — @(lot.CropType) (@(lot.Status), siembra @lot.SowingDate.ToString("dd/MM/yyyy"))</option>
            }
        </select>

        <div class="ms-auto d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">Simular fecha:</label>
            <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="simDate" @bind:after="LoadForecast" />
            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetSimDate">Hoy</button>
            <button class="btn btn-outline-primary btn-sm" @onclick="() => showNewLotForm = !showNewLotForm">
                @(showNewLotForm ? "Ocultar" : "+ Nuevo lote")
            </button>
            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Administrador"))
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="weatherFetchToggle"
                                   checked="@weatherFetchEnabled" @onchange="OnWeatherToggleChanged" />
                            <label class="form-check-label" for="weatherFetchToggle">Sincronización climática diaria</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="weatherNoLimitToggle"
                                   checked="@weatherDailyLimitDisabled" @onchange="OnWeatherLimitToggleChanged" />
                            <label class="form-check-label" for="weatherNoLimitToggle">Sin límite diario de clima</label>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (showNewLotForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Registrar nuevo lote</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Cultivo</label>
                        <select class="form-select" @bind="newLotCropTypeId">
                            @foreach (var crop in cropTypes)
                            {
                                <option value="@crop.Id">@crop.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha de siembra</label>
                        <input type="date" class="form-control" @bind="newLotSowingDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Área (m²)</label>
                        <input type="number" step="0.1" min="0.1" class="form-control" @bind="newLotAreaM2" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" @onclick="CreateLot" disabled="@creatingLot">
                            @(creatingLot ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </div>
                @if (lotError is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@lotError</div>
                }
            </div>
        </div>
    }

    @if (forecast is not null)
    {
        @if (forecast.IsSimulation)
        {
            <div class="alert alert-info py-1 px-2 small">
                ⏱ Vista SIMULADA al @forecast.AsOfDate.ToString("dd/MM/yyyy") — no se usan datos posteriores a esa fecha. Los valores no representan el estado productivo actual.
            </div>
        }

        @foreach (var warning in forecast.Warnings)
        {
            <div class="alert alert-warning py-1 px-2 small mb-1">⚠ @warning</div>
        }

        <section class="metric-row metric-row--three">
            <article class="metric-card">
                <p>Rendimiento estimado</p>
                <strong>@forecast.Yield.Base.ToString("0.#") kg</strong>
                <span>@forecast.Yield.ConfidencePercent% confianza (heurística)</span>
                @if (forecast.AccuracyCycles > 0)
                {
                    <span class="text-muted" style="font-weight: 400; font-size: 0.75rem;">
                        Precisión (última predicción pre-cosecha): MAPE @forecast.AccuracyMape?.ToString("0.#")% · ±@forecast.AccuracyDaysError?.ToString("0") días (@forecast.AccuracyCycles ciclos)
                    </span>
                }
                else
                {
                    <span class="text-muted" style="font-weight: 400; font-size: 0.75rem;">Sin ciclos cerrados con predicción previa: precisión no calculada.</span>
                }
            </article>
            <article class="metric-card">
                <p>Fecha estimada de cosecha</p>
                @if (forecast.EstimatedHarvestDate is { } harvestT)
                {
                    <strong>@harvestT.ToString("dd MMM")</strong>
                    <span>@(forecast.DaysRemaining is > 0 ? $"{forecast.DaysRemaining} días restantes" : (forecast.DaysRemaining == 0 ? "lista para cosecha" : "—"))</span>
                }
                else
                {
                    <strong>—</strong>
                    <span>@(forecast.HarvestWindow?.NotReadyReason is { } reason ? reason : "sin fecha estimada")</span>
                }
                @if (forecast.DaysRemaining is > 0 && forecast.DaysRemaining <= HarvestAlertDays)
                {
                    <span class="badge bg-warning text-dark mt-2">⚠ Cosecha inminente</span>
                }
            </article>
            <article class="metric-card">
                <p>GDD acumulado</p>
                <strong>@forecast.GddAccumulated.ToString("0.#") °Cd</strong>
                <span>objetivo @forecast.GddTarget.ToString("0.#") °Cd · Tbase @forecast.BaseTemperature.ToString("0.#")°C</span>
                <span class="text-muted" style="font-weight: 400; font-size: 0.75rem;">
                    Cobertura @forecast.CoverageDays/@(forecast.CoverageDays + forecast.MissingDays) días
                    @(forecast.CoveragePercent is { } cp ? $"({cp.ToString("0.#")}%)" : "")
                </span>
            </article>
        </section>

        <p class="text-muted" style="font-size: 0.8rem; margin-top: -8px;">
            Valores estimados de soporte a la decisión — no garantizan resultado.
        </p>

        <div class="chip-row mb-3">
            <span class="tag tag--soft">Fuente: @forecast.DataSourceSummary</span>
            <span class="tag tag--soft">@SourceKindLabel(forecast.SourceKind)</span>
            <span class="tag tag--soft">Modelo @forecast.ModelVersion</span>
            <span class="tag tag--soft">Pronóstico horizonte @forecast.ForecastHorizonDays días</span>
            @if (forecast.PhenologicalStageName is not null)
            {
                <span class="tag tag--soft">Etapa fenológica: @forecast.PhenologicalStageName</span>
            }
            @if (forecast.CommercialStageName is not null)
            {
                <span class="tag tag--soft">Predominante: @forecast.CommercialStageName</span>
            }
        </div>

        <section class="panel">
            <div class="panel__header">
                <div>
                    <h3>GDD acumulado por día</h3>
                    <p>@forecast.CropTypeName — siembra @forecast.SowingDate.ToString("dd/MM/yyyy"), área @forecast.AreaM2 m²</p>
                </div>
                <div class="chip-row">
                    <span class="tag tag--soft">GDD · Tbase @forecast.BaseTemperature.ToString("0.#")°C</span>
                    <span class="tag tag--soft">Promedio @forecast.GddDailyAverage.ToString("0.#") °Cd/día</span>
                </div>
            </div>

            <div class="chart-stack">
                @if (forecast.GddHistory.Count > 0)
                {
                    <SimpleLineChart
                        Data="GddCumulativeData"
                        Height="300"
                        AccentClass="emerald"
                        MinValue="0"
                        MaxValue="GddChartMax"
                        TargetValue="(double?)GddTargetValue"
                        ShowGrid="true"
                        RotateXLabels="true"
                        XPointCount="GddTotalPoints"
                        XLabels="GddXLabels"
                        YLabels="GddYLabels"
                        PointLabels="GddPointLabels" />

                    @if (GddProjectedData.Count > 1)
                    {
                        <div class="chart-stack__projection">
                            <SimpleLineChart
                                Data="GddProjectedData"
                                Height="300"
                                AccentClass="green"
                                Dashed="true"
                                Fill="false"
                                MinValue="0"
                                MaxValue="GddChartMax"
                                XPointCount="GddTotalPoints"
                                XOffset="GddHistoryCountMinusOne"
                                HideLabels="true" />
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted p-3">Sin lecturas de temperatura usables registradas para este lote: el GDD observado queda sin dato (no se asume 0).</p>
                }
            </div>
        </section>

        @if (forecast.HarvestWindow is { } window)
        {
            <section class="panel">
                <div class="panel__header">
                    <div>
                        <h3>Regla híbrida de cosecha</h3>
                        <p>@(window.IsBabyLeaf ? $"Baby Leaf: ventana GDD {window.WindowMin}–{window.WindowMax} + % de aptas" : $"Convencional: ventana GDD {window.WindowMin}–{window.WindowMax} + criterio de tamaño/madurez")</p>
                    </div>
                    <div class="chip-row">
                        @if (window.IsReady == true)
                        {
                            <span class="tag" style="background:#d1fae5;color:#065f46;">✅ Listo para cosechar</span>
                        }
                        else if (window.IsReady == false)
                        {
                            <span class="tag" style="background:#fee2e2;color:#991b1b;">⏳ Aún no listo</span>
                        }
                        else
                        {
                            <span class="tag" style="background:#fef3c7;color:#92400e;">⏸ Decisión pendiente</span>
                        }
                    </div>
                </div>

                <div class="row g-2 small">
                    <div class="col-md-2"><strong>GDD en ventana:</strong> @(window.GddInWindow ? "Sí" : "No")</div>
                    <div class="col-md-2"><strong>Plantas activas:</strong> @window.TotalActivePlants</div>
                    <div class="col-md-2"><strong>Aptas Baby Leaf:</strong> @window.AptaCount</div>
                    <div class="col-md-2"><strong>% apto:</strong> @window.AptaPercent.ToString("0.#")%</div>
                    <div class="col-md-2"><strong>Umbral:</strong> @(window.RequiredPercent is { } req ? req.ToString("0.#") + "%" : "sin definir")</div>
                    <div class="col-md-2">
                        <strong>Entrada a ventana:</strong>
                        @(window.WindowEntryDate?.ToString("dd/MM/yyyy") ?? "—")
                    </div>
                </div>

                @foreach (var w in window.Warnings)
                {
                    <div class="alert alert-warning py-1 px-2 small mb-1 mt-2">⚠ @w</div>
                }
            </section>
        }

        <section class="panel mt-3">
            <div class="panel__header">
                <div>
                    <h3>Estado del lote por planta</h3>
                    <p>Mapa según la grilla configurada del lote (no es una dimensión fija) y detalle de la planta seleccionada.</p>
                </div>
            </div>

            @if (lotState is null)
            {
                <p class="text-muted small">Sin datos de plantas para este lote (no hay grilla configurada o no hay plantas registradas).</p>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-3">
                        <LotSummaryCard State="lotState" />
                        <div class="mt-2">
                            <h6 class="small text-uppercase text-muted">Conteos por estado (activas)</h6>
                            <LotCountsSummary Counts="lotState.CommercialCounts" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <LotMap Rows="lotState.GridRows ?? 0"
                                Columns="lotState.GridColumns ?? 0"
                                Cells="lotState.Cells"
                                SelectedPosition="selectedPosition"
                                OnCellSelected="SelectCell" />
                        <div class="mt-2">
                            <LotLegend Counts="lotState.CommercialCounts"
                                       EmptyPositions="lotState.EmptyPositions"
                                       DiscardedPlants="lotState.DiscardedPlants" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <PlantDetailCard Detail="plantDetail" />
                    </div>
                </div>
            }
        </section>
    }
}

@code {
    private List<LotSummary>? lots;
    private List<CropType> cropTypes = [];
    private ForecastResult? forecast;
    private LotStateDto? lotState;
    private PlantDetailDto? plantDetail;
    private (int Row, int Column)? selectedPosition;
    private string? error;
    private string? lotError;
    private int selectedLotId;
    private bool weatherFetchEnabled;
    private bool weatherDailyLimitDisabled;
    private bool showNewLotForm;
    private bool creatingLot;
    private DateOnly? simDate;
    private DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);
    private int newLotCropTypeId;
    private DateOnly newLotSowingDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private decimal newLotAreaM2 = 4.5m;
    private int HarvestAlertDays = 3;

    private IReadOnlyList<double> GddCumulativeData
    {
        get
        {
            var cum = new List<double>();
            double acc = 0;
            foreach (var p in forecast?.GddHistory ?? [])
            {
                acc += (double)p.Gdd;
                cum.Add(Math.Round(acc, 1));
            }
            return cum;
        }
    }

    private IReadOnlyList<double> GddProjectedData
    {
        get
        {
            // Proyección futura acumulada arrancando desde el último valor del historial
            // (primer punto duplicado → la punteada se conecta exactamente con la sólida).
            if (forecast is null || forecast.FutureProjection.Count == 0) return [];
            var hist = GddCumulativeData;
            double acc = hist.Count > 0 ? hist[^1] : 0;
            var proj = new List<double> { acc };
            foreach (var p in forecast.FutureProjection)
            {
                acc += (double)p.Gdd;
                proj.Add(Math.Round(acc, 1));
            }
            return proj;
        }
    }

    // Dominio X compartido: historial + proyección (ambos charts usan el mismo total).
    private int GddTotalPoints =>
        (forecast?.GddHistory.Count ?? 0) + (forecast?.FutureProjection.Count ?? 0);

    private int GddHistoryCountMinusOne => Math.Max(0, (forecast?.GddHistory.Count ?? 1) - 1);

    private double GddChartMax
    {
        get
        {
            var max = GddCumulativeData.Count > 0 ? GddCumulativeData.Max() : 0d;
            if (GddProjectedData.Count > 0) max = Math.Max(max, GddProjectedData.Max());
            return Math.Max(max, GddTargetValue);
        }
    }

    private double GddTargetValue => forecast is not null ? (double)forecast.GddTarget : 0;

    private IReadOnlyList<string>? GddYLabels =>
        GddCumulativeData.Count > 0
            ? [GddChartMax.ToString("0.#"), (GddChartMax / 2).ToString("0.#"), "0"]
            : null;

    private IReadOnlyList<string>? GddXLabels
    {
        get
        {
            var labels = new List<string>();
            foreach (var p in forecast?.GddHistory ?? [])
                labels.Add(p.Date.ToString("dd/MM"));
            foreach (var p in forecast?.FutureProjection ?? [])
                labels.Add(p.Date.ToString("dd/MM"));
            return labels.Count > 0 ? labels : null;
        }
    }

    private IReadOnlyList<string>? GddPointLabels
    {
        get
        {
            var history = forecast?.GddHistory ?? [];
            if (history.Count == 0) return null;

            var labels = new List<string>();
            double acc = 0;
            foreach (var p in history)
            {
                acc += (double)p.Gdd;
                labels.Add($"{p.Date:dd/MM/yyyy} — {acc:0.#} °Cd acumulados ({SourceLabel(p.Source)})");
            }
            return labels;
        }
    }

    private static string SourceLabel(GddPointSource source) => source switch
    {
        GddPointSource.Observed => "sensor",
        GddPointSource.Forecast => "pronóstico",
        _ => "fallback"
    };

    private static string SourceKindLabel(ForecastSourceKind kind) => kind switch
    {
        ForecastSourceKind.Observed => "Origen: sensor (observado)",
        ForecastSourceKind.Forecast => "Origen: sensor + pronóstico",
        ForecastSourceKind.Fallback => "Origen: sensor + fallback (hay días sin dato)",
        _ => "Origen: datos mock/demo (sintéticos)"
    };

    protected override async Task OnInitializedAsync()
    {
        weatherFetchEnabled = await SettingsService.GetBoolAsync(SettingsService.WeatherFetchEnabledKey);
        weatherDailyLimitDisabled = await SettingsService.GetBoolAsync(SettingsService.WeatherDailyLimitDisabledKey);
        HarvestAlertDays = await SettingsService.GetIntAsync("HarvestAlertDays", 3);
        await LoadLots();
    }

    private async Task OnWeatherLimitToggleChanged(ChangeEventArgs e)
    {
        weatherDailyLimitDisabled = e.Value is bool value && value;
        await SettingsService.SetBoolAsync(SettingsService.WeatherDailyLimitDisabledKey, weatherDailyLimitDisabled);
    }

    private async Task ResetSimDate()
    {
        simDate = null;
        await LoadForecast();
    }

    private async Task CreateLot()
    {
        creatingLot = true;
        lotError = null;
        try
        {
            if (newLotAreaM2 <= 0)
            {
                lotError = "El área plantada debe ser positiva.";
                return;
            }

            await using var context = await DbFactory.CreateDbContextAsync();
            var activeStatus = await context.LotStatuses.FirstOrDefaultAsync(s => s.Name == "ACTIVO");
            var greenhouseCount = await context.Greenhouses.CountAsync();
            var greenhouse = greenhouseCount == 1
                ? await context.Greenhouses.FirstAsync()
                : null;

            if (greenhouse is null)
            {
                lotError = greenhouseCount == 0
                    ? "No hay invernaderos registrados."
                    : "Hay varios invernaderos: la creación desde la UI aún no permite elegir; usá la API con greenhouseId.";
                return;
            }

            context.Lots.Add(new Lot
            {
                GreenhouseId = greenhouse.Id,
                CropTypeId = newLotCropTypeId,
                StatusId = activeStatus?.Id ?? 1,
                SowingDate = newLotSowingDate,
                PlantedAreaM2 = newLotAreaM2,
                CreatedAt = DateTime.UtcNow
            });
            await context.SaveChangesAsync();

            showNewLotForm = false;
            await LoadLots();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al crear lote desde la UI");
            lotError = "No se pudo crear el lote. Revisá los datos e intentá de nuevo.";
        }
        finally
        {
            creatingLot = false;
        }
    }

    private async Task OnWeatherToggleChanged(ChangeEventArgs e)
    {
        weatherFetchEnabled = e.Value is bool value && value;
        await SettingsService.SetBoolAsync(SettingsService.WeatherFetchEnabledKey, weatherFetchEnabled);
    }

    private async Task LoadLots()
    {
        try
        {
            lots = (await ForecastService.GetLotsAsync(includeClosed: false)).ToList();

            await using var context = await DbFactory.CreateDbContextAsync();
            cropTypes = await context.CropTypes.OrderBy(c => c.Name).ToListAsync();
            if (newLotCropTypeId == 0 && cropTypes.Count > 0)
                newLotCropTypeId = cropTypes[0].Id;

            error = null;

            if (lots.Count > 0)
            {
                selectedLotId = lots[0].Id;
                await LoadForecast();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la lista de lotes");
            error = "No se pudo cargar la lista de lotes. Revisá la conexión con la base.";
            lots = [];
        }
    }

    private async Task LoadForecast()
    {
        if (selectedLotId == 0) return;

        try
        {
            forecast = await ForecastService.GetForecastAsync(selectedLotId, simDate);
            plantDetail = null;
            selectedPosition = null;

            // Estado por planta con la MISMA fecha simulada (mismo GddService → mismos valores).
            lotState = simDate is null
                ? await LotAggregate.GetLotStateAsync(selectedLotId)
                : await LotAggregate.GetLotStateAsync(selectedLotId, simDate);

            error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar el pronóstico del lote {LotId}", selectedLotId);
            error = "No se pudo cargar el pronóstico. Revisá la disponibilidad de sensores, clima y datos del lote.";
        }
    }

    private async Task SelectCell(PlantCellDto cell)
    {
        selectedPosition = (cell.Row, cell.Column);

        if (cell.PlantId is { } plantId)
        {
            plantDetail = await LotAggregate.GetPlantDetailAsync(
                plantId,
                forecast?.GddAccumulated ?? 0m,
                lotState?.CurrentPh,
                lotState?.CurrentEc);
        }
        else
        {
            plantDetail = new PlantDetailDto(
                0, cell.Row, cell.Column, null, null, default,
                null, null, null, forecast?.GddAccumulated ?? 0m,
                lotState?.CurrentPh, lotState?.CurrentEc, null, null, null, null, null,
                false, null, null, [], ["Posición vacía: no hay planta en esta posición."]);
        }
    }
}
@page "/"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HydroPilotDbContext> DbFactory

<PageTitle>Home</PageTitle>

<div class="dashboard-grid">
	<section class="dashboard-kpis">
		@foreach (var item in Kpis)
		{
			<article class="kpi-card">
				<div class="kpi-card__header">
					<div>
						<p>@item.Label</p>
						<h2>@item.Value <span>@item.Unit</span></h2>
					</div>
					<div class="kpi-card__icon">@item.Icon</div>
				</div>
				<div class="kpi-card__delta">@item.Delta</div>
			</article>
		}
	</section>

	<section class="dashboard-main">
		<article class="panel panel--chart">
			<div class="panel__header">
				<div>
					<h3>Lecturas de sensores</h3>
					<p>Valores del invernadero</p>
				</div>
				<div class="panel__toggles d-flex gap-2">
					<select class="form-select form-select-sm" style="width: auto;" @bind="selectedTimeRange" @bind:after="LoadReadings">
						<option value="1m">Último minuto</option>
						<option value="1h">Última hora</option>
						<option value="24h" selected>Últimas 24 horas</option>
						<option value="7d">Última semana</option>
						<option value="30d">Último mes</option>
						<option value="all">Todo</option>
					</select>
				</div>
			</div>

			@if (latestReadings is not null && latestReadings.Count > 0)
			{
				<table class="table table-sm table-striped m-3">
					<thead>
						<tr>
							<th>Sensor</th>
							<th>Tipo</th>
							<th>Valor</th>
							<th>Fecha</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var r in latestReadings)
						{
							<tr>
								<td>@r.Sensor?.Name</td>
								<td>@(r.Sensor?.SensorType?.Name ?? "-")</td>
								<td>@r.Value @(r.Sensor?.MeasurementUnit?.Symbol ?? "")</td>
								<td>@r.Timestamp.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
							</tr>
						}
					</tbody>
				</table>
			}
			else
			{
				<div class="p-4 text-muted">
					<p>Sin lecturas</p>
				</div>
			}
		</article>

		<aside class="panel panel--resources">
			<h3>Estado del sistema</h3>

			<div class="resource-list">
				@if (nodeStatus is not null)
				{
					<div class="resource-row">
						<div class="resource-row__meta">
							<span>Nodo IoT</span>
							<strong>@nodeStatus.Identifier</strong>
						</div>
						<div class="resource-row__bar">
							<span style="width: 100%" class="@(nodeStatus.Status == "ACTIVO" ? "tone-green" : "tone-amber")"></span>
						</div>
					</div>
					<div class="resource-row">
						<div class="resource-row__meta">
							<span>Estado</span>
							<strong>@nodeStatus.Status</strong>
						</div>
					</div>
					<div class="resource-row">
						<div class="resource-row__meta">
							<span>Última conexión</span>
							<strong>@(nodeStatus.LastConnection?.ToLocalTime().ToString("dd/MM HH:mm") ?? "Nunca")</strong>
						</div>
					</div>
				}
				else
				{
					<p class="text-muted">Sin datos de nodo IoT.</p>
				}
			</div>

			<div class="panel__callout">
				<h4>Recomendación</h4>
				<p>El módulo de simulación sugiere aumentar el flujo de agua un 5% durante las horas pico de luz.</p>
				<a href="/optimization">Aplicar cambio</a>
			</div>
		</aside>
	</section>

	<section class="dashboard-secondary">
		<article class="panel">
			<div class="panel__header panel__header--compact">
				<h3>Anomalías recientes</h3>
				<a href="/anomalies">Ver todas →</a>
			</div>

			<div class="anomaly-list">
				@foreach (var anomaly in Anomalies)
				{
					<div class="anomaly-row @anomaly.State">
						<span class="anomaly-row__dot"></span>
						<div>
							<strong>@anomaly.Title</strong>
							<p>@anomaly.Detail</p>
						</div>
						@if (!anomaly.Resolved)
						{
							<a href="/anomalies">Revisar</a>
						}
					</div>
				}
			</div>
		</article>

		<article class="panel">
			<div class="panel__header panel__header--compact">
				<h3>Accesos rápidos</h3>
			</div>

			<div class="quick-grid">
				@foreach (var shortcut in Shortcuts)
				{
					<a href="@shortcut.Href" class="quick-card">
						<strong>@shortcut.Title</strong>
						<span>@shortcut.Description</span>
					</a>
				}
			</div>
		</article>
    </section>
</div>

@code {
	private List<DashboardKpi> Kpis { get; set; } = [];
	private List<SensorReading>? latestReadings;
	private IotNode? nodeStatus;
	private string selectedTimeRange = "24h";

	private static readonly AnomalyItem[] Anomalies =
	[
		new("Caída de presión Bomba B2", "hace 12 min", false, "high"),
		new("Pico térmico sensor 04", "hace 4 h", true, "med"),
		new("Drift de calibración pH", "hace 1 d", true, "low"),
	];

	private static readonly ShortcutItem[] Shortcuts =
	[
		new("Forecasting", "Predicción de rendimiento", "/forecasting"),
		new("Simulación", "Escenarios what-if", "/simulation"),
		new("Optimización", "Recomendaciones IA", "/optimization"),
		new("Anomalías", "Timeline de eventos", "/anomalies"),
	];

	protected override async Task OnInitializedAsync()
	{
		await LoadKpis();
		await LoadNodeStatus();
		await LoadReadings();
	}

	private async Task LoadKpis()
	{
		try
		{
			await using var context = await DbFactory.CreateDbContextAsync();

			var sensorTypes = await context.SensorTypes.ToListAsync();
			Kpis = [];

			foreach (var type in sensorTypes)
			{
				var latest = await context.SensorReadings
					.Include(r => r.Sensor!).ThenInclude(s => s.MeasurementUnit)
					.Where(r => r.Sensor!.SensorTypeId == type.Id)
					.OrderByDescending(r => r.Timestamp)
					.FirstOrDefaultAsync();

				if (latest is not null)
				{
					var (label, icon) = type.Name switch
					{
						"pH" => ("pH del agua", "💧"),
						"CE" => ("Conductividad (EC)", "◌"),
						"Temperatura" => ("Temp. nutrientes", "🌡"),
						"Humedad" => ("Humedad", "🍃"),
						_ => (type.Name, "📊")
					};

					var unit = latest.Sensor?.MeasurementUnit?.Symbol ?? "";
					Kpis.Add(new DashboardKpi(label, $"{latest.Value:F1}", unit, "Activo", icon));
				}
				else
				{
					var (label, icon) = type.Name switch
					{
						"pH" => ("pH del agua", "💧"),
						"CE" => ("Conductividad (EC)", "◌"),
						"Temperatura" => ("Temp. nutrientes", "🌡"),
						"Humedad" => ("Humedad", "🍃"),
						_ => (type.Name, "📊")
					};

					Kpis.Add(new DashboardKpi(label, "—", "", "Sin datos", icon));
				}
			}
		}
		catch
		{
			Kpis = [
				new("pH del agua", "—", "", "Error", "💧"),
				new("Conductividad (EC)", "—", "", "Error", "◌"),
				new("Temp. nutrientes", "—", "", "Error", "🌡"),
				new("Humedad", "—", "", "Error", "🍃"),
			];
		}
	}

	private async Task LoadNodeStatus()
	{
		try
		{
			await using var context = await DbFactory.CreateDbContextAsync();

			nodeStatus = await context.IotNodes
				.OrderByDescending(n => n.LastConnection)
				.FirstOrDefaultAsync();
		}
		catch
		{
			nodeStatus = null;
		}
	}

	private async Task LoadReadings()
	{
		try
		{
			await using var context = await DbFactory.CreateDbContextAsync();

			var query = context.SensorReadings
				.Include(r => r.Sensor!).ThenInclude(s => s.SensorType)
				.Include(r => r.Sensor!).ThenInclude(s => s.MeasurementUnit)
				.AsQueryable();

			var since = GetTimeRangeCutoff();
			if (since.HasValue)
				query = query.Where(r => r.Timestamp >= since.Value);

			latestReadings = await query
				.OrderByDescending(r => r.Timestamp)
				.Take(200)
				.ToListAsync();
		}
		catch
		{
			latestReadings = [];
		}
	}

	private DateTime? GetTimeRangeCutoff()
	{
		var now = DateTime.UtcNow;
		return selectedTimeRange switch
		{
			"1m" => now.AddMinutes(-1),
			"1h" => now.AddHours(-1),
			"24h" => now.AddHours(-24),
			"7d" => now.AddDays(-7),
			"30d" => now.AddDays(-30),
			_ => null
		};
	}

	private sealed record DashboardKpi(string Label, string Value, string Unit, string Delta, string Icon);
	private sealed record AnomalyItem(string Title, string Detail, bool Resolved, string State);
	private sealed record ShortcutItem(string Title, string Description, string Href);
}

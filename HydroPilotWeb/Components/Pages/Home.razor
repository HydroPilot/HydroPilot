@page "/"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using System.Security.Claims
@using HydroPilotWeb.Components.Dashboard
@using HydroPilotWeb.Components.Lotes
@using HydroPilotWeb.Models.Notifications
@using HydroPilotWeb.Services.Dashboard
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Sensors
@inject GreenhouseDashboardService Dashboard
@inject SensorService Sensors
@inject AuthenticationStateProvider AuthState

<PageTitle>Invernadero - HydroPilot</PageTitle>

@* Dashboard general del invernadero: todos los lotes activos con la lógica de Lotes (rendimiento,
   plantas, cosechas), más alertas, chequeos de sensores y últimos accedidos. Izquierda: los 4 cuadros, los gráficos y
   Próximas cosechas a todo el ancho; derecha: Próximos chequeos (secundario) y Últimos accedidos. Las listas tienen su propio scroll. Lógica: notas/ux/logica-vista-invernadero.md *@
@if (error is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <span>@error</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Reintentar</button>
    </div>
}

@if (data is null)
{
    @if (error is null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border" role="status"><span class="visually-hidden">Cargando…</span></div>
        </div>
    }
}
else
{
    <div class="gh-dash">
        <div class="gh-dash__main">
            <section class="lot-card gh-kpi">
                <span class="gh-kpi__value gh-kpi__value--accent">@data.ActiveLots</span>
                <span class="gh-kpi__label">@(data.ActiveLots == 1 ? "Lote activo" : "Lotes activos")</span>
            </section>
            @Kpi(data.CurrentRevenue, "Rendimiento actual", "Lo cosechado y lo listo para cosechar en los lotes activos")
            @Kpi(data.ExpectedRevenue, "Rendimiento esperado", "Lo que se espera del ciclo completo de los lotes activos", "gh-kpi--good")

            @* Alertas: solo cuántas hay abiertas (en rojo si hay alguna); al tocarlo, la vista Alertas con las abiertas. *@
            <a class="lot-card gh-kpi gh-alerts @(data.OpenAlerts > 0 ? "gh-alerts--on" : null)"
               href="@(data.OpenAlerts > 0 ? "alertas?estado=abiertas" : "alertas")"
               title="@(data.OpenAlerts > 0 ? "Ver las alertas abiertas" : "Ver el historial de alertas")">
                <span class="gh-alerts__row">
                    <svg class="gh-alerts__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3.5 2.5 20h19Z" />
                        <path d="M12 10v4.5" />
                        <path d="M12 17.2v.3" />
                    </svg>
                    <span class="gh-kpi__value">@data.OpenAlerts</span>
                </span>
                <span class="gh-kpi__label">@(data.OpenAlerts switch { 0 => "Sin alertas abiertas", 1 => "Alerta abierta", _ => "Alertas abiertas" })</span>
            </a>

            <section class="lot-card gh-chart gh-chart--bars" aria-labelledby="gh-stages-title">
                <h3 class="gh-card__title" id="gh-stages-title">Plantas por estado</h3>
                <DashboardStageChart Stages="data.Stages" />
                @if (data.Stages.Any(s => s.Harvested > 0))
                {
                    <div class="lot-legend">
                        <span class="lot-legend__item">
                            <span class="lot-legend__dot lot-seg--striped" style="background-color: #8a94a0;"></span>
                            Cosechadas
                        </span>
                    </div>
                }
            </section>

            <section class="lot-card gh-chart gh-chart--donut" aria-labelledby="gh-bl-title">
                <h3 class="gh-card__title" id="gh-bl-title">Baby Leaf esperado</h3>
                <DashboardBabyLeafDonut ExpectedPlants="data.ExpectedBabyLeafPlants" TotalPlants="data.TotalPlants" />
            </section>

            <section class="lot-card gh-list-card gh-list-card--half gh-list-card--wide" aria-labelledby="gh-harvests-title">
                <h3 class="gh-card__title" id="gh-harvests-title">Próximas cosechas</h3>
                @if (data.Harvests.Count == 0)
                {
                    <p class="gh-empty">Sin cosechas estimadas.</p>
                }
                else
                {
                    <ul class="gh-list">
                        @foreach (var harvest in data.Harvests)
                        {
                            <li>
                                <a class="gh-row" href="@harvest.Link">
                                    <span class="gh-date @(harvest.CutNow ? "gh-date--now" : null)">
                                        <strong>@(harvest.Approximate ? "≈" : null)@harvest.Date.Day</strong>
                                        <span>@Month(harvest.Date)</span>
                                    </span>
                                    <span class="gh-row__main">
                                        <span class="gh-row__title">@harvest.LotName</span>
                                        <span class="gh-row__sub">
                                            <span class="lot-legend__dot" style="background: @DestinationColor(harvest.Destination);"></span>
                                            @(harvest.Destination == HarvestDestination.BabyLeaf ? "Baby Leaf" : "Adulta")
                                        </span>
                                    </span>
                                    <span class="gh-row__when @(harvest.CutNow ? "gh-row__when--now" : null)">
                                        @(harvest.CutNow ? "Cortar ahora" : DaysUntil(harvest.Date))
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <div class="gh-dash__side">
            <section class="lot-card gh-list-card" aria-labelledby="gh-checks-title">
                <h3 class="gh-card__title" id="gh-checks-title">Próximos chequeos de sensores</h3>
                @if (!data.HasSensorIntervals)
                {
                    <p class="gh-empty">Sin chequeos programados. <a class="lot-link" href="settings/parametros">Definir en Parámetros</a></p>
                }
                else if (data.SensorChecks.Count == 0)
                {
                    <p class="gh-empty">Nada vence en los próximos @GreenhouseDashboardRules.CheckWindowDays días. <a class="lot-link" href="settings/sensores">Ver sensores</a></p>
                }
                else
                {
                    <ul class="gh-list">
                        @foreach (var check in data.SensorChecks)
                        {
                            var overdue = check.DueDate <= data.Today;
                            <li class="gh-row gh-row--static" title="@CheckTitle(check)">
                                <span class="gh-row__main">
                                    <span class="gh-row__title">@check.SensorType · @check.Place</span>
                                    <span class="gh-row__sub @(overdue ? "gh-row__sub--danger" : null)">@CheckText(check)</span>
                                </span>
                                @if (canCalibrate)
                                {
                                    <CalibrationCheck Checked="@(check.LastCalibration == data.Today)" Busy="@(calibrating == check.SensorId)"
                                                      Disabled="@(calibrating is not null)" OnCheck="() => RegisterCalibrationAsync(check.SensorId)" />
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="lot-card gh-list-card" aria-labelledby="gh-visits-title">
                <h3 class="gh-card__title" id="gh-visits-title">Últimos accedidos</h3>
                @if (data.RecentVisits.Count == 0)
                {
                    <p class="gh-empty">Todavía no abriste ningún lote.</p>
                }
                else
                {
                    <ul class="gh-list">
                        @foreach (var visit in data.RecentVisits)
                        {
                            <li>
                                @* Ícono de la vista (el del menú) a la izquierda y su nombre en color debajo del lote. *@
                                <a class="gh-row" href="@visit.Link">
                                    <span class="gh-view gh-view--@VisitRoute(visit)" aria-hidden="true">
                                        <NavIcon Name="@VisitRoute(visit)" Class="gh-view__icon" />
                                    </span>
                                    <span class="gh-row__main">
                                        <span class="gh-row__title">@visit.Title</span>
                                        <span class="gh-row__sub gh-view__name gh-view__name--@VisitRoute(visit)">@visit.View</span>
                                    </span>
                                    <span class="gh-row__when">@When(visit.VisitedAtLocal)</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    private GreenhouseDashboard? data;
    private string? error;
    private ClaimsPrincipal user = new();
    private bool canCalibrate;
    private int? calibrating;

    private static readonly string BabyLeafColor = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta).Background;
    private static readonly string ConventionalColor = CommercialStagePalette.ForStage(CommercialStageNames.CosechaConvencional).Background;

    protected override async Task OnInitializedAsync()
    {
        user = (await AuthState.GetAuthenticationStateAsync()).User;
        canCalibrate = SensorService.CanRegisterCalibration(user);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            data = await Dashboard.GetAsync(user);
            error = null;
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar el dashboard: {ex.Message}";
        }
    }

    private async Task RegisterCalibrationAsync(int sensorId)
    {
        calibrating = sensorId;
        try
        {
            if (!await Sensors.RegisterCalibrationAsync(sensorId, user))
                error = "No se pudo registrar el chequeo del sensor.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = $"No se pudo registrar el chequeo del sensor: {ex.Message}";
        }
        finally
        {
            calibrating = null;
        }
    }

    /// <summary>Card de $ redondeado ("$123k"); sin precios o pesos para algún lote, "—" con el link a Parámetros.</summary>
    private RenderFragment Kpi(DashboardMoney money, string label, string hint, string? css = null) => __builder =>
    {
        <section class="lot-card gh-kpi @css" title="@(money.Amount is { } exact ? $"{hint}: {LotFormat.Money(exact, money.Currency)}" : hint)">
            <span class="gh-kpi__value">@(money.Amount is { } amount ? DashboardFormat.CompactMoney(amount, money.Currency) : "—")</span>
            <span class="gh-kpi__label">@label</span>
            @if (money.Amount is null)
            {
                <a class="lot-link gh-kpi__hint" href="settings/parametros">Faltan pesos o precios</a>
            }
        </section>
    };

    private string When(DateTime local) => LotFormat.When(local, data!.NowLocal);

    /// <summary>Ruta de la vista visitada (para su ícono del menú y su color): Lotes u Optimización.</summary>
    private static string VisitRoute(DashboardVisitItem visit) => visit.View == "Optimización" ? "optimization" : "lotes";

    private string DaysUntil(DateOnly date)
    {
        var days = date.DayNumber - data!.Today.DayNumber;
        return days switch
        {
            0 => "hoy",
            1 => "mañana",
            > 1 => $"en {days} días",
            -1 => "ayer",
            _ => $"hace {-days} días"
        };
    }

    private static string Month(DateOnly date) => date.ToString("MMM", LotFormat.Culture).TrimEnd('.');

    private static string DestinationColor(HarvestDestination destination) =>
        destination == HarvestDestination.BabyLeaf ? BabyLeafColor : ConventionalColor;

    private string CheckText(DashboardSensorCheck check)
    {
        if (check.LastCalibration is null)
            return "Sin calibración registrada";
        var days = check.DueDate.DayNumber - data!.Today.DayNumber;
        return days switch
        {
            < 0 => $"Vencido hace {LotFormat.Days(-days)}",
            0 => "Vence hoy",
            _ => $"{LotFormat.Short(check.DueDate)} · en {LotFormat.Days(days)}"
        };
    }

    private static string CheckTitle(DashboardSensorCheck check) =>
        (check.LastCalibration is { } last ? $"Último chequeo: {LotFormat.Short(last)}" : "Sin calibración registrada") +
        $" · cada {LotFormat.Days(check.IntervalDays)}";

}

@page "/lotes"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using System.Security.Claims
@using HydroPilotWeb.Components.Lotes
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Dashboard
@using HydroPilotWeb.Components.Dashboard
@inject LotOverviewService LotOverview
@inject RecentVisitService RecentVisits
@inject LotCreationService LotCreation
@inject LotAggregateService LotAggregate
@inject PlantLifecycleService PlantLifecycle
@inject PlantTransplantService PlantTransplant
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Lotes</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
@if (notice is not null)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center py-2">
        <span>@notice</span>
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => notice = null"></button>
    </div>
}

@if (lots is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (lots.Count == 0)
{
    <div class="lot-view">
        <div class="alert alert-info mb-0 d-flex align-items-center gap-3 flex-wrap">
            <span>
                No hay lotes registrados.
                @(canCreateLot ? null : "Pedile a un Administrador, Productor u Operador que cree uno.")
            </span>
            @if (canCreateLot)
            {
                <button type="button" class="btn btn-success" @onclick="OpenCreateLotAsync">+ Nuevo lote</button>
            }
        </div>
    </div>
}
else
{
    <div class="lot-view">
        <div class="lot-toolbar">
            <label class="visually-hidden" for="lot-select">Lote</label>
            <select id="lot-select" class="form-select lot-toolbar__select" @bind="selectedLotId" @bind:after="OnLotChangedAsync">
                @foreach (var lot in lots)
                {
                    <option value="@lot.Id">@lot.Name · @StatusLabel(lot.StatusName)</option>
                }
            </select>
            @if (canCreateLot)
            {
                <button type="button" class="btn lot-toolbar__new" @onclick="OpenCreateLotAsync"
                        disabled="@creatingLot">+ Nuevo lote</button>
            }

            @* Sin chip de estado, área/siembra ni pH/CE: el estado va en el selector y la solución en Optimización. *@
            @if (overview is { IsClosed: false } current)
            {
                @if (current.DataAlerts.Count > 0)
                {
                    @* Mismo aviso que la sección "Detalles y calidad de los datos" (en rojo): al tocarlo la abre. *@
                    <button type="button" class="lot-chip lot-chip--danger lot-chip--strong" @onclick="ShowDataDetailsAsync"
                            title="@($"{string.Join(" · ", current.DataAlerts.Select(a => a.Title))}. Ver detalles y calidad de los datos.")">
                        ⚠ @(current.NoticeCount == 1 ? "1 aviso" : $"{current.NoticeCount} avisos")
                    </button>
                }
            }

            @if (loading && overview is not null)
            {
                @* Al cambiar de lote (o de fecha) los datos tardan: se avisa en vez de dejar la pantalla anterior quieta. *@
                <span class="lot-loading" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando…
                </span>
            }

            @* Comentarios del lote: a la derecha de todo (margin-left: auto). *@
            @if (selectedLotId is { } commentsLotId)
            {
                <LotComments LotId="commentsLotId" LotName="@(lots.FirstOrDefault(l => l.Id == commentsLotId)?.Name ?? "Lote")" User="user" />
            }

            @* Cómo funciona la vista, en síntesis (a la derecha de todo). *@
            <span class="lot-page-info">
                <InfoTip Title="Cómo funciona Lotes" Wide="true">
                    <span class="hp-info__text">
                        Un <b>lote</b> es una siembra en un circuito denso: cada hueco es una planta. La vista lo sigue de la
                        siembra a la cosecha y dice qué cortar, cuándo y cuánto va a dar.
                    </span>
                    <span class="hp-info__list">
                        <span><b>Calor acumulado (GDD):</b> de acá sale casi todo (fase, ventanas, fechas, etapa). Cada día suma
                            (mín(Tmáx, 30) + Tmín) ÷ 2 − 4,5 °C, con el sensor de temperatura del invernadero; para adelante usa
                            el pronóstico de 7 días corregido a la temperatura de adentro (≈ = estimado).</span>
                        <span><b>Estado de cada planta:</b> lo decide el flujo diario con el GDD del lote y el <b>score Baby
                            Leaf</b> de su última evaluación (tamaño, color, crecimiento): apta con 80 o más, candidata con 60 o
                            más. Una anomalía abierta de pH o CE pone en riesgo a las activas.</span>
                        <span><b>Datos del lote:</b> sus plantas y evaluaciones, sus circuitos (denso y de Adultas), sus metas,
                            sus lecturas de temperatura y sus anomalías.</span>
                        <span><b>Datos históricos:</b> los lotes cerrados del mismo cultivo e invernadero (de la misma época del
                            año si hay al menos 3) para el óptimo de corte Baby Leaf y el rendimiento esperado.</span>
                        <span><b>Qué se hace acá:</b> cosechar (como Baby Leaf o adulta), descartar y trasplantar a Adultas desde
                            <b>Seleccionar</b> en el mapa; editar las metas; comentar el lote (💬).</span>
                        <span><b>Desde Ajustes &gt; Parámetros:</b> los pesos por planta y los precios por kg, y del trasplante
                            el GDD de decisión, los días de estrés, el tamaño máximo Baby Leaf, las separaciones y los
                            días de limpieza del denso. La ventana Baby Leaf (250–450 GDD) y los scores son del cultivo.</span>
                    </span>
                </InfoTip>
            </span>

            @* "Ver al" (fecha simulada): oculto por ahora, quizás vuelva. Mezclaba el GDD de esa fecha con el
               estado de hoy de las plantas y confundía. La lógica sigue (simDate); para volver a mostrarlo,
               descomentar este bloque.
            <div class="lot-toolbar__date">
                <label for="lot-asof">Ver al</label>
                <input id="lot-asof" type="date" class="form-control form-control-sm" @bind="simDate" @bind:after="LoadAsync" />
                @if (simDate is not null)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetSimDateAsync">Hoy</button>
                }
            </div>
            *@
        </div>

        @if (overview is null)
        {
            @if (loading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
                </div>
            }
        }
        else
        {
            @if (simDate is { } viewDate)
            {
                <div class="alert alert-info py-1 px-2 small mb-0">
                    Vista al @LotFormat.Day(viewDate): se recalcula con los datos hasta esa fecha. El estado de las plantas es el actual.
                </div>
            }

            @* Mapa a la izquierda (60%) y las cards de situación apiladas a la derecha (40%).
               En pantallas angostas se apila todo, con las cards primero. *@
            <div class="lot-layout @(loading ? "lot-layout--loading" : null)" aria-busy="@(loading ? "true" : "false")">
                @* Columna izquierda: mapa y, debajo, los detalles técnicos (mismo ancho). *@
                <div class="lot-layout__main">
                    <section class="panel">
                        @* Título con el botón Seleccionar / Cancelar a la derecha; los filtros siempre en la línea de abajo. *@
                        <div class="lot-panel-head">
                            <span class="lot-head-title">
                                <h3 class="lot-panel-title">Mapa del lote</h3>
                                <InfoTip Title="Cómo leer el mapa" Start="true">
                                    <span class="hp-info__text">
                                        Cada cuadrado es un hueco del circuito con su planta, del color de su estado de hoy (lo
                                        actualiza el flujo diario):
                                    </span>
                                    <span class="hp-info__chips">
                                <span class="hp-info__pump"><span style="background: #2e9e4f;"></span>En desarrollo</span>
                                <span class="hp-info__pump"><span style="background: #2d7dd2;"></span>Baby Leaf</span>
                                <span class="hp-info__pump"><span style="background: #e8a33d;"></span>Candidata</span>
                                <span class="hp-info__pump"><span style="background: #8a4fd3;"></span>Adulta</span>
                                <span class="hp-info__pump"><span style="background: #d64545;"></span>Riesgo</span>
                                <span class="hp-info__pump"><span style="background: #8a94a0;"></span>Descartada</span>
                            </span>
                                    <span class="hp-info__list">
                                        <span>Un hueco con <b>AD punteado</b> es una planta que se trasplantó a Adultas; un
                                            <b>·</b> es un hueco sin planta. Debajo van los <b>circuitos de Adultas</b> con las
                                            trasplantadas del lote.</span>
                                        <span><b>Filtros:</b> resaltan las de un estado (con Seleccionar, "Seleccionar todas"
                                            toma solo esas).</span>
                                        <span><b>Tocar una planta:</b> su detalle, con el score Baby Leaf, la etapa, el
                                            crecimiento, la imagen y su historial.</span>
                                        <span><b>Seleccionar:</b> marcás plantas y las <b>cosechás</b> (Baby Leaf o adulta; viene
                                            elegido lo que corresponde por su estado), las <b>descartás</b> con un motivo o las
                                            <b>trasplantás</b> a Adultas (durante la ventana Baby Leaf, eligiendo los circuitos y
                                            su orden). No se puede deshacer.</span>
                                        <span>Cuando no quedan plantas activas, el lote se cierra solo (Cosechado o
                                            Descartado).</span>
                                    </span>
                                </InfoTip>
                            </span>
                            @if (!overview.IsClosed)
                            {
                                @if (!selecting)
                                {
                                    <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="StartSelecting" disabled="@operating">Seleccionar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="StopSelecting">Cancelar</button>
                                }
                            }
                        </div>
                        <div class="lot-map-filters">
                            @* Ojo: los parámetros string van con @ (sin @ Razor pasa el texto literal "highlightKey"). *@
                            <LotMapFilters Plants="overview.Plants" Selected="@highlightKey" OnSelected="OnFilterChanged" />
                        </div>
                        @if (!overview.IsClosed && selecting)
                        {
                            @* Elegir varias plantas para cosecharlas o descartarlas juntas. "Seleccionar todas" respeta el
                               filtro del mapa (con un filtro activo marca solo esas). *@
                            <div class="lot-select-bar">
                                <span class="lot-select-bar__count">@LotFormat.Count(picked.Count, "seleccionada", "seleccionadas")</span>
                                <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="SelectAll" disabled="@(Selectable().Count == 0)">@SelectAllLabel</button>
                                @if (picked.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="() => picked.Clear()">Limpiar</button>
                                }
                                <span class="lot-select-bar__actions">
                                    @if (transplantPlan is not null && canTransplant && HasDensePlants)
                                    {
                                        <button type="button" class="btn btn-sm lot-batch-btn lot-batch-btn--transplant" disabled="@(!CanTransplantPicked || operating)"
                                                title="@TransplantHint" @onclick="() => AskBatch(BatchAction.Transplant)">Trasplantar</button>
                                    }
                                    <button type="button" class="btn btn-sm lot-batch-btn lot-batch-btn--harvest"
                                            disabled="@(picked.Count == 0 || operating)" @onclick="() => AskBatch(BatchAction.Harvest)">Cosechar</button>
                                    <button type="button" class="btn btn-sm lot-batch-btn lot-batch-btn--discard" disabled="@(picked.Count == 0 || operating)"
                                            @onclick="() => AskBatch(BatchAction.Discard)">Descartar</button>
                                </span>
                            </div>
                        }
                        @* Con trasplantadas, el mapa de cada circuito: el denso donde se sembró y los de Adultas. *@
                        @if (overview.State.AdultMaps is { Count: > 0 })
                        {
                            <h4 class="lot-map-subtitle">@(overview.State.CircuitName ?? "Circuito") · denso</h4>
                        }
                        @* El detalle de la planta se abre como popover anclado a la celda (no reserva espacio fijo). *@
                        <div class="lot-map-stage @(DetailIn(DenseCircuitId) ? "lot-map-stage--open" : null)" style="@StageStyle(overview.State.GridColumns ?? 0)">
                            <LotMap Rows="overview.State.GridRows ?? 0"
                                    Columns="overview.State.GridColumns ?? 0"
                                    Cells="overview.State.Cells"
                                    SelectedPosition="PositionIn(DenseCircuitId)"
                                    HighlightKey="@highlightKey"
                                    SelectionMode="selecting"
                                    PickedPlantIds="picked"
                                    OnCellSelected="SelectCellAsync" />
                            @if (DetailIn(DenseCircuitId) && PopoverFor(overview.State.GridRows ?? 0, overview.State.GridColumns ?? 0) is { } popover)
                            {
                                @PopoverMarkup(popover)
                            }
                        </div>
                        @foreach (var map in overview.State.AdultMaps ?? [])
                        {
                            <h4 class="lot-map-subtitle">@map.Name · Adultas</h4>
                            <div class="lot-map-stage @(DetailIn(map.CircuitId) ? "lot-map-stage--open" : null)" style="@StageStyle(map.Columns)">
                                <LotMap Rows="map.Rows"
                                        Columns="map.Columns"
                                        Cells="map.Cells"
                                        SelectedPosition="PositionIn(map.CircuitId)"
                                        HighlightKey="@highlightKey"
                                        SelectionMode="selecting"
                                        PickedPlantIds="picked"
                                        OnCellSelected="SelectCellAsync" />
                                @if (DetailIn(map.CircuitId) && PopoverFor(map.Rows, map.Columns) is { } adultPopover)
                                {
                                    @PopoverMarkup(adultPopover)
                                }
                            </div>
                        }
                    </section>

                    <LotTechnicalDetails Overview="overview" />
                </div>

                <div class="lot-layout__side">
                    <LotWindowCard Overview="overview" />
                    @* Pesos y precios: parámetros del sistema, se cargan en Ajustes > Parámetros. *@
                    <LotYieldCard Overview="overview" CanEdit="canEditParameters" />
                    @* Las metas del lote juntas, bajo "Metas" con una bandera a cuadros. *@
                    <section class="lot-goals" aria-labelledby="lot-goals-title">
                        <h3 class="lot-goals__title" id="lot-goals-title">
                            <svg class="lot-goals__icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path class="lot-goals__pole" d="M5 21V3.5" />
                                <path class="lot-goals__flag" d="M5 4h14v9H5" />
                                <rect x="5" y="4" width="3.5" height="3" />
                                <rect x="12" y="4" width="3.5" height="3" />
                                <rect x="8.5" y="7" width="3.5" height="3" />
                                <rect x="15.5" y="7" width="3.5" height="3" />
                                <rect x="5" y="10" width="3.5" height="3" />
                                <rect x="12" y="10" width="3.5" height="3" />
                            </svg>
                            Metas
                            @* Un solo lápiz para las dos metas: abre el modal de metas del lote. *@
                            @if (canEdit)
                            {
                                <button type="button" class="lot-icon-btn lot-goals__edit" @onclick="OpenEditor"
                                        title="Editar metas del lote" aria-label="Editar metas del lote">✎</button>
                            }
                            <span class="lot-goals__info">
                                <InfoTip Title="Las metas del lote">
                                    <span class="hp-info__list">
                                        <span><b>Meta Baby Leaf:</b> qué % de las plantas del lote querés cosechar como Baby Leaf. En la
                                            barra, las <span class="hp-info__swatch" style="background: #2d7dd2;"></span><b>cosechadas como
                                            Baby Leaf</b> + las <b>Baby Leafs</b> de hoy son lo logrado; sumando las
                                            <span class="hp-info__swatch" style="background: #e8a33d;"></span><b>candidatas</b>, lo que se
                                            espera lograr.</span>
                                        <span><b>Meta Plantas activas:</b> qué % querés que llegue al final sin descartarse (las
                                            cosechadas cuentan). La barra va <b class="hp-info__good">verde</b> si llega y
                                            <b class="hp-info__bad">roja</b> si no; las en riesgo, rayadas en rojo al final.</span>
                                        <span>Miden cómo sale el ciclo: no frenan el corte.</span>
                                    </span>
                                </InfoTip>
                            </span>
                        </h3>
                        <LotBabyLeafCard Overview="overview" />
                        <LotActiveCard Overview="overview" />
                    </section>
                    @* Estado de todas las plantas del lote, debajo de las metas (antes debajo de los mapas). *@
                    <section class="lot-card" aria-labelledby="lot-states-title">
                        <header class="lot-card__head">
                            <h3 class="lot-card__title" id="lot-states-title">Plantas por estado</h3>
                        </header>
                        <DashboardStageChart Stages="@StageCounts(overview.Plants)" Compact="true" Description="Plantas del lote por estado" />
                        @if (overview.Plants.Harvested > 0)
                        {
                            <div class="lot-legend">
                                <span class="lot-legend__item">
                                    <span class="lot-legend__dot lot-seg--striped" style="background-color: #8a94a0;"></span>
                                    Cosechadas
                                </span>
                            </div>
                        }
                    </section>

                    @* Umbral de cosecha (% de Baby Leafs para cortar el lote): oculto por ahora, en revisión si aporta valor.
                    <LotThresholdCard Overview="overview" CanEdit="canEdit" OnEditObjectives="OpenEditor" />
                    *@
                </div>
            </div>

            @if (detail is not null)
            {
                @* Capa invisible: un clic fuera del mapa cierra el detalle (las celdas quedan por encima). *@
                <div class="lot-popover-backdrop" @onclick="ClosePopover"></div>
            }
        }
    </div>
}

@* Modales: alta de lote (con metas opcionales), metas del lote (lápiz de las cards) y cosecha masiva. *@
@if (creatingLot && newLotOptions is not null)
{
    <LotModal Title="Nuevo lote" Busy="savingLot" OnClose="CloseCreateLot">
        <LotCreateForm Options="newLotOptions" Saving="savingLot" Errors="newLotErrors"
                       OnSave="CreateLotAsync" OnCancel="CloseCreateLot" />
    </LotModal>
}
@if (batchAction is { } action && overview is not null)
{
    var harvest = action == BatchAction.Harvest;
    var transplantAction = action == BatchAction.Transplant;
    var count = LotFormat.Plants(picked.Count);
    <LotModal Title="@(transplantAction ? "Trasplantar a Adultas" : harvest ? "Cosechar plantas" : "Descartar plantas")" Busy="operating" OnClose="CloseBatch">
        @if (transplantAction && transplantPlan is { } plan)
        {
            @* Se eligen los circuitos de Adultas y su orden (1, 2, …): se llenan hueco por hueco, el 1 primero. Solo los que
               hacen falta: cuando los elegidos ya alcanzan para las plantas, no se puede agregar otro. *@
            <p class="mt-0">
                Elegí a qué circuitos de Adultas pasan las <strong>@count</strong>, en orden.
            </p>
            <div class="lot-transplant-pick" role="group" aria-label="Circuitos de Adultas">
                @foreach (var room in plan.Room)
                {
                    var position = transplantOrder.IndexOf(room.CircuitId);
                    var chosen = position >= 0;
                    var enough = !chosen && ChosenHoles >= picked.Count;
                    <button type="button" class="lot-transplant-pick__item @(chosen ? "is-chosen" : null)"
                            aria-pressed="@(chosen ? "true" : "false")" disabled="@(enough || operating)"
                            title="@(enough ? "Los elegidos ya alcanzan para las plantas" : null)"
                            @onclick="() => ToggleTransplantCircuit(room.CircuitId)">
                        <span class="lot-transplant-pick__order">@(chosen ? (position + 1).ToString() : null)</span>
                        <span class="lot-transplant-pick__text">
                            <span class="lot-transplant-pick__name">@room.CircuitName</span>
                            <span class="lot-transplant-pick__holes">@LotFormat.Count(room.FreeHoles, "hueco libre", "huecos libres")</span>
                        </span>
                    </button>
                }
            </div>
            <p class="lot-muted mt-2 mb-0">
                <span class="@(ChosenHoles < picked.Count ? "text-danger fw-semibold" : null)">
                    @LotFormat.Count(ChosenHoles, "hueco elegido", "huecos elegidos") para @count.
                </span>
                No se puede deshacer.
            </p>
        }
        else if (harvest)
        {
            <p class="mt-0">
                Se van a cosechar <strong>@count</strong>: @SplitText(ChosenSplit()).
                La fecha de cosecha es hoy (@LotFormat.Day(DateOnly.FromDateTime(DateTime.UtcNow))) y no se puede deshacer.
            </p>
            @* Cómo cosecharlas: viene elegido lo que corresponde por su estado; se puede cambiar (las trasplantadas siempre
               son adultas). Con plantas de los dos destinos, además "Según su estado". *@
            var mixed = HarvestSplit() is { BabyLeaf: > 0, Adult: > 0 };
            <div class="lot-choices" role="radiogroup" aria-label="Cosechar como">
                <span class="plant-detail__label">Cosechar como</span>
                @if (mixed)
                {
                    <button type="button" role="radio" aria-checked="@(harvestAs is null ? "true" : "false")"
                            class="lot-choice @(harvestAs is null ? "is-on" : null)" @onclick="() => harvestAs = null">Según su estado</button>
                }
                <button type="button" role="radio" aria-checked="@(harvestAs == HarvestDestination.BabyLeaf ? "true" : "false")"
                        class="lot-choice @(harvestAs == HarvestDestination.BabyLeaf ? "is-on" : null)"
                        @onclick="() => harvestAs = HarvestDestination.BabyLeaf">Baby Leaf</button>
                <button type="button" role="radio" aria-checked="@(harvestAs == HarvestDestination.Convencional ? "true" : "false")"
                        class="lot-choice @(harvestAs == HarvestDestination.Convencional ? "is-on" : null)"
                        @onclick="() => harvestAs = HarvestDestination.Convencional">Adulta</button>
            </div>
        }
        else
        {
            <p class="mt-0">Se van a descartar <strong>@count</strong>. No se puede deshacer.</p>
            <label class="form-label small mb-1" for="batch-reason">Motivo (opcional, vale para todas)</label>
            <input id="batch-reason" class="form-control form-control-sm" maxlength="300" placeholder="Ej.: granizo, tipburn"
                   @bind="batchReason" />
        }
        @if (!transplantAction && picked.Count >= overview.Plants.Active)
        {
            <p class="lot-muted mt-2 mb-0">No quedan otras plantas activas: el lote se cierra.</p>
        }
        @if (batchError is not null)
        {
            <div class="alert alert-danger py-2 small mt-2 mb-0">@batchError</div>
        }
        <div class="lot-editor__actions">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseBatch" disabled="@operating">Cancelar</button>
            <button class="btn btn-sm @(transplantAction || harvest ? "btn-success" : "btn-danger")" @onclick="ConfirmBatchAsync"
                    disabled="@(operating || (transplantAction && ChosenHoles < picked.Count))">
                @(operating ? (transplantAction ? "Trasplantando…" : harvest ? "Cosechando…" : "Descartando…")
                    : $"{(transplantAction ? "Trasplantar" : harvest ? "Cosechar" : "Descartar")} {count}")
            </button>
        </div>
    </LotModal>
}
@if (editingObjectives && overview is not null)
{
    <LotModal Title="Metas del lote" Busy="savingObjectives" OnClose="CloseEditor">
        <LotObjectivesEditor Current="overview.Objectives" TotalPlants="overview.Plants.TotalPlants" Saving="savingObjectives" Errors="objectiveErrors"
                             OnSave="SaveObjectivesAsync" OnCancel="CloseEditor" />
    </LotModal>
}

@code {
    /// <summary>Lote a abrir desde un enlace (/lotes?lote=ID); si no existe se usa el primero.</summary>
    [SupplyParameterFromQuery(Name = "lote")]
    public int? LotFromQuery { get; set; }

    private IReadOnlyList<LotOption>? lots;
    private int? selectedLotId;
    private DateOnly? simDate;

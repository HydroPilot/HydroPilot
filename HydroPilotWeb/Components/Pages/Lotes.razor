@page "/lotes"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@using System.Security.Claims
@using HydroPilotWeb.Components.Lotes
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Dashboard
@inject LotOverviewService LotOverview
@inject RecentVisitService RecentVisits
@inject LotCreationService LotCreation
@inject LotAggregateService LotAggregate
@inject PlantLifecycleService PlantLifecycle
@inject PlantTransplantService PlantTransplant
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Lotes</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
@if (notice is not null)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center py-2">
        <span>@notice</span>
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => notice = null"></button>
    </div>
}

@if (lots is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (lots.Count == 0)
{
    <div class="lot-view">
        <div class="alert alert-info mb-0 d-flex align-items-center gap-3 flex-wrap">
            <span>
                No hay lotes registrados.
                @(canCreateLot ? null : "Pedile a un Administrador, Productor u Operador que cree uno.")
            </span>
            @if (canCreateLot)
            {
                <button type="button" class="btn btn-success" @onclick="OpenCreateLotAsync">+ Nuevo lote</button>
            }
        </div>
    </div>
}
else
{
    <div class="lot-view">
        <div class="lot-toolbar">
            <label class="visually-hidden" for="lot-select">Lote</label>
            <select id="lot-select" class="form-select lot-toolbar__select" @bind="selectedLotId" @bind:after="OnLotChangedAsync">
                @foreach (var lot in lots)
                {
                    <option value="@lot.Id">@lot.Name · @StatusLabel(lot.StatusName)</option>
                }
            </select>
            @if (canCreateLot)
            {
                <button type="button" class="btn lot-toolbar__new" @onclick="OpenCreateLotAsync"
                        disabled="@creatingLot">+ Nuevo lote</button>
            }

            @* Sin chip de estado, área/siembra ni pH/CE: el estado va en el selector y la solución en Optimización. *@
            @if (overview is { IsClosed: false } current)
            {
                @if (current.DataAlerts.Count > 0)
                {
                    @* Mismo aviso que la sección "Detalles y calidad de los datos" (en rojo): al tocarlo la abre. *@
                    <button type="button" class="lot-chip lot-chip--danger lot-chip--strong" @onclick="ShowDataDetailsAsync"
                            title="@($"{string.Join(" · ", current.DataAlerts.Select(a => a.Title))}. Ver detalles y calidad de los datos.")">
                        ⚠ @(current.NoticeCount == 1 ? "1 aviso" : $"{current.NoticeCount} avisos")
                    </button>
                }
            }

            @if (loading && overview is not null)
            {
                @* Al cambiar de lote (o de fecha) los datos tardan: se avisa en vez de dejar la pantalla anterior quieta. *@
                <span class="lot-loading" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando…
                </span>
            }

            @* Comentarios del lote: a la derecha de todo (margin-left: auto). *@
            @if (selectedLotId is { } commentsLotId)
            {
                <LotComments LotId="commentsLotId" LotName="@(lots.FirstOrDefault(l => l.Id == commentsLotId)?.Name ?? "Lote")" User="user" />
            }

            @* "Ver al" (fecha simulada): oculto por ahora, quizás vuelva. Mezclaba el GDD de esa fecha con el
               estado de hoy de las plantas y confundía. La lógica sigue (simDate); para volver a mostrarlo,
               descomentar este bloque.
            <div class="lot-toolbar__date">
                <label for="lot-asof">Ver al</label>
                <input id="lot-asof" type="date" class="form-control form-control-sm" @bind="simDate" @bind:after="LoadAsync" />
                @if (simDate is not null)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetSimDateAsync">Hoy</button>
                }
            </div>
            *@
        </div>

        @if (overview is null)
        {
            @if (loading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
                </div>
            }
        }
        else
        {
            @if (simDate is { } viewDate)
            {
                <div class="alert alert-info py-1 px-2 small mb-0">
                    Vista al @LotFormat.Day(viewDate): se recalcula con los datos hasta esa fecha. El estado de las plantas es el actual.
                </div>
            }

            @* Mapa a la izquierda (60%) y las cards de situación apiladas a la derecha (40%).
               En pantallas angostas se apila todo, con las cards primero. *@
            <div class="lot-layout @(loading ? "lot-layout--loading" : null)" aria-busy="@(loading ? "true" : "false")">
                @* Columna izquierda: mapa y, debajo, los detalles técnicos (mismo ancho). *@
                <div class="lot-layout__main">
                    <section class="panel">
                        @* Título con el botón Seleccionar / Cancelar a la derecha; los filtros siempre en la línea de abajo. *@
                        <div class="lot-panel-head">
                            <h3 class="lot-panel-title">Mapa del lote</h3>
                            @if (!overview.IsClosed)
                            {
                                @if (!selecting)
                                {
                                    <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="StartSelecting" disabled="@operating">Seleccionar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="StopSelecting">Cancelar</button>
                                }
                            }
                        </div>
                        <div class="lot-map-filters">
                            @* Ojo: los parámetros string van con @ (sin @ Razor pasa el texto literal "highlightKey"). *@
                            <LotMapFilters Plants="overview.Plants" Selected="@highlightKey" OnSelected="OnFilterChanged" />
                        </div>
                        @if (!overview.IsClosed && selecting)
                        {
                            @* Elegir varias plantas para cosecharlas o descartarlas juntas. "Seleccionar todas" respeta el
                               filtro del mapa (con un filtro activo marca solo esas). *@
                            <div class="lot-select-bar">
                                <span class="lot-select-bar__count">@LotFormat.Count(picked.Count, "seleccionada", "seleccionadas")</span>
                                <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="SelectAll" disabled="@(Selectable().Count == 0)">@SelectAllLabel</button>
                                @if (picked.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm lot-select-bar__btn" @onclick="() => picked.Clear()">Limpiar</button>
                                }
                                <span class="lot-select-bar__actions">
                                    @if (transplantPlan is not null && canTransplant && HasDensePlants)
                                    {
                                        <button type="button" class="btn btn-sm lot-select-bar__btn" disabled="@(!CanTransplantPicked || operating)"
                                                title="@TransplantHint" @onclick="() => AskBatch(BatchAction.Transplant)">Trasplantar</button>
                                    }
                                    <button type="button" class="btn btn-success btn-sm" disabled="@(picked.Count == 0 || operating)"
                                            @onclick="() => AskBatch(BatchAction.Harvest)">Cosechar</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(picked.Count == 0 || operating)"
                                            @onclick="() => AskBatch(BatchAction.Discard)">Descartar</button>
                                </span>
                            </div>
                        }
                        @* Con trasplantadas, el mapa de cada circuito: el denso donde se sembró y los de Adultas. *@
                        @if (overview.State.AdultMaps is { Count: > 0 })
                        {
                            <h4 class="lot-map-subtitle">@(overview.State.CircuitName ?? "Circuito") · denso</h4>
                        }
                        @* El detalle de la planta se abre como popover anclado a la celda (no reserva espacio fijo). *@
                        <div class="lot-map-stage @(DetailIn(DenseCircuitId) ? "lot-map-stage--open" : null)" style="@StageStyle(overview.State.GridColumns ?? 0)">
                            <LotMap Rows="overview.State.GridRows ?? 0"
                                    Columns="overview.State.GridColumns ?? 0"
                                    Cells="overview.State.Cells"
                                    SelectedPosition="PositionIn(DenseCircuitId)"
                                    HighlightKey="@highlightKey"
                                    SelectionMode="selecting"
                                    PickedPlantIds="picked"
                                    OnCellSelected="SelectCellAsync" />
                            @if (DetailIn(DenseCircuitId) && PopoverFor(overview.State.GridRows ?? 0, overview.State.GridColumns ?? 0) is { } popover)
                            {
                                @PopoverMarkup(popover)
                            }
                        </div>
                        @foreach (var map in overview.State.AdultMaps ?? [])
                        {
                            <h4 class="lot-map-subtitle">@map.Name · Adultas</h4>
                            <div class="lot-map-stage @(DetailIn(map.CircuitId) ? "lot-map-stage--open" : null)" style="@StageStyle(map.Columns)">
                                <LotMap Rows="map.Rows"
                                        Columns="map.Columns"
                                        Cells="map.Cells"
                                        SelectedPosition="PositionIn(map.CircuitId)"
                                        HighlightKey="@highlightKey"
                                        SelectionMode="selecting"
                                        PickedPlantIds="picked"
                                        OnCellSelected="SelectCellAsync" />
                                @if (DetailIn(map.CircuitId) && PopoverFor(map.Rows, map.Columns) is { } adultPopover)
                                {
                                    @PopoverMarkup(adultPopover)
                                }
                            </div>
                        }
                        @* Estado de todas las plantas del lote, a todo el ancho debajo del mapa. *@
                        <div class="mt-3">
                            <LotStatusBar Plants="overview.Plants" />
                        </div>
                        <div class="lot-map-foot">
                            <p class="lot-muted mb-0">
                                @(overview.IsClosed ? "Tocá una planta del mapa para ver su detalle."
                                    : selecting ? "Tocá las plantas activas para marcarlas o desmarcarlas."
                                    : "Tocá una planta para ver su detalle, o usá Seleccionar para cosechar o descartar varias.")
                            </p>
                        </div>
                    </section>

                    <LotTechnicalDetails Overview="overview" />
                </div>

                <div class="lot-layout__side">
                    <LotWindowCard Overview="overview" />
                    @if (transplantPlan is { IsDue: true } plan)
                    {
                        <LotTransplantCard Plan="plan" Currency="@Currency" CanTransplant="canTransplant" Busy="operating" OnReview="ReviewTransplant" />
                    }
                    <LotBabyLeafCard Overview="overview" CanEdit="canEdit" OnEditObjectives="OpenEditor" />
                    <LotActiveCard Overview="overview" CanEdit="canEdit" OnEditObjectives="OpenEditor" />

                    @* Umbral de cosecha (% de Baby Leafs para cortar el lote): oculto por ahora, en revisión si aporta valor.
                    <LotThresholdCard Overview="overview" CanEdit="canEdit" OnEditObjectives="OpenEditor" />
                    *@

                    @* Pesos y precios: parámetros del sistema, se cargan en Ajustes > Parámetros. *@
                    <LotYieldCard Overview="overview" CanEdit="canEditParameters" />
                </div>
            </div>

            @if (detail is not null)
            {
                @* Capa invisible: un clic fuera del mapa cierra el detalle (las celdas quedan por encima). *@
                <div class="lot-popover-backdrop" @onclick="ClosePopover"></div>
            }
        }
    </div>
}

@* Modales: alta de lote (con metas opcionales), metas del lote (lápiz de las cards) y cosecha masiva. *@
@if (creatingLot && newLotOptions is not null)
{
    <LotModal Title="Nuevo lote" Busy="savingLot" OnClose="CloseCreateLot">
        <LotCreateForm Options="newLotOptions" Saving="savingLot" Errors="newLotErrors"
                       OnSave="CreateLotAsync" OnCancel="CloseCreateLot" />
    </LotModal>
}
@if (batchAction is { } action && overview is not null)
{
    var harvest = action == BatchAction.Harvest;
    var transplantAction = action == BatchAction.Transplant;
    var count = LotFormat.Plants(picked.Count);
    <LotModal Title="@(transplantAction ? "Trasplantar a Adultas" : harvest ? "Cosechar plantas" : "Descartar plantas")" Busy="operating" OnClose="CloseBatch">
        @if (transplantAction)
        {
            <p class="mt-0">
                Pasan <strong>@count</strong> a @string.Join(", ", transplantPlan?.Room.Select(r => r.CircuitName) ?? [])
                (en ese orden, hueco por hueco). Mano de obra: @LotFormat.Money((transplantPlan?.CostPerPlant ?? 0m) * picked.Count, Currency).
                No se puede deshacer.
            </p>
        }
        else if (harvest)
        {
            <p class="mt-0">
                Se van a cosechar <strong>@count</strong>: @SplitText(HarvestSplit()).
                La fecha de cosecha es hoy (@LotFormat.Day(DateOnly.FromDateTime(DateTime.UtcNow))) y no se puede deshacer.
            </p>
        }
        else
        {
            <p class="mt-0">Se van a descartar <strong>@count</strong>. No se puede deshacer.</p>
            <label class="form-label small mb-1" for="batch-reason">Motivo (opcional, vale para todas)</label>
            <input id="batch-reason" class="form-control form-control-sm" maxlength="300" placeholder="Ej.: granizo, tipburn"
                   @bind="batchReason" />
        }
        @if (!transplantAction && picked.Count >= overview.Plants.Active)
        {
            <p class="lot-muted mt-2 mb-0">No quedan otras plantas activas: el lote se cierra.</p>
        }
        @if (batchError is not null)
        {
            <div class="alert alert-danger py-2 small mt-2 mb-0">@batchError</div>
        }
        <div class="lot-editor__actions">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseBatch" disabled="@operating">Cancelar</button>
            <button class="btn btn-sm @(transplantAction || harvest ? "btn-success" : "btn-danger")" @onclick="ConfirmBatchAsync" disabled="@operating">
                @(operating ? (transplantAction ? "Trasplantando…" : harvest ? "Cosechando…" : "Descartando…")
                    : $"{(transplantAction ? "Trasplantar" : harvest ? "Cosechar" : "Descartar")} {count}")
            </button>
        </div>
    </LotModal>
}
@if (editingObjectives && overview is not null)
{
    <LotModal Title="Metas del lote" Busy="savingObjectives" OnClose="CloseEditor">
        <LotObjectivesEditor Current="overview.Objectives" TotalPlants="overview.Plants.TotalPlants" Saving="savingObjectives" Errors="objectiveErrors"
                             OnSave="SaveObjectivesAsync" OnCancel="CloseEditor" />
    </LotModal>
}

@code {
    /// <summary>Lote a abrir desde un enlace (/lotes?lote=ID); si no existe se usa el primero.</summary>
    [SupplyParameterFromQuery(Name = "lote")]
    public int? LotFromQuery { get; set; }

    private IReadOnlyList<LotOption>? lots;
    private int? selectedLotId;
    private DateOnly? simDate;
    private LotOverviewDto? overview;
    private PlantDetailDto? detail;
    // Celda del detalle: circuito (el denso o uno de Adultas), fila y columna.
    private (int? Circuit, int Row, int Column)? selected;
    private TransplantPlan? transplantPlan;
    private bool canTransplant;
    private string? highlightKey;
    private ElementReference popoverRef;
    private bool focusPopover;
    private string? error;
    private bool loading;
    private int loadVersion;
    private int? visitedLotId;
    private bool operating;
    private string? notice;
    // Selección de plantas en el mapa para cosechar o descartar varias.
    private enum BatchAction { Harvest, Discard, Transplant }
    private bool selecting;
    private readonly HashSet<int> picked = [];
    private BatchAction? batchAction;
    private string? batchReason;
    private string? batchError;

    private ClaimsPrincipal user = new();
    private bool canEdit;
    private bool editingObjectives;
    private bool savingObjectives;
    private IReadOnlyList<string> objectiveErrors = [];
    private bool canEditParameters;
    private bool canCreateLot;
    private bool creatingLot;
    private bool savingLot;
    private NewLotOptions? newLotOptions;
    private IReadOnlyList<string> newLotErrors = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = (await AuthState.GetAuthenticationStateAsync()).User;
            canEdit = LotOverviewService.CanEditObjectives(user);
            canEditParameters = SystemParametersService.CanEdit(user);
            canCreateLot = LotCreationService.CanCreate(user);
            canTransplant = PlantTransplantService.CanTransplant(user);

            lots = await LotOverview.GetLotOptionsAsync();
            selectedLotId = lots.Any(l => l.Id == LotFromQuery) ? LotFromQuery : lots.FirstOrDefault()?.Id;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar la lista de lotes: {ex.Message}";
            lots ??= [];
        }
    }

    private async Task OnLotChangedAsync()
    {
        StopSelecting();
        highlightKey = null;
        editingObjectives = false;
        notice = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (selectedLotId is not { } lotId)
            return;

        // Si se cambia de lote antes de que termine la carga anterior, gana la última.
        var version = ++loadVersion;
        loading = true;
        error = null;
        try
        {
            var loaded = await LotOverview.GetOverviewAsync(lotId, simDate);
            if (version != loadVersion)
                return;
            overview = loaded;
            detail = null;
            selected = null;
            transplantPlan = overview is { IsClosed: false } open
                ? await PlantTransplant.GetPlanAsync(lotId, open.State.GddAccumulated)
                : null;
            if (overview is null)
                error = "El lote seleccionado ya no existe.";
            else if (visitedLotId != lotId)
            {
                // "Últimos accedidos" del dashboard: una vez por lote abierto (no en cada recarga).
                visitedLotId = lotId;
                await RecentVisits.RecordAsync(user, HydroPilotWeb.Models.RecentVisitKinds.Lotes, lotId);
            }
        }
        catch (Exception ex)
        {
            if (version == loadVersion)
                error = $"No se pudo cargar el estado del lote: {ex.Message}";
        }
        finally
        {
            if (version == loadVersion)
                loading = false;
        }
    }

    private async Task ResetSimDateAsync()
    {
        simDate = null;
        await LoadAsync();
    }

    private async Task SelectCellAsync(PlantCellDto cell)
    {
        // El hueco del denso de una trasplantada abre la planta en su circuito de Adultas.
        if (cell.MovedTo is { } to)
        {
            if (selecting || overview?.State.AllCells.FirstOrDefault(c =>
                    c.CircuitId == to.CircuitId && c.Row == to.Row && c.Column == to.Column && c.PlantId is not null) is not { } target)
                return;
            cell = target;
        }

        if (selecting)
        {
            if (IsSelectable(cell) && !picked.Remove(cell.PlantId!.Value))
                picked.Add(cell.PlantId.Value);
            return;
        }

        // Tocar la misma planta cierra el detalle; otra planta lo mueve a esa celda.
        if (detail is not null && selected == (cell.CircuitId, cell.Row, cell.Column))
        {
            ClosePopover();
            return;
        }

        selected = (cell.CircuitId, cell.Row, cell.Column);
        detail = await LoadDetailAsync(cell);
        focusPopover = true;
    }

    private void ClosePopover()
    {
        detail = null;
        selected = null;
    }

    /// <summary>Circuito del mapa denso (null en lotes de antes de los circuitos).</summary>
    private int? DenseCircuitId => overview?.State.Cells.FirstOrDefault()?.CircuitId;

    private bool DetailIn(int? circuitId) => detail is not null && selected is { } s && s.Circuit == circuitId;

    private (int Row, int Column)? PositionIn(int? circuitId) =>
        selected is { } s && s.Circuit == circuitId ? (s.Row, s.Column) : null;

    private RenderFragment PopoverMarkup(PopoverPlacement popover) => __builder =>
    {
        <div class="lot-popover @popover.Css" style="@popover.Style" role="dialog"
             aria-label="@($"Detalle de la posición F{detail!.Row}-C{detail.Column}")"
             tabindex="-1" @ref="popoverRef" @onkeydown="OnPopoverKeyDown">
            <PlantDetailCard Detail="detail" AllowActions="!(overview?.IsClosed ?? true)" Busy="operating"
                             OnHarvest="HarvestSelectedAsync" OnDiscard="DiscardSelectedAsync"
                             OnClose="ClosePopover" />
        </div>
    };

    private void OnPopoverKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            ClosePopover();
    }

    private void OnFilterChanged(string? key)
    {
        highlightKey = key;
        ClosePopover();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Foco en el popover recién abierto: Escape lo cierra y los lectores de pantalla lo anuncian.
        if (focusPopover && detail is not null)
        {
            focusPopover = false;
            try
            {
                await popoverRef.FocusAsync(preventScroll: true);
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSException)
            {
                // El popover ya no está en el DOM (se cerró antes de enfocarlo): no hace falta el foco.
            }
        }
    }

    /// <summary>Ancho máximo de un mapa: celdas de hasta 72 px para que no quede gigante a pantalla completa.</summary>
    private static string StageStyle(int cols) => cols > 0
        ? $"max-width: {cols * 72 + (cols - 1) * 4 + 22}px;"
        : string.Empty;

    private sealed record PopoverPlacement(string Css, string Style);

    /// <summary>
    /// Ubicación del popover según la celda: abre hacia abajo en la mitad superior de la grilla y
    /// hacia arriba en la inferior; se alinea a izquierda/centro/derecha según la columna.
    /// Las posiciones son % del mapa (descontando su padding), así acompañan el ancho de la pantalla.
    /// </summary>
    private PopoverPlacement? PopoverFor(int rows, int cols)
    {
        {
            if (overview is null || selected is not { } pos)
                return null;
            if (rows <= 0 || cols <= 0)
                return null;

            var fx = (pos.Column - 0.5m) / cols;
            var below = pos.Row <= Math.Ceiling(rows / 2m);
            var align = fx < 0.34m ? "start" : fx > 0.66m ? "end" : "center";

            var x = $"left: calc(11px + (100% - 22px) * {Css(fx)})";
            var y = below
                ? $"top: calc(11px + (100% - 22px) * {Css((decimal)pos.Row / rows)} + 8px)"
                : $"bottom: calc(11px + (100% - 22px) * {Css(1m - (decimal)(pos.Row - 1) / rows)} + 8px)";

            return new PopoverPlacement($"lot-popover--{(below ? "below" : "above")} lot-popover--{align}", $"{x}; {y};");
        }
    }

    private static string Css(decimal value) => value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    private async Task<PlantDetailDto?> LoadDetailAsync(PlantCellDto cell)
    {
        if (overview is null)
            return null;

        var state = overview.State;
        if (cell.PlantId is { } plantId)
            return await LotAggregate.GetPlantDetailAsync(plantId, state.GddAccumulated, state.CurrentPh, state.CurrentEc);

        // Posición vacía: el detalle lo indica sin inventar datos.
        return new PlantDetailDto(
            0, cell.Row, cell.Column, null, null, default,
            null, null, null, state.GddAccumulated,
            state.CurrentPh, state.CurrentEc, null, null, null, null,
            false, null, null, [], []);
    }

    // Chip "⚠ N avisos" de la fila del lote: abre la sección de detalles y la lleva a la vista.
    private async Task ShowDataDetailsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                "const d = document.getElementById('lot-data-details'); if (d) { d.open = true; d.scrollIntoView({ block: 'center' }); }");
        }
        catch (JSException)
        {
            // Si el circuito se reconecta justo en ese momento, el chip simplemente no hace nada.
        }
    }

    private async Task OpenCreateLotAsync()
    {
        newLotErrors = [];
        try
        {
            newLotOptions = await LotCreation.GetOptionsAsync();
            creatingLot = true;
        }
        catch (Exception ex)
        {
            error = $"No se pudo abrir el alta de lote: {ex.Message}";
        }
    }

    private void CloseCreateLot()
    {
        newLotErrors = [];
        creatingLot = false;
    }

    private async Task CreateLotAsync(NewLotInput input)
    {
        savingLot = true;
        try
        {
            var result = await LotCreation.CreateAsync(input, user);
            if (!result.Succeeded)
            {
                newLotErrors = result.Errors;
                return;
            }

            // El lote nuevo queda seleccionado.
            creatingLot = false;
            newLotErrors = [];
            newLotOptions = null;
            lots = await LotOverview.GetLotOptionsAsync();
            selectedLotId = result.LotId;
            await OnLotChangedAsync();
        }
        catch (Exception ex)
        {
            newLotErrors = [$"No se pudo crear el lote: {ex.Message}"];
        }
        finally
        {
            savingLot = false;
        }
    }

    private void OpenEditor()
    {
        objectiveErrors = [];
        editingObjectives = true;
    }

    private void CloseEditor()
    {
        objectiveErrors = [];
        editingObjectives = false;
    }

    private async Task SaveObjectivesAsync(LotObjectives input)
    {
        if (selectedLotId is not { } lotId)
            return;

        savingObjectives = true;
        try
        {
            var result = await LotOverview.UpdateObjectivesAsync(lotId, input, user);
            if (result.Succeeded)
            {
                editingObjectives = false;
                objectiveErrors = [];
                await LoadAsync();
            }
            else
            {
                objectiveErrors = result.Errors;
            }
        }
        catch (Exception ex)
        {
            objectiveErrors = [$"No se pudieron guardar los objetivos: {ex.Message}"];
        }
        finally
        {
            savingObjectives = false;
        }
    }

    private async Task HarvestSelectedAsync()
    {
        if (detail is not { PlantId: > 0 } plant)
            return;

        await OperateAsync(() => PlantLifecycle.HarvestPlantAsync(plant.PlantId), "No se pudo cosechar");
    }

    // --- Selección de plantas: cosechar o descartar varias ---

    private static bool IsSelectable(PlantCellDto cell) =>
        cell.PlantId is not null && cell.OperationalState == PlantOperationalState.Activa;

    /// <summary>Plantas activas que marca "Seleccionar todas": con un filtro del mapa activo, solo las de ese filtro.</summary>
    private List<PlantCellDto> Selectable() =>
        overview?.State.AllCells
            .Where(c => IsSelectable(c) && (highlightKey is null || LotCellKeys.For(c) == highlightKey))
            .ToList() ?? [];

    private string Currency => overview?.Yield.Prices.Currency ?? "ARS";

    /// <summary>Se trasplantan activas que siguen en el denso, si entran en los huecos de Adultas.</summary>
    private bool CanTransplantPicked =>
        transplantPlan is { IsDue: true } plan && picked.Count > 0 && picked.Count <= plan.Capacity
        && overview is not null
        && overview.State.Cells.Count(c => c.PlantId is { } id && picked.Contains(id) && IsSelectable(c) && !c.IsAdultRoute) == picked.Count;

    /// <summary>Quedan plantas activas en el circuito denso (las que se pueden trasplantar).</summary>
    private bool HasDensePlants => overview?.State.Cells.Any(c => IsSelectable(c) && !c.IsAdultRoute) == true;

    /// <summary>Por qué "Trasplantar" está deshabilitado (o qué hace): fuera de la ventana, sin lugar o no entran.</summary>
    private string TransplantHint => transplantPlan switch
    {
        null => string.Empty,
        { IsDue: false } plan when overview is not null && overview.State.GddAccumulated < plan.DecisionGdd =>
            $"Se trasplanta desde {LotFormat.Num(plan.DecisionGdd)} GDD (hoy {LotFormat.Num(overview.State.GddAccumulated)}) hasta que cierra la ventana Baby Leaf.",
        { IsDue: false } => "La ventana Baby Leaf ya cerró: no se trasplanta.",
        { Capacity: 0 } => "No hay huecos libres en circuitos de Adultas.",
        { } plan when picked.Count > plan.Capacity => $"No entran: hay {plan.Capacity} huecos libres en Adultas.",
        _ => "Pasan a Adultas las marcadas del circuito denso."
    };

    /// <summary>Card de trasplante: marca en el mapa las que propone el sistema para revisarlas y confirmar.</summary>
    private void ReviewTransplant()
    {
        if (transplantPlan is not { } plan)
            return;
        ClosePopover();
        notice = null;
        picked.Clear();
        foreach (var id in plan.Proposal.PlantIds)
            picked.Add(id);
        highlightKey = null;
        selecting = true;
    }

    private string SelectAllLabel => highlightKey is null
        ? $"Seleccionar todas ({Selectable().Count})"
        : $"Seleccionar las filtradas ({Selectable().Count})";

    private void StartSelecting()
    {
        ClosePopover();
        notice = null;
        picked.Clear();
        selecting = true;
    }

    private void StopSelecting()
    {
        selecting = false;
        picked.Clear();
        batchAction = null;
    }

    private void SelectAll()
    {
        foreach (var cell in Selectable())
            picked.Add(cell.PlantId!.Value);
    }

    private void AskBatch(BatchAction action)
    {
        batchError = null;
        batchReason = null;
        batchAction = action;
    }

    private void CloseBatch()
    {
        batchError = null;
        batchAction = null;
    }

    /// <summary>Cuántas de las marcadas van a Baby Leaf y cuántas a adultas, por su estado (como lo decide el servicio).</summary>
    private (int BabyLeaf, int Adult) HarvestSplit()
    {
        var states = overview?.State.AllCells
            .Where(c => c.PlantId is { } id && picked.Contains(id))
            .Select(c => PlantHarvestRules.DestinationFor(c.CommercialStageName, c.IsAdultRoute))
            .ToList() ?? [];
        var babyLeaf = states.Count(d => d == HarvestDestination.BabyLeaf);
        return (babyLeaf, states.Count - babyLeaf);
    }

    private static string SplitText((int BabyLeaf, int Adult) split) => split switch
    {
        (1, 0) => "como Baby Leaf",
        (0, 1) => "como adulta",
        (_, 0) => "todas como Baby Leaf",
        (0, _) => "todas como adultas",
        var (bl, adult) => $"{bl} como Baby Leaf y {adult} como {(adult == 1 ? "adulta" : "adultas")}"
    };

    private async Task ConfirmBatchAsync()
    {
        if (batchAction is not { } action || selectedLotId is not { } lotId || picked.Count == 0)
            return;

        operating = true;
        try
        {
            var ids = picked.ToList();
            if (action == BatchAction.Transplant)
            {
                var moved = await PlantTransplant.TransplantAsync(lotId, ids, user);
                if (!moved.Succeeded)
                {
                    batchError = string.Join(" ", moved.Errors);
                    return;
                }
                StopSelecting();
                notice = $"Se trasplantaron {LotFormat.Plants(moved.Transplanted)} a {string.Join(", ", moved.Circuits)}.";
                await ReloadAfterPlantChangeAsync();
                return;
            }

            var result = action == BatchAction.Harvest
                ? await PlantLifecycle.HarvestPlantsAsync(lotId, ids)
                : await PlantLifecycle.DiscardPlantsAsync(lotId, ids, string.IsNullOrWhiteSpace(batchReason) ? null : batchReason.Trim());
            StopSelecting();
            notice = action == BatchAction.Harvest
                ? $"Se cosecharon {LotFormat.Plants(result.Harvested)}: {SplitText((result.BabyLeaf, result.Adult))}."
                : $"Se descartaron {LotFormat.Plants(result.Discarded)}.";
            await ReloadAfterPlantChangeAsync();
        }
        catch (Exception ex)
        {
            batchError = $"No se pudo {(action == BatchAction.Transplant ? "trasplantar" : action == BatchAction.Harvest ? "cosechar" : "descartar")}: {ex.Message}";
        }
        finally
        {
            operating = false;
        }
    }

    private async Task DiscardSelectedAsync(string? reason)
    {
        if (detail is not { PlantId: > 0 } plant)
            return;

        await OperateAsync(() => PlantLifecycle.DiscardPlantAsync(plant.PlantId, reason), "No se pudo descartar");
    }

    /// <summary>Ejecuta una operación sobre la planta seleccionada y recarga manteniendo la selección.</summary>
    /// <summary>
    /// Recarga después de cosechar o descartar. Si ya no quedan plantas activas, el lote se cerró solo
    /// (PlantLifecycleService): se avisa y se actualiza el estado en el selector.
    /// </summary>
    private async Task ReloadAfterPlantChangeAsync()
    {
        var wasClosed = overview?.IsClosed ?? false;
        await LoadAsync();
        if (!wasClosed && overview is { IsClosed: true } closed)
        {
            var status = closed.State.StatusName == "COSECHADO" ? "cosechado" : "descartado";
            notice = $"{notice} No quedan plantas activas: el lote se cerró como {status}.".Trim();
            lots = await LotOverview.GetLotOptionsAsync();
        }
    }

    private async Task OperateAsync(Func<Task> operation, string errorPrefix)
    {
        operating = true;
        try
        {
            await operation();
            var position = selected;
            notice = null;
            await ReloadAfterPlantChangeAsync();
            if (position is { } pos
                && overview?.State.AllCells.FirstOrDefault(c => c.CircuitId == pos.Circuit && c.Row == pos.Row && c.Column == pos.Column) is { } cell)
            {
                selected = pos;
                detail = await LoadDetailAsync(cell);
            }
        }
        catch (Exception ex)
        {
            error = $"{errorPrefix}: {ex.Message}";
        }
        finally
        {
            operating = false;
        }
    }

    private static string StatusLabel(string? status) => status switch
    {
        "ACTIVO" => "Activo",
        "EN_PAUSA" => "En pausa",
        "COSECHADO" => "Cosechado",
        "DESCARTADO" => "Descartado",
        _ => status ?? "Sin estado"
    };
}

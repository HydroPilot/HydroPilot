@page "/control"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer
@implements IDisposable

@using System.Globalization
@using System.Security.Claims
@using HydroPilotWeb.Components.Lotes
@using HydroPilotWeb.Models
@using HydroPilotWeb.Models.Control
@using HydroPilotWeb.Services.Anomalies
@using HydroPilotWeb.Services.Control
@inject ControlService ControlService
@inject AuthenticationStateProvider AuthState
@inject ILogger<ControlPanel> Logger

<PageTitle>Control</PageTitle>

@* pH y CE del tanque de cada nodo y sus 4 bombas: dosis manual y la conversación con la Pi.
   La lógica está en ControlRules / ControlService (notas/ux/logica-vista-control.md). *@

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (nodes is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (nodes.Count == 0)
{
    <div class="alert alert-info">No hay nodos registrados.</div>
}
else
{
    <div class="ctl-view">
        <div class="lot-toolbar">
            <label class="visually-hidden" for="ctl-node">Nodo</label>
            <select id="ctl-node" class="form-select lot-toolbar__select" @bind="selectedNodeId" @bind:after="ChangeNodeAsync">
                @foreach (var node in nodes)
                {
                    <option value="@node.Id">@node.Identifier · @(node.LotName ?? "sin lote")</option>
                }
            </select>

            @if (view is not null)
            {
                <span class="lot-chip lot-chip--@ConnectionTone(view.ConnectionState)">@ConnectionText(view.ConnectionState)</span>
                <span class="lot-chip lot-chip--@PollTone(view.LastCommandPollAtUtc, view.PiContactStaleMinutes)"
                      title="Última señal de la Pi: consulta de comandos (HTTP) o mensaje (IoT Hub)">
                    @(view.LastCommandPollAtUtc is { } poll ? $"Pi {Ago(poll)}" : "Pi sin señal")
                </span>
                @if (canConfigure)
                {
                    <button type="button" class="lot-chip" @onclick="StartTankEdit">Tanque @Liters(view.ReservoirLiters)</button>
                }
                else
                {
                    <span class="lot-chip">Tanque @Liters(view.ReservoirLiters)</span>
                }
                @if (view.LotId is { } lotId)
                {
                    <a class="lot-link ctl-lot" href="lotes?lote=@lotId">@view.LotName@(view.StageName is { } stage ? $" · {stage}" : null)</a>
                    @if (view.Recipe is { } recipe)
                    {
                        <span class="lot-chip lot-chip--@(IsAdjusted(recipe) ? "info" : "muted")" title="@recipe.Reason">@RecipeText(recipe)</span>
                    }
                }
            }
        </div>

        @if (editingTank)
        {
            <div class="ctl-tank-edit">
                <label class="form-label small mb-0" for="ctl-tank">Litros</label>
                <input id="ctl-tank" type="number" min="1" step="1" class="form-control form-control-sm ctl-amount"
                       value="@tankText" @oninput="e => tankText = e.Value?.ToString() ?? string.Empty" />
                <button type="button" class="btn btn-success btn-sm" disabled="@busy" @onclick="SaveTankAsync">Guardar</button>
                <button type="button" class="btn btn-sm hp-btn-secondary" @onclick="() => editingTank = false">Cancelar</button>
                @if (tankError is not null)
                {
                    <span class="ctl-error">@tankError</span>
                }
            </div>
        }

        @if (view is not null)
        {
            @* --- Solución del tanque --- *@
            <section class="ctl-kpis">
                @{
                    var status = StatusLine(view.Status, view.Mode);
                }
                <article class="ctl-kpi ctl-kpi--control">
                    <span class="ctl-kpi__label">Control</span>
                    @if (canConfigure)
                    {
                        <div class="ctl-mode" role="group" aria-label="Modo de control">
                            <button type="button" class="ctl-mode__option @(view.Mode != ControlContract.ModeAuto ? "ctl-mode__option--on" : null)"
                                    aria-pressed="@(view.Mode != ControlContract.ModeAuto)" disabled="@busy"
                                    @onclick="() => SetModeAsync(ControlContract.ModeManual)">Manual</button>
                            <button type="button" class="ctl-mode__option @(view.Mode == ControlContract.ModeAuto ? "ctl-mode__option--on" : null)"
                                    aria-pressed="@(view.Mode == ControlContract.ModeAuto)" disabled="@busy"
                                    @onclick="() => SetModeAsync(ControlContract.ModeAuto)">Automático</button>
                        </div>
                    }
                    else
                    {
                        <span class="lot-chip lot-chip--info ctl-mode-chip">@ModeText(view.Mode)</span>
                    }
                    <strong class="ctl-kpi__status ctl-tone--@status.Tone">@status.Title</strong>
                    <span class="ctl-kpi__sub">@status.Detail</span>
                    @if (modeError is not null)
                    {
                        <span class="ctl-error">@modeError</span>
                    }
                </article>

                @foreach (var parameter in new[] { view.Ph, view.Ec })
                {
                    var isEc = parameter.SensorType == ControlContract.ParameterEc;
                    var pause = view.OpenPauses.FirstOrDefault(p => p.Parameter == parameter.SensorType);
                    <article class="ctl-kpi @(pause is not null ? "ctl-kpi--paused" : null)">
                        <span class="ctl-kpi__label">@(isEc ? "CE" : "pH")</span>
                        <strong class="ctl-kpi__value ctl-tone--@SolutionTone(parameter.State)">
                            @Value(parameter.Value)
                            @if (isEc && parameter.Value is not null)
                            {
                                <small>mS/cm</small>
                            }
                        </strong>
                        <span class="ctl-kpi__sub">@BandText(parameter.Band)</span>
                        <div class="ctl-kpi__foot">
                            <span class="lot-chip lot-chip--@SolutionTone(parameter.State)">@SolutionAction(parameter)</span>
                            @if (parameter.ObservedAtUtc is { } observed)
                            {
                                <span class="ctl-kpi__age">@Ago(observed)</span>
                            }
                        </div>
                        @if (pause is not null)
                        {
                            <div class="ctl-kpi__pause">
                                <span class="lot-chip lot-chip--danger" title="Pausado @Clock(pause.PausedAtUtc)">Pausado · @pause.Reason</span>
                                @if (canDose)
                                {
                                    <button type="button" class="btn btn-sm hp-btn-secondary" disabled="@busy"
                                            @onclick="() => ResumeAsync(pause.Parameter)">Reanudar</button>
                                }
                            </div>
                        }
                    </article>
                }
                <article class="ctl-kpi">
                    <span class="ctl-kpi__label">Dosis 24 h</span>
                    <strong class="ctl-kpi__value">@view.Kpis.Executed24h</strong>
                    <span class="ctl-kpi__sub">ejecutadas</span>
                    <div class="ctl-kpi__foot">
                        @if (view.Kpis.InFlight > 0)
                        {
                            <span class="lot-chip lot-chip--info">@view.Kpis.InFlight en curso</span>
                        }
                        @if (view.Kpis.Problems24h > 0)
                        {
                            <span class="lot-chip lot-chip--warning">@view.Kpis.Problems24h sin aplicar</span>
                        }
                    </div>
                </article>
            </section>

            @* --- Bombas --- *@
            <section class="ctl-pumps">
                @foreach (var pump in view.Actuators)
                {
                    var style = PumpStyle(pump.Kind);
                    var usedPct = pump.MaxPerDay > 0 ? Math.Min(100m, pump.UsedLast24h / pump.MaxPerDay * 100m) : 0m;
                    <article class="ctl-pump" style="--ctl-pump: @style.Color;">
                        <header class="ctl-pump__head">
                            <span class="ctl-pump__name">@pump.Name</span>
                            <span class="ctl-pump__effect">@style.Effect</span>
                        </header>

                        <div class="ctl-pump__used">
                            <strong>@Amount(pump.UsedLast24h, pump.Unit)</strong>
                            <span>de @Amount(pump.MaxPerDay, pump.Unit) en 24 h</span>
                        </div>
                        <div class="ctl-pump__bar" role="progressbar" aria-valuenow="@((int)usedPct)" aria-valuemin="0" aria-valuemax="100">
                            <span style="width: @(usedPct.ToString("0", CultureInfo.InvariantCulture))%;"></span>
                        </div>

                        @if (pump.InFlight is { } flight)
                        {
                            <div class="ctl-pump__flight">
                                <span class="lot-chip lot-chip--@StatusTone(flight.Status)">
                                    @StatusText(flight.Status) · @Amount(flight.Amount, flight.Unit)
                                </span>
                                <span class="ctl-pump__expires">vence @Clock(flight.ExpiresAtUtc)</span>
                                @if (canDose && flight.Status == ControlContract.StatusPending && flight.DispatchedAtUtc is null)
                                {
                                    <button type="button" class="btn btn-sm hp-btn-secondary" disabled="@busy"
                                            @onclick="() => CancelAsync(pump.Id, flight.Id)">Cancelar</button>
                                }
                            </div>
                        }
                        else if (!pump.IsActive)
                        {
                            <span class="lot-chip">Desactivada</span>
                        }
                        else if (canDose && view.Mode != ControlContract.ModeOff)
                        {
                            <div class="ctl-pump__dose">
                                <input type="number" min="0" step="@(pump.Unit == ControlContract.UnitLiters ? "0.5" : "1")"
                                       class="form-control form-control-sm ctl-amount" aria-label="Cantidad de @pump.Name"
                                       placeholder="@Amount(pump.MaxPerCommand, pump.Unit) máx."
                                       value="@AmountText(pump.Id)" @oninput="e => SetAmount(pump.Id, e.Value?.ToString())" />
                                <span class="ctl-pump__unit">@pump.Unit</span>
                                <button type="button" class="btn btn-success btn-sm" disabled="@(busy || !CanSend(pump.Id))"
                                        @onclick="() => DoseAsync(pump)">Enviar</button>
                                @if (Preview(pump) is { } preview)
                                {
                                    <span class="ctl-pump__preview" title="Efecto estimado con el tanque y la calibración de la bomba">@preview</span>
                                }
                            </div>
                        }

                        @if (pumpErrors.GetValueOrDefault(pump.Id) is { } pumpError)
                        {
                            <span class="ctl-error">@pumpError</span>
                        }
                    </article>
                }
            </section>

            @* --- Conversación con la Pi --- *@
            <h3 class="lot-panel-title ctl-timeline-title">Conversación</h3>
            @if (view.Timeline.Count == 0)
            {
                <div class="ctl-empty">Sin mensajes en las últimas 24 h.</div>
            }
            else
            {
                <ol class="ctl-timeline">
                    @foreach (var entry in view.Timeline)
                    {
                        var line = Line(entry);
                        <li class="ctl-msg">
                            <span class="ctl-msg__time">@line.Time</span>
                            <span class="ctl-msg__dir ctl-msg__dir--@line.Direction" title="@DirectionTitle(line.Direction)">@DirectionGlyph(line.Direction)</span>
                            <span class="ctl-msg__title">@line.Title</span>
                            <span class="ctl-msg__detail">@line.Detail</span>
                            @if (line.Chip is not null)
                            {
                                <span class="lot-chip lot-chip--@line.Tone ctl-msg__chip">@line.Chip</span>
                            }
                        </li>
                    }
                </ol>
            }
        }
    </div>
}

@code {
    /// <summary>Nodo a abrir desde un enlace: /control?nodo=rpi-inv-01.</summary>
    [SupplyParameterFromQuery(Name = "nodo")]
    public string? NodeFromQuery { get; set; }

    /// <summary>Lote a abrir desde un enlace (Optimización): /control?lote=ID abre el nodo asignado al lote.</summary>
    [SupplyParameterFromQuery(Name = "lote")]
    public int? LotFromQuery { get; set; }

    private static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(5);

    private IReadOnlyList<ControlNodeOption>? nodes;
    private int? selectedNodeId;
    private ControlViewDto? view;
    private string? error;
    private bool busy;
    private bool canDose;
    private bool canConfigure;
    private string? currentUser;

    private bool editingTank;
    private string tankText = string.Empty;
    private string? tankError;
    private string? modeError;

    private readonly Dictionary<int, string> amounts = new();
    private readonly Dictionary<int, string> pumpErrors = new();

    private CancellationTokenSource? refreshCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            currentUser = auth.User.Identity?.Name ?? auth.User.FindFirst(ClaimTypes.Email)?.Value;
            canDose = ControlService.CanDose(auth.User);
            canConfigure = ControlService.CanConfigure(auth.User);

            nodes = await ControlService.GetNodesAsync();
            var fromLot = LotFromQuery is { } lotId ? await ControlService.NodeForLotAsync(lotId) : null;
            selectedNodeId = nodes.FirstOrDefault(n => n.Id == fromLot)?.Id
                ?? nodes.FirstOrDefault(n => string.Equals(n.Identifier, NodeFromQuery, StringComparison.OrdinalIgnoreCase))?.Id
                ?? nodes.FirstOrDefault(n => n.LotName is not null)?.Id
                ?? nodes.FirstOrDefault()?.Id;
            await LoadAsync();

            refreshCts = new CancellationTokenSource();
            _ = RefreshLoopAsync(refreshCts.Token);
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar Control: {ex.Message}";
            Logger.LogError(ex, "Control init failed");
            nodes ??= [];
        }
    }

    public void Dispose()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();
    }

    /// <summary>La vista se actualiza sola: así se ve cómo la Pi toma el comando y responde.</summary>
    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshEvery);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (busy)
                    continue;
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ChangeNodeAsync()
    {
        amounts.Clear();
        pumpErrors.Clear();
        editingTank = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (selectedNodeId is not { } nodeId)
            return;
        try
        {
            view = await ControlService.GetViewAsync(nodeId);
            error = null;
        }
        catch (Exception ex)
        {
            error = $"No se pudo actualizar el nodo: {ex.Message}";
            Logger.LogError(ex, "Control load failed for node {NodeId}", nodeId);
        }
    }

    // --- Dosis ---

    private string AmountText(int pumpId) => amounts.GetValueOrDefault(pumpId) ?? string.Empty;

    private void SetAmount(int pumpId, string? value)
    {
        amounts[pumpId] = value ?? string.Empty;
        pumpErrors.Remove(pumpId);
    }

    private decimal? ParsedAmount(int pumpId) =>
        decimal.TryParse(AmountText(pumpId), NumberStyles.Number, CultureInfo.InvariantCulture, out var value) ? value : null;

    private bool CanSend(int pumpId) => ParsedAmount(pumpId) is > 0m;

    private async Task DoseAsync(ControlActuatorDto pump)
    {
        if (selectedNodeId is not { } nodeId || ParsedAmount(pump.Id) is not { } amount)
            return;

        await RunAsync(pump.Id, async () =>
        {
            var result = await ControlService.RequestDoseAsync(nodeId, pump.Id, amount, currentUser);
            if (!result.Succeeded)
                pumpErrors[pump.Id] = result.Message ?? "No se pudo pedir la dosis.";
            else
                amounts.Remove(pump.Id);
        });
    }

    // --- Modo y pausas ---

    private async Task SetModeAsync(string mode)
    {
        if (selectedNodeId is not { } nodeId || view?.Mode == mode)
            return;

        busy = true;
        modeError = null;
        try
        {
            var result = await ControlService.SetModeAsync(nodeId, mode, currentUser);
            if (!result.Succeeded)
                modeError = result.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            modeError = $"No se pudo cambiar el modo: {ex.Message}";
            Logger.LogError(ex, "Control mode change failed for node {NodeId}", nodeId);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResumeAsync(string parameter)
    {
        if (selectedNodeId is not { } nodeId)
            return;

        busy = true;
        modeError = null;
        try
        {
            var result = await ControlService.ResumeAsync(nodeId, parameter, currentUser);
            if (!result.Succeeded)
                modeError = result.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            modeError = $"No se pudo reanudar: {ex.Message}";
            Logger.LogError(ex, "Control resume failed for node {NodeId}", nodeId);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Efecto estimado de la cantidad escrita, con el tanque y la calibración actual de la bomba.</summary>
    private string? Preview(ControlActuatorDto pump)
    {
        if (view is null || ParsedAmount(pump.Id) is not { } amount || amount <= 0m)
            return null;

        var isPh = ControlRules.ParameterFor(pump.Kind) == ControlContract.ParameterPh;
        var current = isPh ? view.Ph.Value : view.Ec.Value;
        if (pump.Kind == ControlContract.KindWater ? current is null : pump.Effect is null)
            return null;

        var expected = ControlEngine.ExpectedEffect(pump.Kind, amount, view.ReservoirLiters, pump.Effect ?? 1m,
            current ?? 0m, view.SourceWaterEc);
        return $"≈ {Signed(expected)} {(isPh ? "pH" : "CE")}";
    }

    private async Task CancelAsync(int pumpId, Guid commandId)
    {
        if (selectedNodeId is not { } nodeId)
            return;

        await RunAsync(pumpId, async () =>
        {
            var result = await ControlService.CancelAsync(nodeId, commandId, currentUser);
            if (!result.Succeeded)
                pumpErrors[pumpId] = result.Message ?? "No se pudo cancelar.";
        });
    }

    private async Task RunAsync(int pumpId, Func<Task> action)
    {
        busy = true;
        pumpErrors.Remove(pumpId);
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            pumpErrors[pumpId] = $"No se pudo guardar: {ex.Message}";
            Logger.LogError(ex, "Control action failed for pump {PumpId}", pumpId);
        }
        finally
        {
            busy = false;
        }
    }

    // --- Tanque ---

    private void StartTankEdit()
    {
        tankText = view?.ReservoirLiters.ToString("0.#", CultureInfo.InvariantCulture) ?? string.Empty;
        tankError = null;
        editingTank = true;
    }

    private async Task SaveTankAsync()
    {
        if (selectedNodeId is not { } nodeId)
            return;
        if (!decimal.TryParse(tankText, NumberStyles.Number, CultureInfo.InvariantCulture, out var liters))
        {
            tankError = "Ingresá los litros del tanque.";
            return;
        }

        busy = true;
        try
        {
            var result = await ControlService.SetReservoirAsync(nodeId, liters, currentUser);
            if (!result.Succeeded)
            {
                tankError = result.Message;
                return;
            }
            editingTank = false;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // --- Formato ---

    private static string Value(decimal? value) => value?.ToString("0.0#", LotFormat.Culture) ?? "—";

    private static string BandText(SolutionBand band) =>
        band.IsDefined
            ? $"{Value(band.Min)}–{Value(band.Max)}{(band.Target is { } target ? $" · obj. {Value(target)}" : null)}"
            : "sin lote";

    private static string Amount(decimal value, string unit) => $"{value.ToString("0.#", LotFormat.Culture)} {unit}";

    private static string Liters(decimal value) => $"{value.ToString("0.#", LotFormat.Culture)} L";

    private static string Clock(DateTime utc) => utc.ToLocalTime().ToString("HH:mm:ss", LotFormat.Culture);

    private static string Ago(DateTime utc)
    {
        var elapsed = DateTime.UtcNow - utc;
        if (elapsed < TimeSpan.Zero)
            elapsed = TimeSpan.Zero;
        return elapsed.TotalSeconds < 60 ? $"hace {(int)elapsed.TotalSeconds} s"
            : elapsed.TotalMinutes < 60 ? $"hace {(int)elapsed.TotalMinutes} min"
            : elapsed.TotalHours < 24 ? $"hace {(int)elapsed.TotalHours} h"
            : utc.ToLocalTime().ToString("dd/MM HH:mm", LotFormat.Culture);
    }

    private static string SolutionAction(SolutionParameterStatus p) => p.State switch
    {
        SolutionState.InRange => "En rango",
        SolutionState.Raise => $"Subir a {Value(p.Band.Target)}",
        SolutionState.Lower => $"Bajar a {Value(p.Band.Target)}",
        SolutionState.Unconfirmed => "Confirmar lectura",
        SolutionState.Stale => "Sin lectura fresca",
        SolutionState.NoBand => "Sin rango",
        _ => "Sin datos",
    };

    private static string SolutionTone(SolutionState state) => state switch
    {
        SolutionState.InRange => "success",
        SolutionState.Raise or SolutionState.Lower => "danger",
        SolutionState.Unconfirmed => "warning",
        SolutionState.NoBand => "info",
        _ => "muted",
    };

    private static string ConnectionText(string state) => state switch
    {
        TelemetryContract.ConnectionOnline => "En línea",
        TelemetryContract.ConnectionDegraded => "Intermitente",
        TelemetryContract.ConnectionOffline => "Sin conexión",
        _ => "Nunca conectado",
    };

    private static string ConnectionTone(string state) => state switch
    {
        TelemetryContract.ConnectionOnline => "success",
        TelemetryContract.ConnectionDegraded => "warning",
        TelemetryContract.ConnectionOffline => "danger",
        _ => "muted",
    };

    /// <summary>Sin señal de la Pi por más de staleMinutes, las dosis van a vencer sin ejecutarse.</summary>
    private static string PollTone(DateTime? lastPollUtc, int staleMinutes) =>
        lastPollUtc is { } poll && DateTime.UtcNow - poll <= TimeSpan.FromMinutes(staleMinutes) ? "success" : "muted";

    private static string Signed(decimal? value) => value is { } v
        ? (v > 0m ? "+" : v < 0m ? "−" : string.Empty) + Math.Abs(v).ToString("0.00", LotFormat.Culture)
        : "—";

    private static bool IsAdjusted(ControlRecipeDto recipe) => recipe.PhOffset != 0m || recipe.EcOffset != 0m;

    /// <summary>Receta aprendida: el ajuste a los objetivos de la etapa, o que rigen los de la etapa.</summary>
    private static string RecipeText(ControlRecipeDto recipe)
    {
        if (!IsAdjusted(recipe))
            return "Niveles de la etapa";
        var parts = new List<string>();
        if (recipe.PhOffset != 0m)
            parts.Add($"pH {Signed(recipe.PhOffset)}");
        if (recipe.EcOffset != 0m)
            parts.Add($"CE {Signed(recipe.EcOffset)}");
        return $"Receta {string.Join(" · ", parts)}{(recipe.Trust < 1m ? $" · {Pct(recipe.Trust)}" : null)}";
    }

    private static string Pct(decimal fraction) => (fraction * 100m).ToString("0", LotFormat.Culture) + " %";

    private sealed record StatusInfo(string Title, string Detail, string Tone);

    /// <summary>Qué está haciendo el motor, en pocas palabras (ControlEngine.Codes).</summary>
    private static StatusInfo StatusLine(ControlStatusDto status, string mode)
    {
        if (mode != ControlContract.ModeAuto)
            return new("Manual", "solo dosis pedidas acá", "muted");

        var parameter = status.Parameter ?? string.Empty;
        var dose = status.PumpName is { } pump ? $"{pump} {Amount(status.Amount, status.Unit ?? string.Empty)}" : parameter;
        return status.Code switch
        {
            ControlEngine.Codes.InBand => new("En rango", "pH y CE dentro de la banda", "success"),
            ControlEngine.Codes.Dose => new($"Corrigiendo {parameter}", dose, "info"),
            ControlEngine.Codes.InFlight => new("Dosis en curso", "esperando a la Pi", "info"),
            ControlEngine.Codes.Mixing => new("Mezclando", status.UntilUtc is { } until ? $"hasta {Clock(until)}" : string.Empty, "info"),
            ControlEngine.Codes.AwaitReading => new("Esperando lecturas", "2 lecturas después de la mezcla", "info"),
            ControlEngine.Codes.Approaching => new($"{parameter} volviendo solo", "sin dosis por ahora", "info"),
            ControlEngine.Codes.Unconfirmed => new("Confirmando lectura", "falta una lectura que coincida", "warning"),
            ControlEngine.Codes.Paused => new($"{parameter} pausado", "revisar y reanudar", "danger"),
            ControlEngine.Codes.PiSilent => new("La Pi no consulta", "sin dosis hasta que vuelva", "danger"),
            ControlEngine.Codes.DailyLimit => new("Límite de 24 h", dose, "warning"),
            ControlEngine.Codes.Direction => new("Cambio de sentido", status.UntilUtc is { } after ? $"espera hasta {Clock(after)}" : string.Empty, "warning"),
            ControlEngine.Codes.PumpOff => new("Bomba desactivada", status.PumpName ?? parameter, "warning"),
            ControlEngine.Codes.WaterTarget => new("El agua no alcanza", "objetivo de CE bajo el agua de red", "warning"),
            ControlEngine.Codes.NoLot => new("Sin lote", "sin banda para controlar", "muted"),
            _ => new("Sin lecturas frescas", "no dosifica a ciegas", "muted"),
        };
    }

    private static string ModeText(string mode) => mode switch
    {
        ControlContract.ModeAuto => "Automático",
        ControlContract.ModeOff => "Apagado",
        _ => "Manual",
    };

    private static string StatusText(string status) => status switch
    {
        ControlContract.StatusPending => "Pendiente",
        ControlContract.StatusDelivered => "Entregada",
        ControlContract.StatusExecuted => "Ejecutada",
        ControlContract.StatusRejected => "Rechazada",
        ControlContract.StatusFailed => "Falló",
        ControlContract.StatusExpired => "Vencida",
        ControlContract.StatusUnconfirmed => "Sin confirmar",
        ControlContract.StatusCancelled => "Cancelada",
        _ => status,
    };

    private static string StatusTone(string status) => status switch
    {
        ControlContract.StatusExecuted => "success",
        ControlContract.StatusPending or ControlContract.StatusDelivered => "info",
        ControlContract.StatusFailed => "danger",
        ControlContract.StatusRejected or ControlContract.StatusUnconfirmed or ControlContract.StatusExpired => "warning",
        _ => "muted",
    };

    private sealed record PumpInfo(string Color, string Effect);

    private static PumpInfo PumpStyle(string kind) => kind switch
    {
        ControlContract.KindPhUp => new("#7c3aed", "↑ pH"),
        ControlContract.KindPhDown => new("#e04f2b", "↓ pH"),
        ControlContract.KindNutrient => new("#0e9384", "↑ CE"),
        ControlContract.KindWater => new("#2f7dd1", "↓ CE"),
        _ => new("#94a3b8", string.Empty),
    };

    // --- Conversación ---

    /// <summary>in = de la Pi a la nube · out = de la nube a la Pi · web = acción en la vista.</summary>
    private sealed record TimelineLine(string Time, string Direction, string Title, string Detail, string? Chip, string Tone);

    private static TimelineLine Line(ControlTimelineEntry entry)
    {
        var time = Clock(entry.AtUtc);
        if (entry.Kind == ControlTimelineKind.Readings && entry.Readings is { } r)
        {
            var values = string.Join(" · ", new[]
            {
                r.Ph is { } ph ? $"pH {Value(ph)}" : null,
                r.Ec is { } ec ? $"CE {Value(ec)}" : null,
            }.Where(v => v is not null));
            var title = r.Count == 1 ? "Lecturas" : $"Lecturas ×{r.Count}";
            var span = r.Count == 1 ? time : $"{Clock(r.FirstUtc)}–{time}";
            return new(span, "in", title, values, null, "muted");
        }

        if (entry.Pause is { } pause)
        {
            return entry.Kind == ControlTimelineKind.Paused
                ? new(time, "web", "Pausa", $"{pause.Parameter} · {pause.Reason}", "Pausado", "danger")
                : new(time, "web", "Reanudado", $"{pause.Parameter}{(pause.ResumedBy is { } who ? $" · {who}" : null)}", "Reanudado", "success");
        }

        var c = entry.Command!;
        var dose = $"{c.ActuatorName} {Amount(c.Amount, c.Unit)}";
        return entry.Kind switch
        {
            ControlTimelineKind.Requested => c.Source == ControlContract.SourceManual
                ? new(time, "web", "Pedido", $"{dose}{(c.RequestedBy is { } by ? $" · {by}" : null)}", "Manual", "info")
                : new(time, "web", "Pedido",
                    $"{dose} · {c.Parameter} {Value(c.ValueBefore)} → {Value(c.Target)}{(c.Strength is { } s ? $" · fuerza {Pct(s)}" : null)}",
                    "Automático", "info"),
            ControlTimelineKind.Effect => new(time, "web", "Efecto",
                $"{c.ActuatorName} · {c.Parameter} {Signed(c.ObservedEffect)} (esperado {Signed(c.ExpectedEffect)})",
                c.Effective == true ? "Con efecto" : "Sin efecto", c.Effective == true ? "success" : "danger"),
            ControlTimelineKind.Delivered => new(time, "out", "Comando", $"{dose} · vence {Clock(c.ExpiresAtUtc)}", null, "info"),
            ControlTimelineKind.Result => new(time, "in", "Resultado",
                c.Status == ControlContract.StatusExecuted
                    ? $"{c.ActuatorName} {Amount(c.ExecutedAmount ?? c.Amount, c.Unit)}"
                    : $"{dose}{(c.ResultError is { } err ? $" · {err}" : null)}",
                StatusText(c.Status), StatusTone(c.Status)),
            ControlTimelineKind.Expired => new(time, "web", "Vencido", dose, StatusText(c.Status), StatusTone(c.Status)),
            ControlTimelineKind.Unconfirmed => new(time, "web", "Sin respuesta", dose, StatusText(c.Status), StatusTone(c.Status)),
            _ => new(time, "web", "Cancelado", dose, StatusText(c.Status), StatusTone(c.Status)),
        };
    }

    private static string DirectionGlyph(string direction) => direction switch
    {
        "in" => "→",
        "out" => "←",
        _ => "•",
    };

    private static string DirectionTitle(string direction) => direction switch
    {
        "in" => "De la Pi a la nube",
        "out" => "De la nube a la Pi",
        _ => "En la nube",
    };
}

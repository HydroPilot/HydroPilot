@page "/simulation"
@attribute [Authorize(Policy = "RequireAssigned")]

@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Simulation

<PageTitle>Simulación</PageTitle>

@* What-if con la misma lógica que la vista Lotes: ventanas y óptimos de corte por GDD y
   rendimiento por plantas × peso × precio. No escribe nada ni toca hardware. *@
<section class="simulation-grid">
    <article class="panel">
        <div class="panel__header">
            <div>
                <h3>Escenario</h3>
            </div>
        </div>

        @if (options is null)
        {
            <div class="alert alert-secondary mb-0">Cargando opciones…</div>
        }
        else
        {
            <div class="sim-form">
                <label class="sim-label">Contexto</label>
                <select class="form-select" @bind="selectedLotId" @bind:after="OnLotChanged">
                    <option value="">— Escenario libre por cultivo —</option>
                    @foreach (var lot in options.Lots)
                    {
                        <option value="@lot.Id">@lot.Name (@lot.CropTypeName — @StatusLabel(lot.StatusName))</option>
                    }
                </select>

                @if (selectedLotId is null)
                {
                    @if (options.Crops.Count > 1)
                    {
                        <label class="sim-label">Cultivo</label>
                        <select class="form-select" @bind="selectedCropId">
                            @foreach (var crop in options.Crops)
                            {
                                <option value="@crop.Id">@crop.Name</option>
                            }
                        </select>
                    }

                    <div class="sim-row">
                        <div>
                            <label class="sim-label">Fecha de siembra</label>
                            <input type="date" class="form-control" @bind="sowingDate" />
                        </div>
                        <div>
                            <label class="sim-label">Cantidad de plantas</label>
                            <input type="number" step="1" min="1" class="form-control" placeholder="ej. 60" @bind="plantCount" />
                        </div>
                    </div>
                    <div class="small text-muted">La siembra puede ser futura, para planificar.</div>
                }
                else
                {
                    <div class="small text-muted mt-1 mb-2">
                        La grilla, plantas, GDD base y etapa se toman del lote (solo lectura).
                    </div>
                }

                <label class="sim-label">Clima del escenario</label>
                <div class="sim-mode-row">
                    <label class="sim-radio"><input type="radio" name="climateMode" checked="@(mode == SimulationClimateMode.Forecast)" @onchange="() => mode = SimulationClimateMode.Forecast" /> Pronóstico</label>
                    <label class="sim-radio"><input type="radio" name="climateMode" checked="@(mode == SimulationClimateMode.Manual)" @onchange="() => mode = SimulationClimateMode.Manual" /> Manual</label>
                </div>

                @if (mode == SimulationClimateMode.Manual)
                {
                    <div class="sim-row">
                        <div>
                            <label class="sim-label">Tmin (°C)</label>
                            <input type="number" step="0.1" class="form-control" @bind="tmin" />
                        </div>
                        <div>
                            <label class="sim-label">Tmax (°C)</label>
                            <input type="number" step="0.1" class="form-control" @bind="tmax" />
                        </div>
                    </div>
                    <div class="small text-muted">@(selectedLotId is null ? "Desde la siembra" : "Desde mañana"), cada día suma el GDD de esas temperaturas.</div>
                }
                else if (selectedLotId is null)
                {
                    <div class="small text-muted">El pronóstico guardado desde la siembra (los días sin pronóstico no suman) y después, el último día. Para fechas lejanas, usá clima manual.</div>
                }

                <hr />

                <label class="sim-label">Estrategia</label>
                <div class="sim-strategy">
                    <label class="sim-radio"><input type="radio" name="strategy" checked="@(strategy == SimulationStrategyKind.MaxBabyLeaf)" @onchange="() => strategy = SimulationStrategyKind.MaxBabyLeaf" /> Máximo Baby Leaf</label>
                    <div class="sim-strategy__goal">
                        <label class="sim-radio"><input type="radio" name="strategy" checked="@(strategy == SimulationStrategyKind.BabyLeafGoal)" @onchange="() => strategy = SimulationStrategyKind.BabyLeafGoal" /> Meta Baby Leaf máxima</label>
                        <input type="number" step="1" min="0" max="100" class="form-control form-control-sm" aria-label="Meta Baby Leaf máxima (%)"
                               @bind="babyLeafGoal" @onfocus="() => strategy = SimulationStrategyKind.BabyLeafGoal" />
                        <span class="small">%</span>
                    </div>
                    <label class="sim-radio"><input type="radio" name="strategy" checked="@(strategy == SimulationStrategyKind.AllConventional)" @onchange="() => strategy = SimulationStrategyKind.AllConventional" /> Todo adulta</label>
                </div>
                <div class="small text-muted">@StrategyHint</div>

                <label class="sim-label">Pesos y precios</label>
                <div class="sim-row">
                    <div>
                        <label class="sim-label">Peso Baby Leaf (g/planta)</label>
                        <input type="number" step="0.1" min="0" class="form-control" @bind="babyLeafGrams" />
                    </div>
                    <div>
                        <label class="sim-label">Peso adulta (g/planta)</label>
                        <input type="number" step="0.1" min="0" class="form-control" @bind="conventionalGrams" />
                    </div>
                </div>
                <div class="sim-row">
                    <div>
                        <label class="sim-label">Precio Baby Leaf ($/kg)</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="babyLeafPrice" />
                    </div>
                    <div>
                        <label class="sim-label">Precio adulta ($/kg)</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="conventionalPrice" />
                    </div>
                </div>

                <hr />

                <label class="sim-label">Gastos del sistema (@options.Parameters.Currency)</label>
                <div class="sim-cost-block">
                    <div class="sim-row">
                        <div>
                            <label class="sim-label">Precio por semilla</label>
                            <input type="number" step="0.01" min="0" class="form-control" @bind="seedPrice" />
                        </div>
                        <div>
                            <label class="sim-label">Precio nutrientes ($/L)</label>
                            <input type="number" step="0.01" min="0" class="form-control" placeholder="Sin definir" @bind="nutrientPrice" />
                        </div>
                    </div>
                </div>

                <div class="sim-actions">
                    <button class="btn btn-success" @onclick="Simulate" disabled="@running">
                        @if (running)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Simular
                    </button>
                </div>
            </div>
        }
    </article>

    <div class="sim-results-col">
        @if (preview is not null && !preview.IsValid)
        {
            <div class="panel">
                <h3>No se pudo simular</h3>
                <div class="alert alert-danger mb-0">
                    <ul class="mb-0">
                        @foreach (var error in preview.ValidationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            </div>
        }
        else if (result is not null)
        {
            <article class="panel panel--simulation">
                <div class="panel__header">
                    <div>
                        <h3>Resultado del escenario</h3>
                        <p class="panel__subtitle">
                            @(result.Context.LotName ?? $"Escenario libre ({result.Context.CropTypeName})") ·
                            siembra @LotFormat.Short(result.Context.SowingDate) · @LotFormat.Plants(result.Context.Plants)
                            @(result.Lot is not null ? "activas" : null)
                        </p>
                    </div>
                    <div class="chip-row">
                        <span class="badge text-bg-info">clima: @ProviderLabel(result.Gdd.ProviderName)</span>
                        @if (result.Gdd.ProviderName != "manual" && result.Gdd.CoveragePercent is { } coverage)
                        {
                            <span class="badge text-bg-light">cobertura @LotFormat.Pct1(coverage)</span>
                        }
                        @if (result.Gdd.Correction is { } correction)
                        {
                            <span class="badge text-bg-light" title="@($"Pronóstico de afuera corregido a la temperatura de adentro (calibrado con {LotFormat.Days(correction.CalibrationDays)})")">pronóstico corregido @LotFormat.SignedNum(correction.OffsetPerDay) GDD/día</span>
                        }
                        @if (result.Gdd.UsedFallback)
                        {
                            <span class="badge text-bg-warning">promedio de respaldo</span>
                        }
                    </div>
                </div>

                <h4 class="sim-section">Ventanas y cortes</h4>
                @if (result.Timeline is { } timeline)
                {
                    <LotCycleTimeline Timeline="timeline" />
                    <div class="small text-muted mt-2">
                        @if (result.Context.SowingDate > result.Today)
                        {
                            <text>Todavía no se sembró (Tbase @LotFormat.Num(result.Gdd.BaseTemperature) °C).</text>
                        }
                        else
                        {
                            <text>GDD hoy: <strong>@LotFormat.Num(result.Gdd.Accumulated)</strong> (Tbase @LotFormat.Num(result.Gdd.BaseTemperature) °C).</text>
                        }
                        Baby Leaf: ventana @LotFormat.Num(timeline.BabyLeafOpens.Gdd)–@LotFormat.Num(timeline.BabyLeafCloses.Gdd), óptimo @LotFormat.Num(timeline.BabyLeafOptimum.Gdd).
                        Adulta: óptimo @LotFormat.Num(timeline.ConventionalOptimum.Gdd), sobremadurez @LotFormat.Num(timeline.Overmaturity.Gdd).
                    </div>
                }
                else
                {
                    <div class="alert alert-warning small mb-0">Sin configuración del cultivo: no se pueden calcular las ventanas ni los cortes.</div>
                }

                @if (result.Timeline is not null)
                {
                    var outlook = result.Outlook;
                    <h4 class="sim-section">Previsión de Baby Leaf y pérdidas</h4>
                    <div class="mini-grid">
                        <div class="mini-card"><span>Baby Leafs en el óptimo</span><strong>@Rate(outlook.AptRate)</strong></div>
                        <div class="mini-card"><span>Pérdidas hasta el corte Baby Leaf</span><strong>@LossRate(outlook.RemainingEarlyLossRate, outlook.History.EarlyLossRate)</strong></div>
                        <div class="mini-card"><span>Pérdidas esperando a adulta</span><strong>@LossRate(outlook.RemainingLateLossRate, outlook.History.LateLossRate)</strong></div>
                    </div>
                    <div class="small text-muted my-2">@OutlookText(outlook, result.Lot is not null)</div>
                    @if (outlook.History.Lots.Count > 0)
                    {
                        <details class="sim-details">
                            <summary>Lotes usados (@outlook.History.Lots.Count)</summary>
                            <div class="table-responsive hp-table-card mt-2">
                                <table class="table table-sm hp-table">
                                    <thead>
                                        <tr>
                                            <th>Lote</th>
                                            <th>Siembra</th>
                                            <th>Baby Leafs</th>
                                            <th>Pérdidas tempranas</th>
                                            <th>Pérdidas tardías</th>
                                            <th>GDD/día</th>
                                            <th>Peso</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var used in outlook.History.Lots)
                                        {
                                            var cycle = used.Outcome;
                                            <tr>
                                                <td>@cycle.Name @(cycle.IsManual ? "(cargado)" : null)</td>
                                                <td>@cycle.SowingDate.ToString("dd/MM/yy", LotFormat.Culture)</td>
                                                <td>@Rate(cycle.AptRate)</td>
                                                <td>@Rate(cycle.EarlyLossRate)</td>
                                                <td>@Rate(cycle.LateLossRate)</td>
                                                <td>@(cycle.AverageDailyGdd is { } gdd ? LotFormat.Num(gdd) : "—")</td>
                                                <td title="@($"temporada {LotFormat.Num(used.SeasonWeight)} × clima {LotFormat.Num(used.ClimateWeight)}")">@LotFormat.Num(used.Weight)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                }

                @if (Chosen is { } chosen)
                {
                    <h4 class="sim-section">Estrategia elegida: @chosen.Name</h4>
                    <div class="small text-muted">@PlantsText(chosen) · @(chosen.Available ? Days(chosen.Costs.CycleDays) + " de ciclo" : "sin fecha")</div>
                    @if (!chosen.Available)
                    {
                        <div class="alert alert-warning small mt-2 mb-0">No se puede calcular: @string.Join(" ", chosen.Warnings)</div>
                    }
                    <div class="mini-grid">
                        <div class="mini-card"><span>Corte Baby Leaf</span><strong>@CutText(chosen.BabyLeafCut)</strong></div>
                        <div class="mini-card"><span>Corte adultas</span><strong>@CutText(chosen.ConventionalCut)</strong></div>
                        <div class="mini-card"><span>Kg</span><strong>@(chosen.TotalKg is { } kg ? LotFormat.KgFine(kg) : "—")</strong></div>
                        <div class="mini-card"><span>Ingresos</span><strong>@Money(chosen.Revenue, result.Reference.Prices.Currency)</strong></div>
                        <div class="mini-card"><span>Gastos del sistema</span><strong>@Money(chosen.Costs.Total, chosen.Costs.CurrencyCode)</strong></div>
                        <div class="mini-card"><span>Margen sobre gastos del sistema</span><strong class="@(chosen.Margin < 0 ? "text-danger" : null)">@Money(chosen.Margin, result.Reference.Prices.Currency)</strong></div>
                    </div>
                    <div class="small text-muted mt-2">
                        Pesos y precios: Baby Leaf @Grams(result.Reference.Weights.BabyLeafGramsPerPlant) · @PricePerKg(result.Reference.Prices.BabyLeafPerKg) ·
                        Adulta @Grams(result.Reference.Weights.ConventionalGramsPerPlant) · @PricePerKg(result.Reference.Prices.ConventionalPerKg)
                        (@(result.Reference.HasScenarioOverrides ? "con cambios del escenario" : "de Ajustes > Parámetros")).
                    </div>

                    <div class="table-responsive hp-table-card mt-3">
                        <table class="table table-sm hp-table">
                            <thead>
                                <tr>
                                    <th>Gasto del sistema</th>
                                    <th>Fórmula</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var component in chosen.Costs.Components)
                                {
                                    <tr>
                                        <td>@component.Name</td>
                                        <td class="small text-muted">@CostFormula(component, chosen.Costs)</td>
                                        <td title="@component.NotCalculableReason">@Money(component.Amount, chosen.Costs.CurrencyCode)</td>
                                    </tr>
                                }
                                <tr class="hp-table__total">
                                    <td><strong>Total</strong></td>
                                    <td class="small text-muted">días del ciclo: de la siembra al último corte</td>
                                    <td><strong>@Money(chosen.Costs.Total, chosen.Costs.CurrencyCode)</strong></td>
                                </tr>
                                <tr>
                                    <td>Costo por kg</td>
                                    <td class="small text-muted">total / kg cosechados</td>
                                    <td>@(chosen.CostPerKg is { } perKg ? $"{LotFormat.Money(perKg, chosen.Costs.CurrencyCode)}/kg" : "—")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                @if (result.Strategies.Count > 1)
                {
                    <h4 class="sim-section">Comparación de estrategias</h4>
                    <div class="table-responsive hp-table-card">
                        <table class="table table-sm hp-table">
                            <thead>
                                <tr>
                                    <th>Estrategia</th>
                                    <th>Corte Baby Leaf</th>
                                    <th>Corte adultas</th>
                                    <th>Días de ciclo</th>
                                    <th>Kg</th>
                                    <th>Margen sobre gastos del sistema</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var strategy in result.Strategies)
                                {
                                    <tr class="@(strategy == Chosen ? "hp-table__row--selected" : null)">
                                        <td>
                                            <strong>@strategy.Name</strong>
                                            @if (strategy == Chosen)
                                            {
                                                <span class="badge text-bg-primary ms-1">elegida</span>
                                            }
                                            @if (strategy == BestStrategy)
                                            {
                                                <span class="badge text-bg-success ms-1">mejor margen</span>
                                            }
                                            <div class="small text-muted">@PlantsText(strategy)</div>
                                        </td>
                                        <td>@CutText(strategy.BabyLeafCut)</td>
                                        <td>@CutText(strategy.ConventionalCut)</td>
                                        <td>@(strategy.Available ? strategy.Costs.CycleDays.ToString() : "—")</td>
                                        <td>@(strategy.TotalKg is { } kg ? LotFormat.KgFine(kg) : "—")</td>
                                        <td class="@(strategy.Margin < 0 ? "text-danger" : null)">@Money(strategy.Margin, result.Reference.Prices.Currency)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (result.Curve is { } curve && result.Timeline is { } curveTimeline)
                {
                    <h4 class="sim-section">GDD acumulado</h4>
                    <LotGddChart Curve="curve" Timeline="curveTimeline"
                                 MeasuredLabel="@(result.Lot is null ? $"{ProviderLabel(result.Gdd.ProviderName)} hasta hoy" : "medido")"
                                 MeasuredSourceLabel="@(result.Lot is null ? ProviderLabel(result.Gdd.ProviderName) : null)"
                                 ProjectedSourceLabel="@ProviderLabel(result.Gdd.ProviderName)" />
                }

                @if (result.Gdd.ForecastFetchedAtUtc is { } fetched)
                {
                    <div class="small text-muted mt-2">Pronóstico obtenido el @fetched.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</div>
                }

                @if (result.Lot is { } lot)
                {
                    <h4 class="sim-section">Contexto del lote (solo lectura)</h4>
                    <div class="mini-grid">
                        <div class="mini-card"><span>Etapa fenológica</span><strong>@(lot.PhenologicalStageName ?? "—")</strong></div>
                        <div class="mini-card"><span>Plantas activas</span><strong>@lot.ActivePlants / @lot.TotalPlants</strong></div>
                    </div>
                    <div class="small text-muted my-2">
                        Cosechadas: @lot.HarvestedPlants · Descartadas: @lot.DiscardedPlants.
                        El escenario usa las plantas activas; la grilla muestra el estado actual del lote.
                    </div>
                    @if (lot.GridRows > 0 && lot.GridColumns > 0)
                    {
                        <LotMap Rows="@lot.GridRows" Columns="@lot.GridColumns" Cells="@lot.Grid" />
                    }
                }

                @if (result.Warnings.Count > 0)
                {
                    <h4 class="sim-section">Advertencias y fuente de los datos</h4>
                    <div class="alert alert-warning small mb-0">
                        <ul class="mb-0">
                            @foreach (var warning in result.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }
            </article>
        }
        else
        {
            <article class="panel">
                <div class="panel__callout">
                    <h3>Proyección simulada</h3>
                    <p>Configurá el escenario y presioná <strong>Simular</strong>.</p>
                </div>
            </article>
        }
    </div>
</section>

<style>
    .sim-form { display: flex; flex-direction: column; gap: 10px; }
    .sim-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: #5b6b7b; margin-top: 4px; }
    .sim-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
    .sim-row > div { display: flex; flex-direction: column; gap: 4px; }
    .sim-mode-row { display: flex; gap: 14px; }
    .sim-radio { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; }
    .sim-cost-block { display: flex; flex-direction: column; gap: 8px; }
    .sim-actions { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
    .sim-results-col { min-width: 0; display: flex; flex-direction: column; gap: 18px; }
    .sim-section { margin: 22px 0 10px; font-size: 1rem; font-weight: 700; }
    .sim-strategy { display: flex; flex-direction: column; gap: 6px; }
    .sim-strategy__goal { display: flex; align-items: center; gap: 8px; }
    .sim-strategy__goal .sim-radio { flex: none; white-space: nowrap; }
    .sim-strategy__goal input[type=number] { flex: none; width: 80px; }
    .sim-radio input { flex: none; margin: 0; }
    .sim-details summary { cursor: pointer; font-size: 0.86rem; color: var(--text-muted); }
</style>

@code {
    [Inject] private SimulationService SimulationSvc { get; set; } = null!;

    /// <summary>Lote a simular desde un enlace (/simulation?lote=ID).</summary>
    [SupplyParameterFromQuery(Name = "lote")]
    public int? LotFromQuery { get; set; }

    private SimulationContextOptions? options;
    private SimulationPreview? preview;
    private SimulationResult? result => preview?.Result;

    private int? selectedLotId;
    private int? selectedCropId;
    private DateOnly? sowingDate;
    private int? plantCount;

    // Por defecto, el clima de Lotes; manual queda para el what-if ("¿y si hace más frío?").
    private SimulationClimateMode mode = SimulationClimateMode.Forecast;
    private decimal? tmin = 16m;
    private decimal? tmax = 26m;

    private SimulationStrategyKind strategy = SimulationStrategyKind.MaxBabyLeaf;
    private decimal? babyLeafGoal;
    private decimal? babyLeafGrams;
    private decimal? conventionalGrams;
    private decimal? babyLeafPrice;
    private decimal? conventionalPrice;

    private decimal? seedPrice = 2.5m;
    private decimal? nutrientPrice;

    private bool running;

    protected override async Task OnInitializedAsync()
    {
        options = await SimulationSvc.GetContextOptionsAsync();
        selectedCropId = options.Crops.FirstOrDefault()?.Id;

        // Pesos y precios precargados con los parámetros del sistema (editables solo para el escenario).
        babyLeafGrams = Trim(options.Parameters.BabyLeafGrams);
        conventionalGrams = Trim(options.Parameters.ConventionalGrams);
        babyLeafPrice = Trim(options.Parameters.BabyLeafPricePerKg);
        conventionalPrice = Trim(options.Parameters.ConventionalPricePerKg);
        nutrientPrice = Trim(options.NutrientPricePerLiter);

        if (options.Lots.Count > 0)
        {
            selectedLotId = options.Lots.Any(l => l.Id == LotFromQuery) ? LotFromQuery : options.Lots[0].Id;
            OnLotChanged();
        }
    }

    /// <summary>
    /// Con un lote: la meta Baby Leaf máxima arranca en la meta del ciclo (y se elige esa estrategia si
    /// la tiene) y las semillas en las plantas del lote.
    /// </summary>
    private void OnLotChanged()
    {
        if (selectedLotId is { } lotId && options?.Lots.FirstOrDefault(l => l.Id == lotId) is { } lot)
        {
            babyLeafGoal = Trim(lot.BabyLeafGoalPercent);
            strategy = babyLeafGoal is null ? SimulationStrategyKind.MaxBabyLeaf : SimulationStrategyKind.BabyLeafGoal;
        }
        else
        {
            selectedCropId ??= options?.Crops.FirstOrDefault()?.Id;
        }
    }

    // Los decimal de la base vienen con su escala (2600.0000, 80.00): se quitan los ceros de más.
    private static decimal? Trim(decimal? value) => value / 1.0000000000000000000000000000m;

    private async Task Simulate()
    {
        running = true;
        try
        {
            preview = await SimulationSvc.PreviewAsync(BuildRequest());
        }
        finally
        {
            running = false;
        }
    }

    private SimulationRequest BuildRequest()
    {
        var system = options?.Parameters;
        // Solo viaja como cambio del escenario lo que difiere del parámetro del sistema.
        static decimal? Override(decimal? value, decimal? systemValue) => value == systemValue ? null : value;

        return new SimulationRequest(
            LotId: selectedLotId,
            CropTypeId: selectedLotId is null ? selectedCropId : null,
            SowingDate: selectedLotId is null ? sowingDate : null,
            PlantCount: selectedLotId is null ? plantCount : null,
            Climate: new SimulationClimateInput(mode, tmin, tmax, ForecastHorizonDays: 7),
            Costs: new SimulationCostsInput(seedPrice, nutrientPrice),
            Harvest: new SimulationHarvestInput(strategy, babyLeafGoal),
            Yield: new SimulationYieldInput(
                Override(babyLeafGrams, system?.BabyLeafGrams),
                Override(conventionalGrams, system?.ConventionalGrams),
                Override(babyLeafPrice, system?.BabyLeafPricePerKg),
                Override(conventionalPrice, system?.ConventionalPricePerKg)));
    }

    /// <summary>La estrategia con mayor margen (si hay al menos dos con margen calculado).</summary>
    private SimulationStrategyOutcome? BestStrategy
    {
        get
        {
            var withMargin = result?.Strategies.Where(s => s.Margin is not null).ToList() ?? [];
            return withMargin.Count > 1 ? withMargin.MaxBy(s => s.Margin) : null;
        }
    }

    private SimulationStrategyOutcome? Chosen =>
        result?.Strategies.FirstOrDefault(s => s.Kind == result.Request.Harvest.Strategy);

    private string StrategyHint => strategy switch
    {
        SimulationStrategyKind.MaxBabyLeaf => "Corta como Baby Leaf todas las que se prevén Baby Leaf en el óptimo; el resto sigue hasta el corte de adultas.",
        SimulationStrategyKind.BabyLeafGoal => "Corta como Baby Leaf hasta ese % de las plantas (por más de que haya más Baby Leafs); el resto sigue hasta el corte de adultas.",
        _ => "Todas siguen hasta el corte de adultas."
    };

    /// <summary>"12 Baby Leafs + 6 adultas · 1 pérdida prevista".</summary>
    private static string PlantsText(SimulationStrategyOutcome s)
    {
        var destinations = new List<string>();
        if (s.BabyLeaf.Plants > 0)
            destinations.Add($"{s.BabyLeaf.Plants} Baby Leaf");
        if (s.Conventional.Plants > 0)
            destinations.Add(LotFormat.Count(s.Conventional.Plants, "adulta", "adultas"));
        var text = destinations.Count > 0 ? string.Join(" + ", destinations) : "Ninguna para cosechar";
        return s.LostPlants > 0
            ? $"{text} · {LotFormat.Count(s.LostPlants, "pérdida prevista", "pérdidas previstas")}"
            : text;
    }

    private static string Rate(decimal? rate) => rate is { } r ? LotFormat.Pct(r * 100m) : "sin datos";

    /// <summary>Pérdidas que faltan; "sin historial" si no hay lotes con ese dato.</summary>
    private static string LossRate(decimal remaining, decimal? history) =>
        history is null ? "sin historial" : LotFormat.Pct1(remaining * 100m);

    private static string Days(int days) => LotFormat.Days(days);

    /// <summary>Fórmula con las cantidades que calculó el sistema (semillas, litros, días).</summary>
    private static string CostFormula(SimulationCostComponent component, SimulationCostBreakdown costs) => component.Name switch
    {
        "Semillas" => $"precio por semilla × {LotFormat.Count(costs.Seeds, "semilla", "semillas")}",
        "Nutrientes" when costs.Usage is { } usage =>
            $"{usage.NutrientLiters.ToString("0.##", LotFormat.Culture)} L de nutrientes × precio por litro · " +
            $"{usage.WaterLiters.ToString("N1", LotFormat.Culture)} L de agua (según plantas vivas y etapa)",
        _ => component.Formula
    };

    /// <summary>De dónde sale la previsión: estado actual del lote, histórico de lotes parecidos o nada.</summary>
    private static string OutlookText(BabyLeafOutlook outlook, bool withLot)
    {
        var history = outlook.History;
        var lots = history.UsedAllLots
            ? $"los {history.Lots.Count} lotes cerrados (ninguno de temporada o clima parecido)"
            : LotFormat.Count(history.Lots.Count, "lote parecido", "lotes parecidos");
        var noEvaluations = withLot && !outlook.LotHasEvaluations
            ? " El lote no tiene evaluaciones de plantas: no se usa su estado actual."
            : string.Empty;

        if (outlook.CurrentAptRate is { } current && outlook.CurrentWeight > 0)
        {
            return history.AptRate is { } past
                ? $"Combina el estado actual del lote ({Rate(current)} de las activas Baby Leaf o candidatas, pesa {Rate(outlook.CurrentWeight)}) con el histórico de {lots} ({Rate(past)})."
                : $"Según el estado actual del lote ({Rate(current)} de las activas Baby Leaf o candidatas); no hay lotes cerrados con datos.";
        }
        if (history.AptRate is not null)
        {
            var notYet = outlook.CurrentAptRate is not null
                ? " El lote todavía no llegó al fin del establecimiento: su estado actual no pesa."
                : noEvaluations;
            return $"Según el histórico de {lots}.{notYet} Las pérdidas son las que faltan según la etapa.";
        }
        return "Sin lotes cerrados con datos ni evaluaciones del lote: se asume que todas llegan a Baby Leaf y sin pérdidas." + noEvaluations;
    }

    private string CutText(SimulationCut? cut)
    {
        if (cut is null)
            return "—";
        if (cut.Date is not { } date)
            return cut.IsOverdue ? "ventana cerrada" : "sin fecha";
        if (cut.IsNow)
            return cut.IsOverdue ? $"ahora ({LotFormat.Short(date)}, pasado de cosecha)" : $"ahora ({LotFormat.Short(date)})";
        var days = GddCalculator.DaysRemaining(result!.Today, date);
        return $"{(cut.IsExtrapolated ? "≈ " : null)}{LotFormat.Short(date)}{(days is > 0 ? $" (en {LotFormat.Days(days.Value)})" : null)}";
    }

    private static string Money(decimal? value, string currency) =>
        value is { } v ? LotFormat.Money(v, currency) : "—";

    private string PricePerKg(decimal? value) =>
        value is { } v ? $"{LotFormat.Money(v, result!.Reference.Prices.Currency)}/kg" : "sin precio";

    private static string Grams(decimal? grams) =>
        grams is { } g ? g.ToString("0.#", LotFormat.Culture) + " g" : "sin peso";

    private static string ProviderLabel(string provider) => provider switch
    {
        "manual" => "clima manual",
        "pronostico" => "pronóstico del clima",
        _ => provider
    };

    private static string StatusLabel(string? status) => status switch
    {
        "ACTIVO" => "Activo",
        "EN_PAUSA" => "En pausa",
        "COSECHADO" => "Cosechado",
        "DESCARTADO" => "Descartado",
        _ => status ?? "Sin estado"
    };
}

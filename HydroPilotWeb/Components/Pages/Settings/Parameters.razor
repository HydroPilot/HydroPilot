@page "/settings/parametros"
@attribute [Authorize(Policy = "RequireAssigned")]
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Anomalies
@using HydroPilotWeb.Services.SensorFaults
@using HydroPilotWeb.Components.Lotes
@inject SystemParametersService ParametersService
@inject AnomalyQueryService AnomalyQuery
@inject AuthenticationStateProvider AuthState

<PageTitle>Parámetros del sistema - HydroPilot</PageTitle>

@* Parámetros globales: valen para todo el sistema, no para un lote. Todos los ven; solo
   Administrador y Productor los editan. *@
<section class="settings-layout">
    <div class="settings-stack">
        <article class="panel settings-panel">
            <div class="settings-panel__header">
                <div>
                    <span class="settings-eyebrow">Rendimiento</span>
                    <h3>Pesos y precios de referencia</h3>
                    <p class="panel__subtitle">
                        Con estos valores se estima el rendimiento de cada lote: plantas × peso promedio × precio por kg.
                        Aplican a todos los lotes.
                    </p>
                </div>
                @if (!canEdit)
                {
                    <span class="settings-readonly-badge">Solo lectura</span>
                }
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger py-2 small">@error</div>
            }
            else if (current is null)
            {
                <div class="d-flex justify-content-center my-4">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
                </div>
            }
            else
            {
                <YieldParametersEditor Current="current" ReadOnly="!canEdit" Saving="saving" Errors="errors"
                                       SavedMessage="@savedMessage" OnSave="SaveAsync" />
            }
        </article>

        <article class="panel settings-panel">
            <div class="settings-panel__header">
                <div>
                    <span class="settings-eyebrow">Gastos del sistema</span>
                    <h3>Precio de nutrientes</h3>
                    <p class="panel__subtitle">
                        Con este precio Simulación calcula el gasto en nutrientes: litros que se consumen
                        según las plantas vivas y la etapa × precio por litro.
                    </p>
                </div>
                @if (!canEdit)
                {
                    <span class="settings-readonly-badge">Solo lectura</span>
                }
            </div>

            @if (current is not null)
            {
                <div class="lot-editor">
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-nutrient-price">Precio nutrientes (@current.Currency por litro)</label>
                        <input id="param-nutrient-price" type="number" class="form-control" min="0" step="0.01"
                               @bind="nutrientPrice" @bind:event="oninput" disabled="@(!canEdit)" placeholder="Sin definir" />
                    </div>
                </div>

                @if (nutrientErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 mt-3 mb-0 small">
                        <ul class="mb-0">
                            @foreach (var nutrientError in nutrientErrors)
                            {
                                <li>@nutrientError</li>
                            }
                        </ul>
                    </div>
                }

                @if (canEdit)
                {
                    <div class="lot-editor__actions">
                        @if (!string.IsNullOrEmpty(nutrientSavedMessage))
                        {
                            <span class="lot-muted mt-0 me-auto">@nutrientSavedMessage</span>
                        }
                        <button class="btn btn-success btn-sm" @onclick="SaveNutrientPriceAsync" disabled="@savingNutrient">
                            @(savingNutrient ? "Guardando…" : "Guardar precio")
                        </button>
                    </div>
                }
            }
        </article>

        <article class="panel settings-panel">
            <div class="settings-panel__header">
                <div>
                    <span class="settings-eyebrow">Lotes</span>
                    <h3>Trasplante a Adultas</h3>
                    <p class="panel__subtitle">
                        Desde el GDD de decisión se proponen las plantas que pasan del circuito denso al de Adultas. La
                        separación dice cuánto lugar ocupa cada una; el trasplante cuesta la hora de trabajo ÷ plantas por hora.
                    </p>
                </div>
                @if (!canEdit)
                {
                    <span class="settings-readonly-badge">Solo lectura</span>
                }
            </div>

            @if (transplant is not null)
            {
                <div class="lot-editor">
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-bl-spacing">Separación Baby Leaf (cm)</label>
                        <input id="param-bl-spacing" type="number" class="form-control" min="0" step="0.5" @bind="transplant.BabyLeafSpacingCm" disabled="@(!canEdit)" />
                    </div>
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-adult-spacing">Separación Adulta (cm)</label>
                        <input id="param-adult-spacing" type="number" class="form-control" min="0" step="0.5" @bind="transplant.AdultSpacingCm" disabled="@(!canEdit)" />
                    </div>
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-decision-gdd">GDD de decisión</label>
                        <input id="param-decision-gdd" type="number" class="form-control" min="0" step="5" @bind="transplant.DecisionGdd" disabled="@(!canEdit)" />
                    </div>
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-stress">Días de estrés</label>
                        <input id="param-stress" type="number" class="form-control" min="0" step="1" @bind="transplant.StressDays" disabled="@(!canEdit)" />
                    </div>
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-plants-hour">Plantas por hora (operario)</label>
                        <input id="param-plants-hour" type="number" class="form-control" min="1" step="10" @bind="transplant.PlantsPerHour" disabled="@(!canEdit)" />
                    </div>
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-labor-cost">Costo de la hora (@(current?.Currency ?? "ARS"))</label>
                        <input id="param-labor-cost" type="number" class="form-control" min="0" step="100" @bind="transplant.LaborCostPerHour" disabled="@(!canEdit)" />
                    </div>
                    <div class="lot-editor__field">
                        <label class="form-label mb-1" for="param-max-size">Tamaño máximo Baby Leaf (× ideal)</label>
                        <input id="param-max-size" type="number" class="form-control" min="1" step="0.05" @bind="transplant.MaxSizeFactor" disabled="@(!canEdit)" />
                    </div>
                </div>
                <p class="lot-muted mt-2 mb-0">
                    Trasplante: @LotFormat.Money(TransplantRow.ToParameters(transplant).CostPerPlant, current?.Currency ?? "ARS") por planta.
                </p>

                @if (transplantErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 mt-3 mb-0 small">
                        <ul class="mb-0">
                            @foreach (var transplantError in transplantErrors)
                            {
                                <li>@transplantError</li>
                            }
                        </ul>
                    </div>
                }

                @if (canEdit)
                {
                    <div class="lot-editor__actions">
                        @if (!string.IsNullOrEmpty(transplantSavedMessage))
                        {
                            <span class="lot-muted mt-0 me-auto">@transplantSavedMessage</span>
                        }
                        <button class="btn btn-success btn-sm" @onclick="SaveTransplantAsync" disabled="@savingTransplant">
                            @(savingTransplant ? "Guardando…" : "Guardar trasplante")
                        </button>
                    </div>
                }
            }
        </article>

        <article class="panel settings-panel">
            <div class="settings-panel__header">
                <div>
                    <span class="settings-eyebrow">Sensores</span>
                    <h3>Chequeo de sensores</h3>
                    <p class="panel__subtitle">
                        Cada cuántos días se chequea (calibra) cada tipo de sensor. El próximo chequeo es la última
                        calibración + estos días; se ve en Invernadero, donde también se registra ("Calibrado hoy").
                        Vacío = sin chequeo programado.
                    </p>
                </div>
                @if (!canEdit)
                {
                    <span class="settings-readonly-badge">Solo lectura</span>
                }
            </div>

            @if (checkIntervals is not null)
            {
                <div class="lot-editor">
                    @foreach (var interval in checkIntervals)
                    {
                        var type = interval.Key;
                        <div class="lot-editor__field">
                            <label class="form-label mb-1" for="@($"param-check-{type}")">@type (días)</label>
                            <input id="@($"param-check-{type}")" type="number" class="form-control" min="1" max="@SystemParametersService.MaxSensorCheckDays" step="1"
                                   value="@interval.Value" @onchange="e => SetCheckDays(type, e.Value?.ToString())"
                                   disabled="@(!canEdit)" placeholder="Sin definir" />
                        </div>
                    }
                </div>

                @if (checkErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 mt-3 mb-0 small">
                        <ul class="mb-0">
                            @foreach (var checkError in checkErrors)
                            {
                                <li>@checkError</li>
                            }
                        </ul>
                    </div>
                }

                @if (canEdit)
                {
                    <div class="lot-editor__actions">
                        @if (!string.IsNullOrEmpty(checkSavedMessage))
                        {
                            <span class="lot-muted mt-0 me-auto">@checkSavedMessage</span>
                        }
                        <button class="btn btn-success btn-sm" @onclick="SaveCheckIntervalsAsync" disabled="@savingChecks">
                            @(savingChecks ? "Guardando…" : "Guardar chequeos")
                        </button>
                    </div>
                }
            }
        </article>

        <article class="panel settings-panel">
            <div class="settings-panel__header">
                <div>
                    <span class="settings-eyebrow">Sensores</span>
                    <h3>Errores de sensores</h3>
                    <p class="panel__subtitle">
                        Una lectura fuera del rango normal o un salto mayor al máximo entre dos lecturas seguidas avisa; en
                        pH y CE además frena el control automático de ese parámetro hasta marcarlo como resuelto en
                        Optimización. Un sensor sin lecturas por más de 2 intervalos del nodo avisa y frena hasta que vuelven.
                    </p>
                </div>
                @if (!canEdit)
                {
                    <span class="settings-readonly-badge">Solo lectura</span>
                }
            </div>

            @if (faultLimits is not null)
            {
                <div class="table-responsive">
                    <table class="table table-sm hp-table mb-0 settings-fault-table">
                        <thead>
                            <tr>
                                <th>Sensor</th>
                                <th>Mínimo normal</th>
                                <th>Máximo normal</th>
                                <th>Salto máximo</th>
                                <th>Si falla</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var limit in faultLimits)
                            {
                                var unit = SensorFaultRules.Unit(limit.SensorType).Trim();
                                <tr>
                                    <td>@limit.SensorType@(unit.Length > 0 ? $" ({unit})" : null)</td>
                                    <td><input type="number" step="any" class="form-control form-control-sm" aria-label="@($"Mínimo normal de {limit.SensorType}")"
                                               @bind="limit.Min" @bind:after="ClearFaultMessage" disabled="@(!canEdit)" /></td>
                                    <td><input type="number" step="any" class="form-control form-control-sm" aria-label="@($"Máximo normal de {limit.SensorType}")"
                                               @bind="limit.Max" @bind:after="ClearFaultMessage" disabled="@(!canEdit)" /></td>
                                    <td><input type="number" step="any" class="form-control form-control-sm" aria-label="@($"Salto máximo de {limit.SensorType}")"
                                               @bind="limit.Jump" @bind:after="ClearFaultMessage" disabled="@(!canEdit)" /></td>
                                    <td>
                                        @if (SensorFaultRules.BlocksControl(limit.SensorType))
                                        {
                                            <span class="lot-chip lot-chip--danger">Avisa y frena el control de @limit.SensorType</span>
                                        }
                                        else
                                        {
                                            <span class="lot-chip lot-chip--warning">Solo avisa</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (faultErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 mt-3 mb-0 small">
                        <ul class="mb-0">
                            @foreach (var faultError in faultErrors)
                            {
                                <li>@faultError</li>
                            }
                        </ul>
                    </div>
                }

                @if (canEdit)
                {
                    <div class="lot-editor__actions">
                        @if (!string.IsNullOrEmpty(faultSavedMessage))
                        {
                            <span class="lot-muted mt-0 me-auto">@faultSavedMessage</span>
                        }
                        <button class="btn btn-success btn-sm" @onclick="SaveFaultLimitsAsync" disabled="@savingFaults">
                            @(savingFaults ? "Guardando…" : "Guardar límites")
                        </button>
                    </div>
                }
            }
        </article>

        <article class="panel settings-panel">
            <div class="settings-panel__header">
                <div>
                    <span class="settings-eyebrow">Anomalías</span>
                    <h3>Reglas de episodios fuera de rango</h3>
                    <p class="panel__subtitle">
                        Cuándo una lectura abre un episodio (se ven en Optimización y como alertas): una lectura fuera de
                        la banda lo pone en seguimiento; las lecturas seguidas indicadas lo abren y avisan. Se cierra solo
                        cuando las lecturas vuelven a la banda.
                    </p>
                </div>
                <span class="settings-readonly-badge">Solo lectura</span>
            </div>

            @if (anomalyRules.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm hp-table mb-0">
                        <thead>
                            <tr>
                                <th>Regla</th>
                                <th>Banda</th>
                                <th class="text-end">Lecturas seguidas para abrir</th>
                                <th class="text-end">Espera entre episodios</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in anomalyRules)
                            {
                                <tr>
                                    <td>@rule.Name</td>
                                    <td>
                                        @if (rule.Bands.Count == 0)
                                        {
                                            <span class="text-muted">Sin umbral aprobado</span>
                                        }
                                        @foreach (var band in rule.Bands)
                                        {
                                            <div>@(band.Stage is { } stage ? $"{stage}: " : null)@BandText(band)</div>
                                        }
                                    </td>
                                    <td class="text-end">@rule.ConsecutiveToOpen</td>
                                    <td class="text-end">@rule.CooldownMinutes min</td>
                                    <td>
                                        <span class="lot-chip lot-chip--@(rule.Active ? "success" : "muted")">@(rule.Active ? "Activa" : "No se evalúa")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private YieldParameters? current;
    private System.Security.Claims.ClaimsPrincipal user = new();
    private bool canEdit;
    private bool saving;
    private IReadOnlyList<string> errors = [];
    private string? savedMessage;
    private string? error;

    private decimal? nutrientPrice;
    private bool savingNutrient;
    private IReadOnlyList<string> nutrientErrors = [];
    private string? nutrientSavedMessage;

    private IReadOnlyList<AnomalyRuleOverview> anomalyRules = [];

    // Trasplante a Adultas (editable en el formulario; se valida al guardar).
    private sealed class TransplantRow
    {
        public decimal BabyLeafSpacingCm { get; set; }
        public decimal AdultSpacingCm { get; set; }
        public decimal DecisionGdd { get; set; }
        public int PlantsPerHour { get; set; }
        public decimal LaborCostPerHour { get; set; }
        public int StressDays { get; set; }
        public decimal MaxSizeFactor { get; set; }

        public static TransplantRow From(TransplantParameters p) => new()
        {
            BabyLeafSpacingCm = p.BabyLeafSpacingCm, AdultSpacingCm = p.AdultSpacingCm, DecisionGdd = p.DecisionGdd,
            PlantsPerHour = p.PlantsPerHour, LaborCostPerHour = p.LaborCostPerHour, StressDays = p.StressDays,
            MaxSizeFactor = p.MaxSizeFactor,
        };

        public static TransplantParameters ToParameters(TransplantRow r) => new(
            r.BabyLeafSpacingCm, r.AdultSpacingCm, r.DecisionGdd, r.PlantsPerHour, r.LaborCostPerHour, r.StressDays, r.MaxSizeFactor);
    }

    private TransplantRow? transplant;
    private bool savingTransplant;
    private IReadOnlyList<string> transplantErrors = [];
    private string? transplantSavedMessage;

    // Rango normal y salto máximo por tipo de sensor (errores de sensores).
    private sealed class FaultLimitRow
    {
        public required string SensorType { get; init; }
        public decimal? Min { get; set; }
        public decimal? Max { get; set; }
        public decimal? Jump { get; set; }
    }

    private List<FaultLimitRow>? faultLimits;
    private bool savingFaults;
    private IReadOnlyList<string> faultErrors = [];
    private string? faultSavedMessage;

    // Días entre chequeos por tipo de sensor, en el orden del catálogo (null = sin chequeo).
    private Dictionary<string, int?>? checkIntervals;
    private bool savingChecks;
    private IReadOnlyList<string> checkErrors = [];
    private string? checkSavedMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = (await AuthState.GetAuthenticationStateAsync()).User;
            canEdit = SystemParametersService.CanEdit(user);
            current = await ParametersService.GetYieldParametersAsync();
            nutrientPrice = Trim(await ParametersService.GetNutrientPricePerLiterAsync());
            transplant = TransplantRow.From(await ParametersService.GetTransplantParametersAsync());
            await LoadCheckIntervalsAsync();
            await LoadFaultLimitsAsync();
            anomalyRules = await AnomalyQuery.GetRulesAsync();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar los parámetros: {ex.Message}";
        }
    }

    /// <summary>"5,5–6,5 (objetivo 6)".</summary>
    private static string BandText(AnomalyRuleBand band) =>
        $"{Num(band.Min)}–{Num(band.Max)}" + (band.Target is { } target ? $" (objetivo {LotFormat.Num(target)})" : string.Empty);

    private static string Num(decimal? value) => value is { } v ? LotFormat.Num(v) : "—";

    private async Task LoadCheckIntervalsAsync() =>
        checkIntervals = (await ParametersService.GetSensorCheckIntervalsAsync()).ToDictionary(i => i.SensorType, i => i.Days);

    // Vacío o no numérico = sin chequeo programado.
    private void SetCheckDays(string type, string? value)
    {
        checkIntervals![type] = int.TryParse(value, out var days) ? days : null;
        checkSavedMessage = null;
    }

    private async Task SaveCheckIntervalsAsync()
    {
        savingChecks = true;
        checkSavedMessage = null;
        try
        {
            var result = await ParametersService.UpdateSensorCheckIntervalsAsync(
                checkIntervals!.Select(i => new SensorCheckInterval(i.Key, i.Value)).ToList(), user);
            checkErrors = result.Errors;
            if (result.Succeeded)
            {
                await LoadCheckIntervalsAsync();
                checkSavedMessage = "Chequeos guardados.";
            }
        }
        catch (Exception ex)
        {
            checkErrors = [$"No se pudieron guardar los chequeos: {ex.Message}"];
        }
        finally
        {
            savingChecks = false;
        }
    }

    private async Task LoadFaultLimitsAsync() =>
        faultLimits = (await ParametersService.GetSensorFaultLimitsAsync())
            .Select(l => new FaultLimitRow { SensorType = l.SensorType, Min = Trim(l.Min), Max = Trim(l.Max), Jump = Trim(l.Jump) })
            .ToList();

    private void ClearFaultMessage() => faultSavedMessage = null;

    private async Task SaveFaultLimitsAsync()
    {
        var missing = faultLimits!.Where(l => l.Min is null || l.Max is null || l.Jump is null).Select(l => l.SensorType).ToList();
        if (missing.Count > 0)
        {
            faultErrors = [$"Completá el rango y el salto de {string.Join(", ", missing)}."];
            return;
        }

        savingFaults = true;
        faultSavedMessage = null;
        try
        {
            var result = await ParametersService.UpdateSensorFaultLimitsAsync(
                faultLimits!.Select(l => new SensorFaultLimits(l.SensorType, l.Min!.Value, l.Max!.Value, l.Jump!.Value)).ToList(), user);
            faultErrors = result.Errors;
            if (result.Succeeded)
            {
                await LoadFaultLimitsAsync();
                faultSavedMessage = "Límites guardados.";
            }
        }
        catch (Exception ex)
        {
            faultErrors = [$"No se pudieron guardar los límites: {ex.Message}"];
        }
        finally
        {
            savingFaults = false;
        }
    }

    // Sin ceros de más ("5.00" → "5").
    private static decimal? Trim(decimal? value) => value / 1.0000000000000000000000000000m;

    private async Task SaveTransplantAsync()
    {
        if (transplant is null)
            return;
        savingTransplant = true;
        transplantSavedMessage = null;
        try
        {
            var result = await ParametersService.UpdateTransplantParametersAsync(TransplantRow.ToParameters(transplant), user);
            transplantErrors = result.Errors;
            if (result.Succeeded)
            {
                transplant = TransplantRow.From(await ParametersService.GetTransplantParametersAsync());
                transplantSavedMessage = "Trasplante guardado.";
            }
        }
        catch (Exception ex)
        {
            transplantErrors = [$"No se pudo guardar el trasplante: {ex.Message}"];
        }
        finally
        {
            savingTransplant = false;
        }
    }

    private async Task SaveNutrientPriceAsync()
    {
        savingNutrient = true;
        nutrientSavedMessage = null;
        try
        {
            var result = await ParametersService.UpdateNutrientPricePerLiterAsync(nutrientPrice, user);
            nutrientErrors = result.Errors;
            if (result.Succeeded)
            {
                nutrientPrice = Trim(await ParametersService.GetNutrientPricePerLiterAsync());
                nutrientSavedMessage = "Precio guardado.";
            }
        }
        catch (Exception ex)
        {
            nutrientErrors = [$"No se pudo guardar el precio: {ex.Message}"];
        }
        finally
        {
            savingNutrient = false;
        }
    }

    private async Task SaveAsync(YieldReferenceInput input)
    {
        saving = true;
        savedMessage = null;
        try
        {
            var result = await ParametersService.UpdateYieldParametersAsync(input, user);
            errors = result.Errors;
            if (result.Succeeded)
            {
                current = await ParametersService.GetYieldParametersAsync();
                savedMessage = "Parámetros guardados.";
            }
        }
        catch (Exception ex)
        {
            errors = [$"No se pudieron guardar los parámetros: {ex.Message}"];
        }
        finally
        {
            saving = false;
        }
    }
}

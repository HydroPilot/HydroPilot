@page "/optimization"
@attribute [Authorize(Policy = "RequireAssigned")]
@rendermode InteractiveServer

@using System.Security.Claims
@using HydroPilotWeb.Components.Lotes
@using HydroPilotWeb.Models.Optimization
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Optimization
@inject OptimizationService OptimizationService
@inject AuthenticationStateProvider AuthState
@inject ILogger<Optimization> Logger

<PageTitle>Optimización</PageTitle>

@* Qué hacer en el lote para ganar más o gastar menos: una card por problema, con su $ y su fecha.
   La lógica está en OptimizationRules / OptimizationService (notas/ux/logica-vista-optimizacion.md). *@

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (lots is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (lots.Count == 0)
{
    <div class="alert alert-info">No hay lotes en curso.</div>
}
else
{
    <div class="opt-view">
        <div class="lot-toolbar">
            <label class="visually-hidden" for="opt-lot">Lote</label>
            <select id="opt-lot" class="form-select lot-toolbar__select" @bind="selectedLotId" @bind:after="LoadAsync">
                @foreach (var lot in lots)
                {
                    <option value="@lot.Id">@lot.Name · @StatusLabel(lot.StatusName)</option>
                }
            </select>
            @if (loading)
            {
                <span class="lot-loading" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Calculando…
                </span>
            }
            @if (view is { Missing.Count: > 0 } withMissing)
            {
                <a class="lot-chip lot-chip--warning opt-missing" href="settings/parametros"
                   title="Sin estos valores algunos impactos quedan sin calcular.">
                    Sin definir: @string.Join(", ", withMissing.Missing)
                </a>
            }
        </div>

        @if (view is not null)
        {
            <div class="@(loading ? "lot-layout--loading" : null)">
                @* --- Números del lote --- *@
                <section class="opt-kpis">
                    <article class="opt-kpi">
                        <span class="opt-kpi__label">Pendientes</span>
                        <strong class="opt-kpi__value">@view.Kpis.Pending</strong>
                        <span class="opt-kpi__sub @(view.Kpis.HighPriorityPending > 0 ? "opt-tone--danger" : null)">
                            @(view.Kpis.HighPriorityPending == 1 ? "1 prioridad alta" : $"{view.Kpis.HighPriorityPending} prioridad alta")
                        </span>
                    </article>
                    <article class="opt-kpi opt-kpi--capture">
                        <span class="opt-kpi__label">A capturar</span>
                        <strong class="opt-kpi__value">@MoneyOrDash(view.Kpis.ToCapture)</strong>
                        <span class="opt-kpi__sub">cortes y estrategia</span>
                    </article>
                    <article class="opt-kpi opt-kpi--saving">
                        <span class="opt-kpi__label">Ahorro posible</span>
                        <strong class="opt-kpi__value">@(view.Kpis.WeeklySaving is { } saving ? "≈ " + Money(saving) : "—")</strong>
                        <span class="opt-kpi__sub">nutrientes por semana</span>
                    </article>
                    <article class="opt-kpi opt-kpi--done">
                        <span class="opt-kpi__label">Logrado</span>
                        <strong class="opt-kpi__value">@MoneyOrDash(view.Kpis.Achieved)</strong>
                        <span class="opt-kpi__sub">@(view.Kpis.Done == 1 ? "1 cumplida" : $"{view.Kpis.Done} cumplidas")</span>
                    </article>
                </section>

                @* --- Recomendaciones activas --- *@
                @if (view.Active.Count == 0)
                {
                    <div class="opt-empty">
                        <strong>Sin recomendaciones</strong>
                        <span>No hay nada que corregir en este lote.</span>
                    </div>
                }
                else
                {
                    <section class="opt-grid">
                        @foreach (var rec in view.Active)
                        {
                            var type = TypeStyle(rec.Type);
                            <article class="opt-rec opt-rec--@PriorityClass(rec.Priority)" style="--opt-type: @type.Color;">
                                <header class="opt-rec__head">
                                    <span class="opt-rec__type">@type.Label</span>
                                    @if (rec.Status == OptimizationContractStatus.Accepted)
                                    {
                                        <span class="lot-chip lot-chip--success">En curso</span>
                                    }
                                    else if (rec.Priority == OptimizationContractPriority.High)
                                    {
                                        <span class="lot-chip lot-chip--danger">Prioridad alta</span>
                                    }
                                </header>

                                <h3 class="opt-rec__title">@rec.Title</h3>

                                <div class="opt-rec__impact">
                                    <strong class="opt-tone--@ImpactTone(rec.ImpactKind)">@ImpactText(rec)</strong>
                                    <span>@ImpactLabel(rec.ImpactKind)</span>
                                </div>

                                @if (rec.Figures.Count > 0)
                                {
                                    <dl class="opt-rec__figures">
                                        @foreach (var figure in rec.Figures)
                                        {
                                            <div>
                                                <dt>@figure.Label</dt>
                                                <dd>@FigureText(figure)</dd>
                                            </div>
                                        }
                                    </dl>
                                }

                                <footer class="opt-rec__foot">
                                    @if (rec.DueDate is { } due)
                                    {
                                        <span class="lot-chip lot-chip--@DueTone(due)">@DueText(due)</span>
                                    }
                                    <a class="lot-link" href="@LinkFor(rec)">@LinkLabel(rec.Type)</a>
                                </footer>

                                @if (rec.Status == OptimizationContractStatus.Pending)
                                {
                                    <div class="opt-rec__actions">
                                        <button type="button" class="btn btn-success btn-sm" disabled="@busy"
                                                @onclick="() => AcceptAsync(rec.Id)">Aceptar</button>
                                        <select class="form-select form-select-sm opt-reason" aria-label="Motivo de descarte"
                                                value="@ReasonFor(rec.Id)" @onchange="e => SetReason(rec.Id, e.Value?.ToString())">
                                            <option value="">Motivo…</option>
                                            @foreach (var reason in OptimizationContract.DiscardReasons)
                                            {
                                                <option value="@reason">@reason</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-sm opt-discard" disabled="@(busy || !CanDiscard(rec.Id))"
                                                @onclick="() => DiscardAsync(rec.Id)">Descartar</button>
                                        @if (ReasonFor(rec.Id) == OtherReason)
                                        {
                                            <input class="form-control form-control-sm opt-reason-text" placeholder="¿Por qué?"
                                                   value="@OtherFor(rec.Id)" @oninput="e => SetOther(rec.Id, e.Value?.ToString())" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="opt-rec__decided">Aceptada el @Day(rec.DecidedAtUtc)@(rec.DecidedBy is { } by ? $" · {by}" : null)</p>
                                }

                                @if (decisionError is not null && decisionErrorRec == rec.Id)
                                {
                                    <div class="alert alert-danger py-1 px-2 mb-0 small">@decisionError</div>
                                }
                            </article>
                        }
                    </section>
                }

                @* --- Historial --- *@
                @if (view.History.Count > 0)
                {
                    <h3 class="lot-panel-title opt-history-title">Historial</h3>
                    <div class="table-responsive hp-table-card">
                        <table class="table table-sm hp-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Recomendación</th>
                                    <th>Estado</th>
                                    <th class="text-end">Impacto</th>
                                    <th class="text-end">Logrado</th>
                                    <th>Motivo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rec in view.History)
                                {
                                    <tr>
                                        <td>@Day(rec.ClosedAtUtc ?? rec.DecidedAtUtc ?? rec.GeneratedAtUtc)</td>
                                        <td>@rec.Title</td>
                                        <td><span class="lot-chip lot-chip--@StatusTone(rec.Status)">@StatusText(rec.Status)</span></td>
                                        <td class="text-end">@(rec.Impact is { } impact ? ImpactText(rec) : "—")</td>
                                        <td class="text-end">@MoneyOrDash(rec.RealizedAmount)</td>
                                        <td class="small text-muted">@rec.DecisionNote</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>Lote a abrir desde un enlace (/optimization?lote=ID).</summary>
    [SupplyParameterFromQuery(Name = "lote")]
    public int? LotFromQuery { get; set; }

    private const string OtherReason = "Otro";

    private IReadOnlyList<LotOption>? lots;
    private int? selectedLotId;
    private OptimizationViewDto? view;
    private string? error;
    private string? decisionError;
    private int? decisionErrorRec;
    private bool loading;
    private bool busy;
    private string? currentUser;
    private int loadVersion;

    private readonly Dictionary<int, string> reasons = new();
    private readonly Dictionary<int, string> others = new();

    private string Currency => view?.Currency ?? "ARS";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            currentUser = auth.User.Identity?.Name ?? auth.User.FindFirst(ClaimTypes.Email)?.Value;
            lots = await OptimizationService.GetLotOptionsAsync();
            selectedLotId = lots.Any(l => l.Id == LotFromQuery) ? LotFromQuery : lots.FirstOrDefault()?.Id;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar Optimización: {ex.Message}";
            Logger.LogError(ex, "Optimization init failed");
            lots ??= [];
        }
    }

    private async Task LoadAsync()
    {
        if (selectedLotId is not { } lotId)
            return;

        var version = ++loadVersion;
        loading = true;
        decisionError = null;
        try
        {
            var result = await OptimizationService.GetViewAsync(lotId);
            if (version == loadVersion)
            {
                view = result;
                error = null;
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudieron calcular las recomendaciones: {ex.Message}";
            Logger.LogError(ex, "Optimization load failed for lot {LotId}", lotId);
        }
        finally
        {
            if (version == loadVersion)
                loading = false;
        }
    }

    private async Task AcceptAsync(int id) =>
        await DecideAsync(id, () => OptimizationService.AcceptAsync(id, currentUser));

    private async Task DiscardAsync(int id)
    {
        var reason = ReasonFor(id) == OtherReason ? $"{OtherReason}: {OtherFor(id).Trim()}" : ReasonFor(id);
        await DecideAsync(id, () => OptimizationService.DiscardAsync(id, reason, currentUser));
    }

    private async Task DecideAsync(int id, Func<Task<DecisionResult>> decide)
    {
        busy = true;
        decisionError = null;
        decisionErrorRec = id;
        try
        {
            var result = await decide();
            if (!result.Succeeded)
            {
                decisionError = result.Message;
                return;
            }
            reasons.Remove(id);
            others.Remove(id);
            if (selectedLotId is { } lotId)
                view = await OptimizationService.GetViewAsync(lotId, evaluate: false);
        }
        catch (Exception ex)
        {
            decisionError = $"No se pudo guardar: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private string ReasonFor(int id) => reasons.GetValueOrDefault(id) ?? string.Empty;
    private string OtherFor(int id) => others.GetValueOrDefault(id) ?? string.Empty;
    private void SetReason(int id, string? value) => reasons[id] = value ?? string.Empty;
    private void SetOther(int id, string? value) => others[id] = value ?? string.Empty;

    private bool CanDiscard(int id) =>
        ReasonFor(id) is { Length: > 0 } reason && (reason != OtherReason || !string.IsNullOrWhiteSpace(OtherFor(id)));

    // --- Formato ---

    private string Money(decimal value) => LotFormat.Money(value, Currency);

    private string MoneyOrDash(decimal? value) => value is { } v ? Money(v) : "—";

    private static string Day(DateTime? utc) => utc is { } value ? LotFormat.Day(DateOnly.FromDateTime(value.ToLocalTime())) : "—";

    private string ImpactText(RecommendationDto rec) => rec.Impact is { } impact
        ? (rec.IsEstimate ? "≈ " : string.Empty) + Money(impact) + (rec.ImpactKind == OptimizationImpactKind.Saving ? " /semana" : string.Empty)
        : "Sin precio";

    private static string ImpactLabel(string? kind) => kind switch
    {
        OptimizationImpactKind.Saving => "ahorro (supuesto en duda)",
        OptimizationImpactKind.Risk => "en riesgo",
        _ => "a capturar",
    };

    private static string ImpactTone(string? kind) => kind switch
    {
        OptimizationImpactKind.Saving => "saving",
        OptimizationImpactKind.Risk => "danger",
        _ => "capture",
    };

    private string FigureText(RecommendationFigure figure) => figure.Kind switch
    {
        "money" => MoneyOrDash(figure.Value),
        "moneyPerKg" => figure.Value is { } price ? Money(price) + "/kg" : "sin precio",
        "plants" => figure.Value is { } count ? count.ToString("0", LotFormat.Culture) : "—",
        "pct" => figure.Value is { } pct ? LotFormat.Pct1(pct) : "—",
        "date" => figure.Date is { } date ? LotFormat.Day(date) : "sin fecha",
        "number" => figure.Value is { } number
            ? number.ToString("0.##", LotFormat.Culture) + (figure.Unit is { } unit ? " " + unit : string.Empty)
            : "—",
        _ => figure.Text ?? "—",
    };

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private string DueText(DateOnly due)
    {
        var days = due.DayNumber - Today.DayNumber;
        return days switch
        {
            < 0 => $"Venció el {LotFormat.Day(due)}",
            0 => "Hoy",
            1 => "Hasta mañana",
            _ => $"Hasta el {LotFormat.Day(due)} · {LotFormat.Days(days)}",
        };
    }

    private string DueTone(DateOnly due) => (due.DayNumber - Today.DayNumber) switch
    {
        <= 1 => "danger",
        <= 3 => "warning",
        _ => "info",
    };

    private string LinkFor(RecommendationDto rec) => rec.Type switch
    {
        OptimizationContractType.HarvestStrategy => $"simulation?lote={rec.LotId}",
        OptimizationContractType.NutrientOverspend or OptimizationContractType.SolutionRisk => $"control?lote={rec.LotId}",
        _ => $"lotes?lote={rec.LotId}",
    };

    private static string LinkLabel(string type) => type switch
    {
        OptimizationContractType.HarvestStrategy => "Ver en Simulación",
        OptimizationContractType.NutrientOverspend or OptimizationContractType.SolutionRisk => "Ver en Control",
        _ => "Ver en Lotes",
    };

    private sealed record TypeInfo(string Label, string Color);

    private static readonly string BabyLeafColor = CommercialStagePalette.ForStage(CommercialStageNames.BabyLeafApta).Background;
    private static readonly string ConventionalColor = CommercialStagePalette.ForStage(CommercialStageNames.CosechaConvencional).Background;

    private static TypeInfo TypeStyle(string type) => type switch
    {
        OptimizationContractType.BabyLeafCut => new("Corte Baby Leaf", BabyLeafColor),
        OptimizationContractType.ConventionalCut => new("Corte convencional", ConventionalColor),
        OptimizationContractType.HarvestStrategy => new("Estrategia", "#16a34a"),
        OptimizationContractType.NutrientOverspend => new("Nutrientes", "#0e9384"),
        OptimizationContractType.SolutionRisk => new("Solución", "#d64545"),
        OptimizationContractType.CycleGoals => new("Metas", "#e8a33d"),
        _ => new("Anterior", "#94a3b8"),
    };

    private static string PriorityClass(string priority) => priority switch
    {
        OptimizationContractPriority.High => "high",
        OptimizationContractPriority.Medium => "medium",
        _ => "low",
    };

    private static string StatusText(string status) => status switch
    {
        OptimizationContractStatus.Done => "Cumplida",
        OptimizationContractStatus.Missed => "No cumplida",
        OptimizationContractStatus.Discarded => "Descartada",
        OptimizationContractStatus.Expired => "Ya no aplica",
        OptimizationContractStatus.Accepted => "Aceptada",
        OptimizationContractStatus.Blocked => "Bloqueada",
        _ => "Pendiente",
    };

    private static string StatusTone(string status) => status switch
    {
        OptimizationContractStatus.Done => "success",
        OptimizationContractStatus.Missed => "danger",
        OptimizationContractStatus.Accepted => "info",
        _ => "neutral",
    };

    private static string StatusLabel(string? status) => status switch
    {
        "ACTIVO" => "Activo",
        "EN_PAUSA" => "En pausa",
        _ => status ?? "Sin estado"
    };
}

    }

    .action-card__warning {
        color: #f79009 !important;
        font-size: 12px !important;
    }

    .action-card__hint {
        color: #70869a !important;
        font-size: 12px !important;
    }

    .action-card__footer {
        padding: 16px 20px;
        background: rgba(0, 0, 0, 0.15);
        border-top: 1px solid var(--border-color, #223044);
    }

    .confirm-box {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .confirm-box span {
        font-size: 13px;

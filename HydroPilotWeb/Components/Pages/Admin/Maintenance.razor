@code {
    private DatabaseSummaryDto? _summary;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private bool _showClearConfirm = false;
    private bool _showTestEmailConfirm = false;
    private string? _feedbackMessage;
    private bool _isSuccess = true;

    // Flujo diario de un lote (antes era un botón en la vista Lotes).
    private IReadOnlyList<LotOption> _flowLots = [];
    private int? _flowLotId;
    private DateOnly? _flowDate;

    // Clima: antes eran switches en Forecasting.
    private bool _weatherFetchEnabled;
    private bool _weatherLimitDisabled;
    private DateTime? _lastWeatherFetchUtc;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
        if (SimulationEnvironment.Enabled)
            _simulationSeededAt = await SimulationEnvironment.SeededAtAsync();
    }

    private async Task LoadSummaryAsync()
    {
        _isLoading = true;
        try
        {
            _summary = await MaintenanceService.GetDatabaseSummaryAsync();

            // Lotes del flujo diario: se recargan con las métricas (limpiar o recrear el demo los cambia).
            _flowLots = (await LotOverview.GetLotOptionsAsync()).Where(l => l.IsOperational).ToList();
            if (_flowLotId is null || _flowLots.All(l => l.Id != _flowLotId))
                _flowLotId = _flowLots.FirstOrDefault()?.Id;

            _weatherFetchEnabled = await Settings.GetBoolAsync(SettingsService.WeatherFetchEnabledKey);
            _weatherLimitDisabled = await Settings.GetBoolAsync(SettingsService.WeatherDailyLimitDisabledKey);
            _lastWeatherFetchUtc = await Weather.GetLastForecastFetchAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Error al cargar métricas de la base de datos: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExecuteDailyFlowAsync()
    {
        if (_flowLotId is not { } lotId)
            return;

        _isProcessing = true;
        try
        {
            var result = await DailyFlow.RunDailyAsync(lotId, _flowDate);
            if (result is null)
            {
                _feedbackMessage = "El lote no existe.";
                _isSuccess = false;
            }
            else
            {
                var lotName = _flowLots.FirstOrDefault(l => l.Id == lotId)?.Name ?? $"Lote #{lotId}";
                var when = _flowDate is { } date ? $" al {date:dd/MM/yyyy}" : string.Empty;
                _feedbackMessage =
                    $"Flujo diario de {lotName}{when}: {result.PlantsEvaluated} plantas activas evaluadas, " +
                    $"{result.PlantsChanged} cambiaron de estado (GDD {result.GddAccumulated:0.#})." +
                    (result.Warnings.Count > 0 ? " " + string.Join(" ", result.Warnings) : string.Empty);
                _isSuccess = true;
            }
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Error al ejecutar el flujo diario: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task OnWeatherFetchChangedAsync(ChangeEventArgs e)
    {
        _weatherFetchEnabled = e.Value is true;
        await SaveWeatherSettingAsync(SettingsService.WeatherFetchEnabledKey, _weatherFetchEnabled,
            _weatherFetchEnabled ? "Sincronización climática diaria activada." : "Sincronización climática diaria desactivada.");
    }

    private async Task OnWeatherLimitChangedAsync(ChangeEventArgs e)
    {
        _weatherLimitDisabled = e.Value is true;
        await SaveWeatherSettingAsync(SettingsService.WeatherDailyLimitDisabledKey, _weatherLimitDisabled,
            _weatherLimitDisabled ? "Límite diario de clima desactivado." : "Límite diario de clima activado (una consulta por día).");
    }

    private async Task SaveWeatherSettingAsync(string key, bool value, string message)
    {
        try
        {
            await Settings.SetBoolAsync(key, value);
            _feedbackMessage = message;
            _isSuccess = true;
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"No se pudo guardar la configuración del clima: {ex.Message}";
            _isSuccess = false;
        }
    }

    private async Task ExecuteClearDataAsync()
    {
        _isProcessing = true;
        _showClearConfirm = false;
        try
        {
            var result = await MaintenanceService.ClearTransactionalDataAsync();
            _feedbackMessage = result.Message;
            _isSuccess = result.Success;
            await LoadSummaryAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Error al ejecutar limpieza: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool _showSimulationConfirm;
    private bool _regenerating;
    private DateTime? _simulationSeededAt;

    private async Task ExecuteRegenerateSimulationAsync()
    {
        _isProcessing = true;
        _regenerating = true;
        _showSimulationConfirm = false;
        try
        {
            var result = await SimulationEnvironment.RegenerateAsync();
            _feedbackMessage = result.Message;
            _isSuccess = result.Succeeded;
            _simulationSeededAt = await SimulationEnvironment.SeededAtAsync();
            await LoadSummaryAsync();
        }
        finally
        {
            _isProcessing = false;
            _regenerating = false;
        }
    }

    private async Task ExecuteRecreateDemoLotAsync()
    {
        _isProcessing = true;
        try
        {
            var result = await MaintenanceService.RecreateDemoLotAsync();
            _feedbackMessage = result.Message;
            _isSuccess = result.Success;
            await LoadSummaryAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Error al recrear lote demo: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ExecuteSendTestEmailAsync()
    {
        _isProcessing = true;
        _showTestEmailConfirm = false;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var uid = int.TryParse(authState.User.FindFirst("user_id")?.Value, out var id) ? id : 1;
            var result = await NotificationService.SendTestEmailToAllUsersAsync(uid);
            _feedbackMessage = result.Message;
            _isSuccess = result.Success;
            await LoadSummaryAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Error al encolar emails de prueba: {ex.Message}";
            _isSuccess = false;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    // Diagnóstico de Visión Artificial y Baby Leaf Score
    private string? _visionFileName;
    private byte[]? _visionFileBytes;
    private string? _visionPreviewDataUrl;
    private bool _isVisionProcessing = false;
    private string? _visionError;
    private BabyLeafEvaluationResult? _visionEvalResult;

    private double _testGdd = 280.0;
    private double _testGddMin = 250.0;
    private double _testGddMax = 450.0;
    private double _testCmPerPx = 0.045;
    private double? _testPrevArea;
    private double? _testPrevGdd;

    private async Task HandleVisionFileSelected(InputFileChangeEventArgs e)
    {
        _visionError = null;
        _visionEvalResult = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 25 * 1024 * 1024)
        {
            _visionError = "La imagen supera el límite permitido de 25 MB.";
            return;
        }

        try
        {
            _visionFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _visionFileBytes = ms.ToArray();

            var base64 = Convert.ToBase64String(_visionFileBytes);
            _visionPreviewDataUrl = $"data:{file.ContentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            _visionError = $"Error al leer el archivo: {ex.Message}";
        }
    }

    private async Task ExecuteVisionEvaluationAsync()
    {
        if (_visionFileBytes == null || _visionFileBytes.Length == 0)
        {
            _visionError = "Seleccione una imagen primero.";
            return;
        }

        _isVisionProcessing = true;
        _visionError = null;

        try
        {
            using var ms = new MemoryStream(_visionFileBytes);
            _visionEvalResult = await BabyLeafPipeline.EvaluatePlantAsync(
                imageStream: ms,
                accumulatedGdd: _testGdd,
                gddMin: _testGddMin,
                gddMax: _testGddMax,
                cmPerPixel: _testCmPerPx,
                previousAreaCm2: _testPrevArea,
                previousGdd: _testPrevGdd);
        }
        catch (Exception ex)
        {
            _visionError = $"Error en la evaluación: {ex.Message}";
        }
        finally
        {
            _isVisionProcessing = false;
        }
    }

    private static string GetBabyLeafStatusBadgeClass(BabyLeafStageStatus status) => status switch
    {
        BabyLeafStageStatus.Apta => "badge-success text-white",
        BabyLeafStageStatus.Candidata => "badge-warning text-dark",
        BabyLeafStageStatus.NoApta => "badge-danger text-white",
        BabyLeafStageStatus.NoBabyLeaf => "badge-secondary text-white",
        _ => "badge-info text-white"
    };

    private static string GetBabyLeafStatusLabel(BabyLeafStageStatus status) => status switch
    {
        BabyLeafStageStatus.Apta => "Apta Baby Leaf",
        BabyLeafStageStatus.Candidata => "Candidata",
        BabyLeafStageStatus.NoApta => "No Apta",
        BabyLeafStageStatus.NoBabyLeaf => "No Baby Leaf (Fuera de ventana)",
        _ => "Sin decisión (Repetir captura)"
    };

    private static string GetProgressBarClass(double score)
    {
        if (score >= 70.0) return "bg-success";
        if (score >= 45.0) return "bg-warning";
        return "bg-danger";
    }

    private static string GetNpkBadgeClass(string? npkClass) => npkClass switch
    {
        "FN" => "badge-success text-white",
        "-N" => "badge-warning text-dark",
        "-P" => "badge-info text-white",
        "-K" => "badge-danger text-white",
        _ => "badge-secondary text-white"
    };

    private static string GetHealthBadgeClass(string? healthClass) => healthClass switch
    {
        "Healthy" => "badge-success text-white",
        _ => "badge-danger text-white"
    };
}

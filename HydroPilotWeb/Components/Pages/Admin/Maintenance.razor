@page "/admin/mantenimiento"
@attribute [Authorize(Policy = "RequireAdministrador")]
@using HydroPilotWeb.Services.Admin
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Notifications
@using HydroPilotWeb.Services.SimulationEnvironment
@inject AdminMaintenanceService MaintenanceService
@inject SimulationEnvironmentService SimulationEnvironment
@inject NotificationService NotificationService
@inject LotOverviewService LotOverview
@inject LotDailyFlowService DailyFlow
@inject SettingsService Settings
@inject WeatherService Weather
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Mantenimiento de base de datos - HydroPilot</PageTitle>

<div class="maintenance-page">
    <div class="page-header">
        <div class="page-header__content">
            <h2>Mantenimiento y Base de Datos</h2>
            <p>Herramientas de depuración, limpieza transaccional y restauración de datos demo</p>
        </div>
        <button class="btn btn-secondary" @onclick="LoadSummaryAsync" disabled="@_isLoading">
            <span>↻</span> Actualizar métricas
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="alert @(_isSuccess ? "alert-success" : "alert-danger")">
            <span>@_feedbackMessage</span>
            <button class="alert-close" @onclick="() => _feedbackMessage = null">✕</button>
        </div>
    }

    <!-- Panel de métricas actuales de la base de datos -->
    <div class="panel">
        <div class="panel-header">
            <h3>Estado actual de la base de datos</h3>
            <span class="badge badge-info">Zona horaria: @(_summary?.GreenhouseTimeZone ?? "Cargando...")</span>
        </div>

        @if (_isLoading && _summary == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Consultando métricas de la base de datos...</p>
            </div>
        }
        else if (_summary != null)
        {
            <div class="metrics-grid">
                <div class="metric-card">
                    <span class="metric-card__label">Usuarios</span>
                    <strong class="metric-card__value">@_summary.UsersCount</strong>
                    <small class="metric-card__hint">Cuentas y roles registrados</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Invernaderos / Nodos</span>
                    <strong class="metric-card__value">@_summary.GreenhousesCount / @_summary.NodesCount</strong>
                    <small class="metric-card__hint">@_summary.SensorsCount sensores activos</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Lotes registrados</span>
                    <strong class="metric-card__value">@_summary.LotsCount</strong>
                    <small class="metric-card__hint">@_summary.ActiveLotsCount activos, @_summary.ClosedLotsCount cosechados</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Plantas en grillas</span>
                    <strong class="metric-card__value">@_summary.PlantsCount</strong>
                    <small class="metric-card__hint">Posiciones evaluadas en lotes</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Lecturas de telemetría</span>
                    <strong class="metric-card__value">@_summary.SensorReadingsCount</strong>
                    <small class="metric-card__hint">En @_summary.TelemetryBatchesCount batches v2</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Predicciones persistidas</span>
                    <strong class="metric-card__value">@_summary.PredictionsCount</strong>
                    <small class="metric-card__hint">Snapshots de forecasting</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Episodios de anomalía</span>
                    <strong class="metric-card__value">@_summary.AnomalyEventsCount</strong>
                    <small class="metric-card__hint">Eventos detectados por reglas</small>
                </div>
            </div>
        }
    </div>

    <!-- Panel de acciones de mantenimiento -->
    <div class="actions-grid">
        <div class="action-card action-card--danger">
            <div class="action-card__body">
                <div class="action-card__icon">🗑</div>
                <div>
                    <h4>Limpiar datos transaccionales (Mock)</h4>
                    <p>
                        Elimina todas las lecturas de telemetría, predicciones, lotes de prueba, plantas,
                        y eventos de anomalías.
                    </p>
                    <p class="action-card__warning">
                        <strong>Preserva intactos:</strong> usuarios, contraseñas, roles, configuraciones,
                        catálogos de cultivo, invernaderos, nodos y sensores.
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                @if (_showClearConfirm)
                {
                    <div class="confirm-box">
                        <span>¿Confirmar eliminación de todos los datos transaccionales?</span>
                        <div class="confirm-box__buttons">
                            <button class="btn btn-danger" @onclick="ExecuteClearDataAsync" disabled="@_isProcessing">
                                Sí, eliminar datos
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _showClearConfirm = false" disabled="@_isProcessing">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="() => _showClearConfirm = true" disabled="@_isProcessing">
                        Limpiar datos de prueba
                    </button>
                }
            </div>
        </div>

        @if (SimulationEnvironment.Enabled)
        {
            <div class="action-card action-card--primary">
                <div class="action-card__body">
                    <div class="action-card__icon">🧪</div>
                    <div>
                        <h4>Entorno de simulación</h4>
                        <p>
                            Historial de @SimulationEnvironment.Options.HistoryMonths meses generado
                            @(_simulationSeededAt is { } seeded ? $"el {seeded.ToLocalTime():dd/MM/yyyy HH:mm}" : "—").
                            Regenerarlo lo lleva hasta hoy.
                        </p>
                        <p class="action-card__warning">
                            <strong>Reemplaza</strong> lotes, telemetría, control, anomalías, notificaciones
                            y precios de esta base (tarda unos minutos).
                        </p>
                    </div>
                </div>
                <div class="action-card__footer">
                    @if (_showSimulationConfirm)
                    {
                        <div class="confirm-box">
                            <span>¿Regenerar el historial de simulación?</span>
                            <div class="confirm-box__buttons">
                                <button class="btn btn-danger" @onclick="ExecuteRegenerateSimulationAsync" disabled="@_isProcessing">Sí, regenerar</button>
                                <button class="btn btn-secondary" @onclick="() => _showSimulationConfirm = false" disabled="@_isProcessing">Cancelar</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="() => _showSimulationConfirm = true" disabled="@_isProcessing">
                            @(_isProcessing && _regenerating ? "Generando…" : "Regenerar historial")
                        </button>
                    }
                </div>
            </div>
        }

        <div class="action-card action-card--primary">
            <div class="action-card__body">
                <div class="action-card__icon">🌱</div>
                <div>
                    <h4>Recrear Lote Demo 01</h4>
                    <p>
                        Crea un lote demo activo (<strong>Lote Demo 01</strong>) con grilla de 6x10 posiciones,
                        etapas comerciales representativas (Baby Leafs, candidatas, en desarrollo y riesgo)
                        y asignación del nodo <code>rpi-inv-01</code>.
                    </p>
                    <p class="action-card__hint">
                        Si ya existía un Lote Demo 01 previo, se reemplaza limpiamente con datos demo frescos.
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                <button class="btn btn-primary" @onclick="ExecuteRecreateDemoLotAsync" disabled="@_isProcessing">
                    Recrear Lote Demo 01
                </button>
            </div>
        </div>

        <div class="action-card action-card--flow">
            <div class="action-card__body">
                <div class="action-card__icon">🔄</div>
                <div>
                    <h4>Ejecutar flujo diario de un lote</h4>
                    <p>
                        Reevalúa las plantas activas del lote con los GDD hasta la fecha elegida: etapa fenológica,
                        estado comercial (Baby Leaf, candidata, en desarrollo o riesgo) y estado predominante del lote.
                        Los cambios quedan en el historial de cada planta; las cosechadas y descartadas no se tocan.
                    </p>
                    <p class="action-card__warning">
                        <strong>Escribe en la base:</strong> con una fecha futura las plantas quedan adelantadas a ese día
                        (sirve para simular el avance del cultivo en la demo).
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                @if (_flowLots.Count == 0)
                {
                    <span class="action-card__hint">No hay lotes activos para evaluar.</span>
                }
                else
                {
                    <div class="flow-form">
                        <label class="flow-form__field">
                            <span>Lote</span>
                            <select class="form-select" @bind="_flowLotId" disabled="@_isProcessing">
                                @foreach (var lot in _flowLots)
                                {
                                    <option value="@lot.Id">@lot.Name</option>
                                }
                            </select>
                        </label>
                        <div class="flow-form__field">
                            <span>Evaluar al (vacío = hoy)</span>
                            <HpDateInput @bind-Value="_flowDate" Disabled="_isProcessing" Placeholder="Hoy" AriaLabel="Evaluar al"
                                         Class="flow-form__date" />
                        </div>
                        <button class="btn btn-primary" @onclick="ExecuteDailyFlowAsync" disabled="@(_isProcessing || _flowLotId is null)">
                            Ejecutar flujo diario
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="action-card action-card--weather">
            <div class="action-card__body">
                <div class="action-card__icon">☁</div>
                <div>
                    <h4>Clima (OpenWeather)</h4>
                    <p>
                        El pronóstico de 7 días alimenta la proyección de GDD: las fechas de las ventanas y de los
                        cortes en Lotes. Sin pronóstico, la proyección usa el promedio de los últimos días medidos.
                    </p>
                    @if (!Weather.IsConfigured)
                    {
                        <p class="action-card__warning">
                            <strong>Sin API key de OpenWeather</strong> (<code>Weather:ApiKey</code>): no se descarga nada.
                        </p>
                    }
                    <p class="action-card__hint">
                        @(_lastWeatherFetchUtc is { } fetched
                            ? $"Último pronóstico cargado: {fetched.ToLocalTime():dd/MM/yyyy HH:mm}"
                            : "Todavía no hay ningún pronóstico cargado.")
                    </p>
                </div>
            </div>
            <div class="action-card__footer weather-switches">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="weather-daily" checked="@_weatherFetchEnabled"
                           @onchange="OnWeatherFetchChangedAsync" disabled="@_isProcessing" />
                    <label class="form-check-label" for="weather-daily">
                        Sincronización diaria
                        <small>Descarga el pronóstico todos los días a las 06:00 UTC. Apagada, solo se pide al abrir un lote al que le faltan días.</small>
                    </label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="weather-no-limit" checked="@_weatherLimitDisabled"
                           @onchange="OnWeatherLimitChangedAsync" disabled="@_isProcessing" />
                    <label class="form-check-label" for="weather-no-limit">
                        Sin límite diario
                        <small>Vuelve a consultar la API cada vez que falta pronóstico (gasta más llamadas). Apagado: una vez por día.</small>
                    </label>
                </div>
            </div>
        </div>

        <div class="action-card action-card--email">
            <div class="action-card__body">
                <div class="action-card__icon">✉</div>
                <div>
                    <h4>Prueba de despacho de Email (Gmail)</h4>
                    <p>
                        Encola un correo de prueba a todos los usuarios registrados con email válido para comprobar
                        la conectividad con el servidor SMTP de Gmail y el despachador de segundo plano.
                    </p>
                    <p class="action-card__hint">
                        Este envío ignora la configuración de email desactivado por ser una prueba explícita de administración.
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                @if (_showTestEmailConfirm)
                {
                    <div class="confirm-box">
                        <span>¿Enviar email de prueba a todos los usuarios?</span>
                        <div class="confirm-box__buttons">
                            <button class="btn btn-primary" @onclick="ExecuteSendTestEmailAsync" disabled="@_isProcessing">
                                Sí, enviar prueba
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _showTestEmailConfirm = false" disabled="@_isProcessing">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="() => _showTestEmailConfirm = true" disabled="@_isProcessing">
                        Enviar email de prueba
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .maintenance-page {
        padding: 24px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h2 {
        margin: 0 0 6px;
        font-size: 24px;
        font-weight: 700;
        color: var(--text-main, #e4ecf6);
    }

    .page-header p {
        margin: 0;
        color: var(--text-muted, #70869a);
        font-size: 14px;
    }

    .panel {
        background: var(--card-bg, #182230);
        border: 1px solid var(--border-color, #223044);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 24px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .panel-header h3 {
        margin: 0;
        font-size: 18px;
        color: var(--text-main, #e4ecf6);
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
    }

    .metric-card {
        background: var(--card-inner-bg, #1e2b3d);
        border: 1px solid var(--border-inner, #29384e);
        border-radius: 10px;
        padding: 16px;
        display: flex;
        flex-direction: column;
    }

    .metric-card__label {
        font-size: 12px;
        color: var(--text-muted, #8ea1b4);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .metric-card__value {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-main, #ffffff);
        margin-bottom: 4px;
    }


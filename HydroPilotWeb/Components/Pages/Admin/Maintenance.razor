@page "/admin/mantenimiento"
@attribute [Authorize(Policy = "RequireAdministrador")]
@using HydroPilotWeb.Services.Admin
@using HydroPilotWeb.Services.Lotes
@using HydroPilotWeb.Services.Notifications
@using HydroPilotWeb.Services.SimulationEnvironment
@using HydroPilotWeb.Services.Vision
@inject AdminMaintenanceService MaintenanceService
@inject SimulationEnvironmentService SimulationEnvironment
@inject NotificationService NotificationService
@inject LotOverviewService LotOverview
@inject LotDailyFlowService DailyFlow
@inject SettingsService Settings
@inject WeatherService Weather
@inject BabyLeafPipelineService BabyLeafPipeline
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Mantenimiento de base de datos - HydroPilot</PageTitle>

<div class="maintenance-page">
    <div class="page-header">
        <div class="page-header__content">
            <h2>Mantenimiento y Base de Datos</h2>
            <p>Herramientas de depuración, limpieza transaccional y restauración de datos demo</p>
        </div>
        <button class="btn btn-secondary" @onclick="LoadSummaryAsync" disabled="@_isLoading">
            <span>↻</span> Actualizar métricas
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="alert @(_isSuccess ? "alert-success" : "alert-danger")">
            <span>@_feedbackMessage</span>
            <button class="alert-close" @onclick="() => _feedbackMessage = null">✕</button>
        </div>
    }

    <!-- Panel de métricas actuales de la base de datos -->
    <div class="panel">
        <div class="panel-header">
            <h3>Estado actual de la base de datos</h3>
            <span class="badge badge-info">Zona horaria: @(_summary?.GreenhouseTimeZone ?? "Cargando...")</span>
        </div>

        @if (_isLoading && _summary == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Consultando métricas de la base de datos...</p>
            </div>
        }
        else if (_summary != null)
        {
            <div class="metrics-grid">
                <div class="metric-card">
                    <span class="metric-card__label">Usuarios</span>
                    <strong class="metric-card__value">@_summary.UsersCount</strong>
                    <small class="metric-card__hint">Cuentas y roles registrados</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Invernaderos / Nodos</span>
                    <strong class="metric-card__value">@_summary.GreenhousesCount / @_summary.NodesCount</strong>
                    <small class="metric-card__hint">@_summary.SensorsCount sensores activos</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Lotes registrados</span>
                    <strong class="metric-card__value">@_summary.LotsCount</strong>
                    <small class="metric-card__hint">@_summary.ActiveLotsCount activos, @_summary.ClosedLotsCount cosechados</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Plantas en grillas</span>
                    <strong class="metric-card__value">@_summary.PlantsCount</strong>
                    <small class="metric-card__hint">Posiciones evaluadas en lotes</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Lecturas de telemetría</span>
                    <strong class="metric-card__value">@_summary.SensorReadingsCount</strong>
                    <small class="metric-card__hint">En @_summary.TelemetryBatchesCount batches v2</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Predicciones persistidas</span>
                    <strong class="metric-card__value">@_summary.PredictionsCount</strong>
                    <small class="metric-card__hint">Snapshots de forecasting</small>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Episodios de anomalía</span>
                    <strong class="metric-card__value">@_summary.AnomalyEventsCount</strong>
                    <small class="metric-card__hint">Eventos detectados por reglas</small>
                </div>
            </div>
        }
    </div>

    <!-- Panel de acciones de mantenimiento -->
    <div class="actions-grid">
        <div class="action-card action-card--danger">
            <div class="action-card__body">
                <div class="action-card__icon">🗑</div>
                <div>
                    <h4>Limpiar datos transaccionales (Mock)</h4>
                    <p>
                        Elimina todas las lecturas de telemetría, predicciones, lotes de prueba, plantas,
                        y eventos de anomalías.
                    </p>
                    <p class="action-card__warning">
                        <strong>Preserva intactos:</strong> usuarios, contraseñas, roles, configuraciones,
                        catálogos de cultivo, invernaderos, nodos y sensores.
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                @if (_showClearConfirm)
                {
                    <div class="confirm-box">
                        <span>¿Confirmar eliminación de todos los datos transaccionales?</span>
                        <div class="confirm-box__buttons">
                            <button class="btn btn-danger" @onclick="ExecuteClearDataAsync" disabled="@_isProcessing">
                                Sí, eliminar datos
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _showClearConfirm = false" disabled="@_isProcessing">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="() => _showClearConfirm = true" disabled="@_isProcessing">
                        Limpiar datos de prueba
                    </button>
                }
            </div>
        </div>

        @if (SimulationEnvironment.Enabled)
        {
            <div class="action-card action-card--primary">
                <div class="action-card__body">
                    <div class="action-card__icon">🧪</div>
                    <div>
                        <h4>Entorno de simulación</h4>
                        <p>
                            Historial de @SimulationEnvironment.Options.HistoryMonths meses generado
                            @(_simulationSeededAt is { } seeded ? $"el {seeded.ToLocalTime():dd/MM/yyyy HH:mm}" : "—").
                            Regenerarlo lo lleva hasta hoy.
                        </p>
                        <p class="action-card__warning">
                            <strong>Reemplaza</strong> lotes, telemetría, control, anomalías, notificaciones
                            y precios de esta base (tarda unos minutos).
                        </p>
                    </div>
                </div>
                <div class="action-card__footer">
                    @if (_showSimulationConfirm)
                    {
                        <div class="confirm-box">
                            <span>¿Regenerar el historial de simulación?</span>
                            <div class="confirm-box__buttons">
                                <button class="btn btn-danger" @onclick="ExecuteRegenerateSimulationAsync" disabled="@_isProcessing">Sí, regenerar</button>
                                <button class="btn btn-secondary" @onclick="() => _showSimulationConfirm = false" disabled="@_isProcessing">Cancelar</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="() => _showSimulationConfirm = true" disabled="@_isProcessing">
                            @(_isProcessing && _regenerating ? "Generando…" : "Regenerar historial")
                        </button>
                    }
                </div>
            </div>
        }

        <div class="action-card action-card--primary">
            <div class="action-card__body">
                <div class="action-card__icon">🌱</div>
                <div>
                    <h4>Recrear Lote Demo 01</h4>
                    <p>
                        Crea un lote demo activo (<strong>Lote Demo 01</strong>) con grilla de 6x10 posiciones,
                        etapas comerciales representativas (Baby Leafs, candidatas, en desarrollo y riesgo)
                        y asignación del nodo <code>rpi-inv-01</code>.
                    </p>
                    <p class="action-card__hint">
                        Si ya existía un Lote Demo 01 previo, se reemplaza limpiamente con datos demo frescos.
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                <button class="btn btn-primary" @onclick="ExecuteRecreateDemoLotAsync" disabled="@_isProcessing">
                    Recrear Lote Demo 01
                </button>
            </div>
        </div>

        <div class="action-card action-card--flow">
            <div class="action-card__body">
                <div class="action-card__icon">🔄</div>
                <div>
                    <h4>Ejecutar flujo diario de un lote</h4>
                    <p>
                        Reevalúa las plantas activas del lote con los GDD hasta la fecha elegida: etapa fenológica,
                        estado comercial (Baby Leaf, candidata, en desarrollo o riesgo) y estado predominante del lote.
                        Los cambios quedan en el historial de cada planta; las cosechadas y descartadas no se tocan.
                    </p>
                    <p class="action-card__warning">
                        <strong>Escribe en la base:</strong> con una fecha futura las plantas quedan adelantadas a ese día
                        (sirve para simular el avance del cultivo en la demo).
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                @if (_flowLots.Count == 0)
                {
                    <span class="action-card__hint">No hay lotes activos para evaluar.</span>
                }
                else
                {
                    <div class="flow-form">
                        <label class="flow-form__field">
                            <span>Lote</span>
                            <select class="form-select" @bind="_flowLotId" disabled="@_isProcessing">
                                @foreach (var lot in _flowLots)
                                {
                                    <option value="@lot.Id">@lot.Name</option>
                                }
                            </select>
                        </label>
                        <div class="flow-form__field">
                            <span>Evaluar al (vacío = hoy)</span>
                            <HpDateInput @bind-Value="_flowDate" Disabled="_isProcessing" Placeholder="Hoy" AriaLabel="Evaluar al"
                                         Class="flow-form__date" />
                        </div>
                        <button class="btn btn-primary" @onclick="ExecuteDailyFlowAsync" disabled="@(_isProcessing || _flowLotId is null)">
                            Ejecutar flujo diario
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="action-card action-card--weather">
            <div class="action-card__body">
                <div class="action-card__icon">☁</div>
                <div>
                    <h4>Clima (OpenWeather)</h4>
                    <p>
                        El pronóstico de 7 días alimenta la proyección de GDD: las fechas de las ventanas y de los
                        cortes en Lotes. Sin pronóstico, la proyección usa el promedio de los últimos días medidos.
                    </p>
                    @if (!Weather.IsConfigured)
                    {
                        <p class="action-card__warning">
                            <strong>Sin API key de OpenWeather</strong> (<code>Weather:ApiKey</code>): no se descarga nada.
                        </p>
                    }
                    <p class="action-card__hint">
                        @(_lastWeatherFetchUtc is { } fetched
                            ? $"Último pronóstico cargado: {fetched.ToLocalTime():dd/MM/yyyy HH:mm}"
                            : "Todavía no hay ningún pronóstico cargado.")
                    </p>
                </div>
            </div>
            <div class="action-card__footer weather-switches">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="weather-daily" checked="@_weatherFetchEnabled"
                           @onchange="OnWeatherFetchChangedAsync" disabled="@_isProcessing" />
                    <label class="form-check-label" for="weather-daily">
                        Sincronización diaria
                        <small>Descarga el pronóstico todos los días a las 06:00 UTC. Apagada, solo se pide al abrir un lote al que le faltan días.</small>
                    </label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="weather-no-limit" checked="@_weatherLimitDisabled"
                           @onchange="OnWeatherLimitChangedAsync" disabled="@_isProcessing" />
                    <label class="form-check-label" for="weather-no-limit">
                        Sin límite diario
                        <small>Vuelve a consultar la API cada vez que falta pronóstico (gasta más llamadas). Apagado: una vez por día.</small>
                    </label>
                </div>
            </div>
        </div>

        <div class="action-card action-card--email">
            <div class="action-card__body">
                <div class="action-card__icon">✉</div>
                <div>
                    <h4>Prueba de despacho de Email (Gmail)</h4>
                    <p>
                        Encola un correo de prueba a todos los usuarios registrados con email válido para comprobar
                        la conectividad con el servidor SMTP de Gmail y el despachador de segundo plano.
                    </p>
                    <p class="action-card__hint">
                        Este envío ignora la configuración de email desactivado por ser una prueba explícita de administración.
                    </p>
                </div>
            </div>
            <div class="action-card__footer">
                @if (_showTestEmailConfirm)
                {
                    <div class="confirm-box">
                        <span>¿Enviar email de prueba a todos los usuarios?</span>
                        <div class="confirm-box__buttons">
                            <button class="btn btn-primary" @onclick="ExecuteSendTestEmailAsync" disabled="@_isProcessing">
                                Sí, enviar prueba
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _showTestEmailConfirm = false" disabled="@_isProcessing">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="() => _showTestEmailConfirm = true" disabled="@_isProcessing">
                        Enviar email de prueba
                    </button>
                }
            </div>
        </div>

        <!-- Panel de Diagnóstico de Visión Artificial y Baby Leaf Score (ONNX Multi-Head) -->
        <div class="action-card action-card--vision" style="grid-column: 1 / -1;">
            <div class="action-card__body">
                <div class="action-card__icon">🔬</div>
                <div style="width: 100%;">
                    <h4>Diagnóstico de Visión Artificial & Baby Leaf Score (ONNX Multi-Head)</h4>
                    <p>
                        Prueba manual del árbol de decisión completo en 6 etapas: Compuerta GDD, Nitidez y Calidad Laplaciana,
                        Segmentación Morfológica (ExG), Tasa de Crecimiento (GrowthRate), Inferencia Multi-Head ONNX
                        (Nutrición NPK + Sanidad Bremia/Oídio/Septoria/Áfidos) y cálculo del Baby Leaf Score (BLS 0-100).
                    </p>

                    <div class="vision-test-controls">
                        <div class="vision-upload-box">
                            <InputFile OnChange="HandleVisionFileSelected" accept="image/png,image/jpeg,image/webp" class="vision-file-input" id="vision-file-input" />
                            <label for="vision-file-input" class="btn btn-secondary btn-sm">
                                📁 Seleccionar fotografía de planta
                            </label>
                            @if (!string.IsNullOrEmpty(_visionFileName))
                            {
                                <span class="vision-filename text-muted small ms-2">@_visionFileName</span>
                            }
                        </div>

                        <div class="vision-param-grid mt-2">
                            <label class="param-item">
                                <span class="small text-muted">GDD acumulado:</span>
                                <input type="number" step="0.1" class="form-control form-control-sm" @bind="_testGdd" />
                            </label>
                            <label class="param-item">
                                <span class="small text-muted">Ventana GDD Min:</span>
                                <input type="number" step="1" class="form-control form-control-sm" @bind="_testGddMin" />
                            </label>
                            <label class="param-item">
                                <span class="small text-muted">Ventana GDD Max:</span>
                                <input type="number" step="1" class="form-control form-control-sm" @bind="_testGddMax" />
                            </label>
                            <label class="param-item">
                                <span class="small text-muted">Escala cm/px:</span>
                                <input type="number" step="0.005" class="form-control form-control-sm" @bind="_testCmPerPx" />
                            </label>
                            <label class="param-item">
                                <span class="small text-muted">Área previa cm² (opcional):</span>
                                <input type="number" step="0.1" class="form-control form-control-sm" @bind="_testPrevArea" placeholder="Ej: 35.0" />
                            </label>
                            <label class="param-item">
                                <span class="small text-muted">GDD previo (opcional):</span>
                                <input type="number" step="1" class="form-control form-control-sm" @bind="_testPrevGdd" placeholder="Ej: 220" />
                            </label>
                        </div>

                        <div class="mt-2">
                            <button class="btn btn-primary btn-sm" @onclick="ExecuteVisionEvaluationAsync" disabled="@(_isVisionProcessing || _visionFileBytes == null)">
                                ⚡ Evaluar imagen en el pipeline Baby Leaf
                            </button>
                        </div>
                    </div>

                    @if (_isVisionProcessing)
                    {
                        <div class="vision-loading mt-3">
                            <div class="spinner spinner-sm"></div>
                            <span>Ejecutando inferencia ONNX Multi-Head y validación geométrica...</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_visionError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <span>@_visionError</span>
                        </div>
                    }

                    @if (_visionEvalResult != null && !_isVisionProcessing)
                    {
                        <div class="vision-result mt-3 p-3 rounded border">
                            <!-- Previsualización y Dictamen General -->
                            <div class="vision-result__top">
                                @if (!string.IsNullOrEmpty(_visionPreviewDataUrl))
                                {
                                    <div class="vision-result__preview">
                                        <img src="@_visionPreviewDataUrl" alt="Previsualización" class="vision-img rounded border" />
                                    </div>
                                }
                                <div class="vision-result__summary">
                                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                        <span class="badge @GetBabyLeafStatusBadgeClass(_visionEvalResult.Status)" style="font-size: 15px; padding: 6px 12px;">
                                            @GetBabyLeafStatusLabel(_visionEvalResult.Status)
                                        </span>
                                        <span class="fs-5 fw-bold text-white">Score: @_visionEvalResult.BabyLeafScore.ToString("F1")/100</span>
                                    </div>
                                    <div class="progress mb-2" style="height: 10px; max-width: 320px;">
                                        <div class="progress-bar @GetProgressBarClass(_visionEvalResult.BabyLeafScore)"
                                             style="width: @Math.Min(100.0, _visionEvalResult.BabyLeafScore).ToString("F0")%"></div>
                                    </div>
                                    <p class="mb-1 text-light small">
                                        <strong>Recomendación agronómica:</strong> @_visionEvalResult.Recommendation
                                    </p>
                                </div>
                            </div>

                            <!-- Desglose de las 6 etapas del Árbol de Decisión -->
                            <div class="stages-breakdown mt-3 pt-3 border-top">
                                <h6 class="small text-uppercase text-muted mb-2">Desglose del Árbol de Decisión (6 Etapas):</h6>
                                <div class="stages-grid">
                                    <!-- Etapa 1: Ventana GDD -->
                                    <div class="stage-card">
                                        <div class="stage-card__header">
                                            <strong>Etapa 1: Ventana GDD</strong>
                                            <span class="badge @(_visionEvalResult.IsInTemporalWindow ? "badge-success" : "badge-danger")">
                                                @(_visionEvalResult.IsInTemporalWindow ? "En ventana" : "Fuera de ventana")
                                            </span>
                                        </div>
                                        <div class="stage-card__body small">
                                            <div>GDD evaluado: <strong>@_visionEvalResult.AccumulatedGdd.ToString("F1")</strong></div>
                                            <div>Ventana Baby Leaf: <strong>@_testGddMin - @_testGddMax GDD</strong></div>
                                        </div>
                                    </div>

                                    <!-- Etapa 2: Calidad de Imagen -->
                                    <div class="stage-card">
                                        <div class="stage-card__header">
                                            <strong>Etapa 2: Confiabilidad Imagen</strong>
                                            @if (_visionEvalResult.ImageQuality != null)
                                            {
                                                <span class="badge @(_visionEvalResult.ImageQuality.IsReliable ? "badge-success" : "badge-danger")">
                                                    @(_visionEvalResult.ImageQuality.IsReliable ? "Confiable" : "Rechazada")
                                                </span>
                                            }
                                        </div>
                                        <div class="stage-card__body small">
                                            @if (_visionEvalResult.ImageQuality != null)
                                            {
                                                <div>Nitidez Laplaciana: <strong>@_visionEvalResult.ImageQuality.LaplacianVariance.ToString("F1")</strong> (mín 65.0)</div>
                                                <div>Brillo medio: <strong>@_visionEvalResult.ImageQuality.MeanBrightness.ToString("F0")</strong> (35-235)</div>
                                                <div>Saturados: <strong>@((_visionEvalResult.ImageQuality.SaturatedPixelRatio * 100).ToString("F1"))%</strong> (máx 18%)</div>
                                                <div>Cobertura ExG: <strong>@((_visionEvalResult.ImageQuality.VegetationCoverageRatio * 100).ToString("F2"))%</strong> (mín 2%)</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No evaluada</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Etapa 3: Morfología Foliar -->
                                    <div class="stage-card">
                                        <div class="stage-card__header">
                                            <strong>Etapa 3: Morfología Foliar</strong>
                                        </div>
                                        <div class="stage-card__body small">
                                            @if (_visionEvalResult.Morphology != null)
                                            {
                                                <div>Área foliar: <strong>@_visionEvalResult.Morphology.LeafAreaCm2.ToString("F1") cm²</strong> (ideal: 65)</div>
                                                <div>Longitud hoja: <strong>@_visionEvalResult.Morphology.MaxLeafLengthCm.ToString("F1") cm</strong> (ideal: 10)</div>
                                                <div>Roseta: <strong>@_visionEvalResult.Morphology.RosetteDiameterCm.ToString("F1") cm</strong></div>
                                                <div>Solidez dosel: <strong>@_visionEvalResult.Morphology.CanopySolidity.ToString("F2")</strong></div>
                                                <div>SizeRatio: <strong>@(_visionEvalResult.Morphology.SizeRatio?.ToString("F2") ?? "—")</strong></div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin datos morfológicos</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Etapa 4: GrowthRate -->
                                    <div class="stage-card">
                                        <div class="stage-card__header">
                                            <strong>Etapa 4: Crecimiento</strong>
                                        </div>
                                        <div class="stage-card__body small">
                                            <div>Tasa: <strong>@(_visionEvalResult.GrowthRateCm2PerGdd.HasValue ? $"{_visionEvalResult.GrowthRateCm2PerGdd.Value:F3} cm²/GDD" : "—")</strong></div>
                                            <div>Factor vigor: <strong>@(_visionEvalResult.GrowthFactor.HasValue ? _visionEvalResult.GrowthFactor.Value.ToString("F2") : "0.85 (neutro)")</strong></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Etapa 5: Inferencia Multi-Head ONNX -->
                                @if (_visionEvalResult.VisualState != null)
                                {
                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="small text-white">Etapa 5: Diagnóstico Visual Multi-Head (ONNX)</strong>
                                            <span class="small text-info">
                                                Aptitud visual combinada S_visual: <strong>@((_visionEvalResult.VisualState.CombinedVisualAptitude * 100).ToString("F1"))%</strong>
                                            </span>
                                        </div>
                                        <div class="multihead-grid">
                                            <!-- Cabeza 1: Nutrición NPK -->
                                            <div class="head-col p-2 rounded bg-dark border">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="small fw-bold">Nutrición NPK</span>
                                                    <span class="badge @GetNpkBadgeClass(_visionEvalResult.VisualState.TopNpkClass)">
                                                        @_visionEvalResult.VisualState.TopNpkClass
                                                    </span>
                                                </div>
                                                @foreach (var (cls, prob) in _visionEvalResult.VisualState.NpkProbabilities)
                                                {
                                                    <div class="prob-row">
                                                        <span class="prob-name @(cls == _visionEvalResult.VisualState.TopNpkClass ? "fw-bold text-white" : "text-muted")">@cls</span>
                                                        <div class="prob-bar-track">
                                                            <div class="prob-bar-fill @(cls == _visionEvalResult.VisualState.TopNpkClass ? "active-npk" : "")"
                                                                 style="width: @Math.Round(prob * 100)%"></div>
                                                        </div>
                                                        <span class="prob-val @(cls == _visionEvalResult.VisualState.TopNpkClass ? "fw-bold text-white" : "text-muted")">@((prob * 100).ToString("F1"))%</span>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Cabeza 2: Sanidad / Plagas y Hongos -->
                                            <div class="head-col p-2 rounded bg-dark border">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="small fw-bold">Sanidad / Plagas y Hongos</span>
                                                    <span class="badge @GetHealthBadgeClass(_visionEvalResult.VisualState.TopHealthClass)">
                                                        @_visionEvalResult.VisualState.TopHealthClass
                                                    </span>
                                                </div>
                                                @foreach (var (cls, prob) in _visionEvalResult.VisualState.HealthProbabilities)
                                                {
                                                    <div class="prob-row">
                                                        <span class="prob-name @(cls == _visionEvalResult.VisualState.TopHealthClass ? "fw-bold text-white" : "text-muted")">@cls</span>
                                                        <div class="prob-bar-track">
                                                            <div class="prob-bar-fill @(cls == _visionEvalResult.VisualState.TopHealthClass ? (cls == "Healthy" ? "active-healthy" : "active-pathogen") : "")"
                                                                 style="width: @Math.Round(prob * 100)%"></div>
                                                        </div>
                                                        <span class="prob-val @(cls == _visionEvalResult.VisualState.TopHealthClass ? "fw-bold text-white" : "text-muted")">@((prob * 100).ToString("F1"))%</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


    }

    .action-card--email {
        border-left: 4px solid #12b76a;
    }

    .action-card--flow {
        border-left: 4px solid #f79009;
    }

    .action-card--weather {
        border-left: 4px solid #7a8cff;
    }

    .weather-switches {
        display: flex;
        flex-direction: column;
        gap: 10px;

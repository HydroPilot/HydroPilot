<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HydroPilot.PiSimulator</RootNamespace>
    <AssemblyName>PiSimulator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Devices.Client" Version="1.42.4" />
  </ItemGroup>

  <!-- El mismo modelo de tanque, plantas y clima que el historial del entorno de simulación de la web. -->
  <ItemGroup>
    <Compile Include="..\..\HydroPilotWeb\Services\SimulationEnvironment\Model\*.cs" Link="Model\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
